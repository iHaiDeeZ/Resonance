+					x0, x1, y0, y1, z0, z1, u0, u1, v0, v1, c);
+		}
+	};
+	list("opaque", rc.global_param_op);
+	list("punch-through", rc.global_param_pt);
+	list("translucent", rc.global_param_tr);
+	fclose(f);
+	if (FILE *v = fopen("/data/Resonance/tadump-vram.bin", "wb"))
