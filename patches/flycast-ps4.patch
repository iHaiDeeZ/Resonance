@@ -45,11 +49,16 @@ u32 GetRTC_now()
 	// We compute the TZ/DST current time offset and add it to the result
 	// as if we were in the UTC time zone (as well as the DC Epoch)
 	time_t rawtime = time(NULL);
+#ifdef __ORBIS__
+	// PS4: the console's time zone (homebrew's localtime() is UTC)
+	const time_t time_offset = ps4_utc_offset();
+#else
 	struct tm localtm, gmtm;
