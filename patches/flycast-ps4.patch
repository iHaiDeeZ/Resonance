+// One game in the library, as the GUI's scanner and box-art database know it (ui/gui.cpp).
+struct LauncherEntry
+{
+	std::string path;		// what gui_start_game() takes
+	std::string fileName;	// last path component
+	std::string title;		// from the disc header, else the file name
+	std::string productId;	// e.g. T13002N, MK-51117 (empty until the disc has been read)
+	u32 region = 0;			// GameBoxart::Region bits
+	std::string coverPath;	// box art on disk, if any
+	std::vector<std::string> discs;	// a game on several discs: every disc's path, disc 1 first (path)
+};
+
+// ui/gui.cpp, PS4 only
+void gui_ps4_list_games(std::vector<LauncherEntry>& out);
+void gui_ps4_start_game(const std::string& path, const std::string& title);
+void gui_ps4_open_settings();
+
+// ui/gui.cpp, PS4 only: what the settings screen and the quick menu need from Flycast's GUI
+bool gui_ps4_game_running();
+std::string gui_ps4_game_title();
+void gui_ps4_resume();
+void gui_ps4_save_state();
+void gui_ps4_load_state();
+long long gui_ps4_state_date(int slot);		// 0: empty
+void *gui_ps4_state_picture(bool reload);	// ImTextureID of the current slot's picture, or 0
+bool gui_ps4_disc_open();
+void gui_ps4_swap_disc();
+// Another disc of the running game: the lid opens, the game runs a moment to see it, the disc goes in
+void gui_ps4_change_disc(const std::string& path);
+std::string gui_ps4_disc_path();	// the disc in the drive
+void gui_ps4_quit_game();
+void gui_ps4_open_quick_menu();
+void gui_ps4_rescan_games();	// after a network share was added or removed
+// The running game's own settings (emu.cfg's section for its id): on, changes are kept for it only
+bool gui_ps4_game_config();
+void gui_ps4_set_game_config(bool on);
+// Settings changed: saved; devices changed while a game runs are plugged in again
+void gui_ps4_apply_settings(const bool mapleChanged[4], const bool expansionChanged[4][2]);
+// The settings screen is done: back to the quick menu (in a game) or the home screen
+void gui_ps4_settings_done();
+
+// Called before ImGui::NewFrame (fonts can only be added between frames).
+void launcher_pre_frame();
+// Draws the home screen for this frame; false when it can't (then Flycast's list is shown).
+bool launcher_draw();
+// The settings screen (GuiState::Settings) and the in-game quick menu (GuiState::Commands)
+bool launcher_settings_draw();
+bool launcher_quick_menu_draw();
+// L3+R3 or the touchpad during a game: the quick menu
+void launcher_open_quick_menu();
+// The game has loaded (or another disc went in): its cheats and patches
+void launcher_game_started();
+// GuiState::Loading: the started game's cover until its first picture (label: what's going on,
+// progress 0..1 or < 0)
+void launcher_loading_draw(const char *label, float progress);
