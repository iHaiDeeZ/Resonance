+};
+
+// US Dreamcast covers have a light strip down the left (the swirl, SEGA): its width, so the disc
+// label can leave it out; 0 for other pictures (a disc scan, a dark edge). At most a tenth
+float measureLeftBand(const CoverPixels& px)
+{
+	const int limit = px.w * 15 / 100;
+	int band = 0;
+	for (int x = 0; x < limit; x++)
+	{
+		long bright = 0, sat = 0;
+		for (int y = 0; y < px.h; y++)
+		{
+			const u8 *p = &px.rgba[((size_t)y * px.w + x) * 4];
+			const int mx = std::max({ p[0], p[1], p[2] }), mn = std::min({ p[0], p[1], p[2] });
+			bright += (p[0] + p[1] + p[2]) / 3;
+			sat += mx - mn;
+		}
+		if (bright / px.h > 200 && sat / px.h < 40)
+			band = x + 1;
+		else
+			break;
+	}
+	if (band == 0)
+		return 0.f;
+	return std::min(.1f, (float)band / px.w + .01f);
+}
+constexpr size_t COVER_CACHE_BYTES = 64u << 20;
+constexpr int COVER_MAX_SIZE = 640;		// larger covers are scaled down
+std::mutex gCoverMutex;
+std::condition_variable gCoverCv;
+std::deque<std::string> gCoverQueue;
+std::unordered_map<std::string, std::shared_ptr<const CoverPixels>> gCoverPixels;	// null: unreadable
+std::unordered_map<std::string, bool> gCoverQueued;
+std::deque<std::string> gCoverOrder;	// oldest first, for eviction
+size_t gCoverBytes;
+
+std::shared_ptr<const CoverPixels> decodeCover(const std::string& path)
+{
+	FILE *f = nowide::fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return nullptr;
+	int w, h, n;
+	u8 *data = stbi_load_from_file(f, &w, &h, &n, 4);
+	fclose(f);
+	if (data == nullptr)
+		return nullptr;
+	auto px = std::make_shared<CoverPixels>();
+	const int k = std::max(1, (std::max(w, h) + COVER_MAX_SIZE - 1) / COVER_MAX_SIZE);
+	if (k == 1)
+	{
+		px->w = w;
+		px->h = h;
+		px->rgba.assign(data, data + (size_t)w * h * 4);
+	}
+	else
+	{
+		// box filter by an integer factor
+		px->w = w / k;
+		px->h = h / k;
+		px->rgba.resize((size_t)px->w * px->h * 4);
+		for (int y = 0; y < px->h; y++)
+			for (int x = 0; x < px->w; x++)
+				for (int c = 0; c < 4; c++)
+				{
+					u32 sum = 0;
+					for (int j = 0; j < k; j++)
+						for (int i = 0; i < k; i++)
+							sum += data[(((size_t)(y * k + j) * w) + x * k + i) * 4 + c];
+					px->rgba[((size_t)y * px->w + x) * 4 + c] = (u8)(sum / (k * k));
+				}
+	}
+	stbi_image_free(data);
+	px->leftBand = measureLeftBand(*px);
+	return px;
+}
+
+void coverWorker()
+{
+	ThreadName _("LauncherCoverDecode");
+	for (;;)
+	{
+		std::string path;
+		{
+			std::unique_lock<std::mutex> lock(gCoverMutex);
+			gCoverCv.wait(lock, [] { return !gCoverQueue.empty(); });
+			// the newest request first: what is on screen now
+			path = gCoverQueue.back();
+			gCoverQueue.pop_back();
+		}
+		std::shared_ptr<const CoverPixels> px = decodeCover(path);
+		std::lock_guard<std::mutex> lock(gCoverMutex);
+		gCoverPixels[path] = px;
+		gCoverOrder.push_back(path);
+		gCoverBytes += px ? px->rgba.size() : 0;
+		while (gCoverBytes > COVER_CACHE_BYTES && gCoverOrder.size() > 1)
+		{
+			const std::string old = gCoverOrder.front();
+			gCoverOrder.pop_front();
+			auto it = gCoverPixels.find(old);
+			if (it != gCoverPixels.end())
+			{
+				gCoverBytes -= it->second ? it->second->rgba.size() : 0;
+				gCoverPixels.erase(it);
+			}
+			gCoverQueued.erase(old);
+		}
+	}
+}
+} // namespace
+
+float coverLeftBand(const Game& g)
+{
+	std::lock_guard<std::mutex> lock(gCoverMutex);
+	auto it = gCoverPixels.find(g.cover);
+	return it != gCoverPixels.end() && it->second ? it->second->leftBand : 0.f;
+}
+
+ImTextureID coverTexture(const Game& g)
+{
+	static int uploadsThisFrame;
+	static float frameTime = -1;
+	if (frameTime != gTime) {
+		frameTime = gTime;
+		uploadsThisFrame = 0;
+	}
+	if (g.cover.empty() || imguiDriver == nullptr)
+		return {};
+	ImTextureID id = imguiDriver->getTexture(g.cover);
+	if (id != ImTextureID())
+		return id;
+	std::shared_ptr<const CoverPixels> px;
+	{
+		std::lock_guard<std::mutex> lock(gCoverMutex);
+		static bool started;
+		if (!started)
+		{
+			started = true;
+			std::thread(coverWorker).detach();
+		}
+		auto it = gCoverPixels.find(g.cover);
+		if (it == gCoverPixels.end())
+		{
+			if (!gCoverQueued[g.cover])
+			{
+				gCoverQueued[g.cover] = true;
+				gCoverQueue.push_back(g.cover);
+				gCoverCv.notify_one();
+			}
+			return {};
+		}
+		px = it->second;
+	}
+	// a few uploads a frame keep the frame time even when every cover comes back at once
+	if (px == nullptr || uploadsThisFrame >= 6)
+		return {};
+	uploadsThisFrame++;
+	try {
+		id = imguiDriver->updateTexture(g.cover, px->rgba.data(), px->w, px->h, false);
+	} catch (...) {
+	}
+	return id;
+}
+
+namespace
+{
+ImTextureID makeTexture(const char *name, int w, int h, const std::vector<u8>& rgba)
+{
+	if (imguiDriver == nullptr)
+		return {};
+	ImTextureID id = imguiDriver->getTexture(name);
+	if (id == ImTextureID())
+		id = imguiDriver->updateTexture(name, rgba.data(), w, h, false);
+	return id;
+}
+}
+
+ImTextureID blobTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int S = 128;
+	if (pixels.empty())
+	{
+		pixels.resize(S * S * 4);
+		for (int y = 0; y < S; y++)
+			for (int x = 0; x < S; x++)
+			{
+				const float dx = (x + .5f) / S * 2 - 1, dy = (y + .5f) / S * 2 - 1;
+				const float d = clamp01(1 - std::sqrt(dx * dx + dy * dy));
+				u8 *p = &pixels[(y * S + x) * 4];
+				p[0] = p[1] = p[2] = 255;
+				p[3] = (u8)std::lround(d * d * (3 - 2 * d) * 255);
+			}
+	}
+	return makeTexture("resonance.blob", S, S, pixels);
+}
+
+ImTextureID discTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int S = 256;
+	if (pixels.empty())
+	{
+		pixels.resize(S * S * 4);
+		for (int y = 0; y < S; y++)
+			for (int x = 0; x < S; x++)
+			{
+				const float dx = (x + .5f) / S * 2 - 1, dy = (y + .5f) / S * 2 - 1;
+				const float r = std::sqrt(dx * dx + dy * dy), a = std::atan2(dy, dx);
+				// pressed-in silver: bright and dark bands around the disc, faint rings, a
+				// rainbow sheen like the data side
+				float v = .72f + .2f * std::cos(a * 2) + .06f * std::cos(a * 6 + 1.1f);
+				v += .03f * std::sin(r * 140);
+				const Color rainbow = hsv(a / (2 * PI) + r * .35f, .35f, 1.f);
+				Color c = mix({ v, v, v * 1.03f }, rainbow, .16f + .1f * std::cos(a * 2 + .6f));
+				u8 *p = &pixels[(y * S + x) * 4];
+				p[0] = (u8)std::lround(clamp01(c.r) * 255);
+				p[1] = (u8)std::lround(clamp01(c.g) * 255);
+				p[2] = (u8)std::lround(clamp01(c.b) * 255);
+				p[3] = 255;
+			}
+	}
+	return makeTexture("resonance.disc", S, S, pixels);
+}
+
+ImTextureID noiseTexture()
+{
+	static std::vector<u8> pixels;
+	constexpr int W = 256, H = 144;
+	if (pixels.empty())
+	{
+		pixels.resize(W * H * 4);
+		u32 x = 0x9e3779b9;
+		for (int i = 0; i < W * H; i++)
+		{
+			x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+			const u8 v = (u8)(x & 0xff);
+			pixels[i * 4] = pixels[i * 4 + 1] = pixels[i * 4 + 2] = v;
+			pixels[i * 4 + 3] = 255;
+		}
+	}
+	return makeTexture("resonance.noise", W, H, pixels);
+}
+
+ImVec2 whiteUV(ImDrawList *dl) {
+	return dl->_Data->TexUvWhitePixel;
+}
+
+void drawBlob(ImDrawList *dl, ImVec2 c, float r, ImU32 col)
+{
+	ImTextureID tex = blobTexture();
+	if (tex != ImTextureID())
+		dl->AddImage(tex, ImVec2(c.x - r, c.y - r), ImVec2(c.x + r, c.y + r), ImVec2(0, 0), ImVec2(1, 1), col);
+}
+
+void drawQuad(ImDrawList *dl, ImTextureID tex, const ImVec2 p[4], const ImVec2 uv[4], const ImU32 col[4])
+{
+	const bool textured = tex != ImTextureID();
+	if (textured)
+		dl->PushTexture(tex);
+	const ImVec2 w = whiteUV(dl);
+	dl->PrimReserve(6, 4);
+	const ImDrawIdx base = (ImDrawIdx)dl->_VtxCurrentIdx;
+	for (int i = 0; i < 4; i++)
+		dl->PrimWriteVtx(p[i], textured ? uv[i] : w, col[i]);
+	dl->PrimWriteIdx(base); dl->PrimWriteIdx(base + 1); dl->PrimWriteIdx(base + 2);
+	dl->PrimWriteIdx(base); dl->PrimWriteIdx(base + 2); dl->PrimWriteIdx(base + 3);
+	if (textured)
+		dl->PopTexture();
+}
+
+ImFont *fontFor(ImFont *font, const std::string& text)
+{
+	if (font != gDisplayFont)
+		return font;
+	const char *s = text.c_str(), *end = s + text.size();
+	while (s < end)
+	{
+		unsigned int c;
+		const int len = ImTextCharFromUtf8(&c, s, end);
+		if (len <= 0)
+			break;
+		if (c >= 0x80 && !font->IsGlyphInFont((ImWchar)c))
+			return bodyFont();
+		s += len;
+	}
+	return font;
+}
+
+float textWidth(ImFont *font, float size, const std::string& text) {
+	return fontFor(font, text)->CalcTextSizeA(size, FLT_MAX, 0.f, text.c_str()).x;
+}
+
+float drawText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, ImU32 col, const std::string& text,
+		float align, float maxWidth)
+{
+	font = fontFor(font, text);
+	std::string s = text;
+	float width = textWidth(font, size, s);
+	if (maxWidth > 0 && width > maxWidth)
+	{
+		const std::string dots = "...";
+		while (!s.empty() && textWidth(font, size, s + dots) > maxWidth)
+		{
+			s.pop_back();
+			while (!s.empty() && ((u8)s.back() & 0xC0) == 0x80)	// whole UTF-8 characters
+				s.pop_back();
+		}
+		s += dots;
+		width = textWidth(font, size, s);
+	}
+	dl->AddText(font, size, ImVec2(std::round(pos.x - width * align), std::round(pos.y)), col, s.c_str());
+	return width;
+}
+
+void drawButton(ImDrawList *dl, char which, ImVec2 c, float size, float alpha)
+{
+	const float r = size * .5f, t = std::fmax(1.5f, size * .1f);
+	dl->AddCircleFilled(c, r, IM_COL32(20, 24, 34, (int)(200 * alpha)));
+	const float k = r * .48f;
+	switch (which)
+	{
+	case 'x': {
+		const ImU32 col = IM_COL32(120, 170, 255, (int)(255 * alpha));
+		dl->AddLine(ImVec2(c.x - k, c.y - k), ImVec2(c.x + k, c.y + k), col, t);
+		dl->AddLine(ImVec2(c.x - k, c.y + k), ImVec2(c.x + k, c.y - k), col, t);
+		break;
+	}
+	case 'o':
+		dl->AddCircle(c, k * 1.05f, IM_COL32(255, 100, 110, (int)(255 * alpha)), 24, t);
+		break;
+	case 's':
+		dl->AddRect(ImVec2(c.x - k * .9f, c.y - k * .9f), ImVec2(c.x + k * .9f, c.y + k * .9f),
+				IM_COL32(240, 140, 220, (int)(255 * alpha)), 0, 0, t);
+		break;
+	case 't':
+		dl->AddTriangle(ImVec2(c.x, c.y - k * 1.05f), ImVec2(c.x + k * 1.05f, c.y + k * .75f), ImVec2(c.x - k * 1.05f, c.y + k * .75f),
+				IM_COL32(90, 220, 180, (int)(255 * alpha)), t);
+		break;
+	case 'r':
+		// the right stick pressed: R3
+		drawText(dl, bodyFont(), size * .52f, ImVec2(c.x, c.y - size * .33f), IM_COL32(230, 234, 242, (int)(255 * alpha)), "R3", .5f);
+		break;
+	}
+}
+
+void drawHints(Frame& f, float alpha)
+{
+	if (alpha <= 0.f)
+		return;
+	const float size = f.h * .028f, y = f.h * .935f, gap = size * .55f;
+	struct Hint { char b; std::string label; };
+	const Hint hints[] = {
+		{ 'x', i18n::T("Start") }, { 's', themeLabel(gThemeIndex) }, { 'r', i18n::T("Refresh") }, { 't', i18n::T("Settings") },
+	};
+	ImFont *font = bodyFont();
+	const float fs = f.h * .022f;
+	float total = 0;
+	for (const Hint& h : hints)
+		total += size + gap + textWidth(font, fs, h.label) + size * 1.4f;
+	float x = f.w * .95f - total;
+	for (const Hint& h : hints)
+	{
+		drawButton(f.dl, h.b, ImVec2(x + size / 2, y), size, alpha);
+		x += size + gap;
+		x += drawText(f.dl, font, fs, ImVec2(x, y - fs * .62f), IM_COL32(220, 226, 238, (int)(230 * alpha)), h.label);
+		x += size * 1.4f;
+	}
+}
+
+void drawEmptyLibrary(Frame& f)
+{
+	drawText(f.dl, displayFont(), f.h * .045f, ImVec2(f.w / 2, f.h * .42f), IM_COL32(240, 242, 248, 255),
+			i18n::T("Your library is empty"), .5f);
+	drawText(f.dl, bodyFont(), f.h * .026f, ImVec2(f.w / 2, f.h * .51f), IM_COL32(170, 178, 196, 255),
+			i18n::T("Copy GDI, CHD or CDI games to /data/Resonance/games and they appear here."), .5f);
+}
