+#include <sys/stat.h>
+#include <thread>
+
+extern "C" void ps4_boot_trace(const char *line);
+
+namespace netfs
+{
+namespace
+{
+
+u64 nowMs()
+{
+	return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// ---- the shares in emu.cfg: [resonance] NetShares = n, NetShare<i> = type|label|host|path|user|password ----
+
+std::vector<std::string> split(const std::string& s, char sep)
+{
+	std::vector<std::string> out;
+	size_t start = 0;
+	for (;;)
+	{
+		const size_t p = s.find(sep, start);
+		out.push_back(s.substr(start, p == std::string::npos ? std::string::npos : p - start));
+		if (p == std::string::npos)
+			return out;
+		start = p + 1;
+	}
+}
+
+std::vector<Share> loadShares()
+{
+	std::vector<Share> out;
+	const int n = config::loadInt("resonance", "NetShares", 0);
+	for (int i = 0; i < n; i++)
+	{
+		const std::vector<std::string> f = split(config::loadStr("resonance", "NetShare" + std::to_string(i)), '|');
+		if (f.size() < 4 || (f[0] != "nfs" && f[0] != "smb"))
+			continue;
+		Share s;
+		s.type = f[0];
+		s.label = f[1];
+		s.host = f[2];
+		s.path = f[3];
+		if (f.size() > 4)
+			s.user = f[4];
+		if (f.size() > 5)
+			s.password = f[5];
+		out.push_back(s);
+	}
+	return out;
+}
+
+void saveShares(const std::vector<Share>& list)
+{
+	const int old = config::loadInt("resonance", "NetShares", 0);
+	config::saveInt("resonance", "NetShares", (int)list.size());
+	for (int i = 0; i < (int)list.size(); i++)
+	{
+		const Share& s = list[i];
+		config::saveStr("resonance", "NetShare" + std::to_string(i),
+				s.type + "|" + s.label + "|" + s.host + "|" + s.path + "|" + s.user + "|" + s.password);
+	}
+	for (int i = (int)list.size(); i < old; i++)
+		config::saveStr("resonance", "NetShare" + std::to_string(i), "");
+}
+
+// ---- connections ----
+
+class Connection
+{
+public:
+	explicit Connection(const Share& share) : share(share) {}
+	~Connection() {
+		disconnect();
+	}
+
+	std::mutex mutex;		// held around every call below
+	u64 generation = 0;		// bumped at every new connection: file handles from before are gone
+
+	// connected, or why not
+	bool connect(std::string& error)
+	{
+		if (nfs != nullptr || smb != nullptr)
+			return true;
+		if (nowMs() < retryAt)
+		{
+			error = lastError;
+			return false;
+		}
+		if (share.type == "nfs")
+		{
+			nfs = nfs_init_context();
+			if (nfs == nullptr)
+				return fail("out of memory", error);
+			nfs_set_timeout(nfs, 6000);
+			if (nfs_mount(nfs, share.host.c_str(), share.path.c_str()) != 0)
+				return fail(nfs_get_error(nfs), error);
+		}
+		else
+		{
+			smb = smb2_init_context();
+			if (smb == nullptr)
+				return fail("out of memory", error);
+			smb2_set_timeout(smb, 6);
+			smb2_set_security_mode(smb, SMB2_NEGOTIATE_SIGNING_ENABLED);
+			if (!share.user.empty())
+				smb2_set_user(smb, share.user.c_str());
+			if (!share.password.empty())
+				smb2_set_password(smb, share.password.c_str());
+			const size_t slash = share.path.find('/');
+			const std::string shareName = share.path.substr(0, slash);
+			smbBase = slash == std::string::npos ? "" : share.path.substr(slash + 1);
+			while (!smbBase.empty() && smbBase.back() == '/')
+				smbBase.pop_back();
+			if (smb2_connect_share(smb, share.host.c_str(), shareName.c_str(), share.user.empty() ? nullptr : share.user.c_str()) != 0)
+				return fail(smb2_get_error(smb), error);
+		}
+		generation++;
+		lastError.clear();
+		char line[256];
+		snprintf(line, sizeof(line), "netfs: %s connected", share.url().c_str());
+		ps4_boot_trace(line);
+		return true;
+	}
+
+	void disconnect()
+	{
+		if (nfs != nullptr)
+		{
+			nfs_destroy_context(nfs);
+			nfs = nullptr;
+		}
+		if (smb != nullptr)
+		{
+			smb2_disconnect_share(smb);
+			smb2_destroy_context(smb);
+			smb = nullptr;
+		}
+	}
+
+	// rel: path under the share's folder, "" or "a/b" (no leading slash)
+	bool list(const std::string& rel, std::vector<hostfs::FileInfo>& out, const std::string& url, std::string& error)
+	{
+		if (!connect(error))
+			return false;
+		if (nfs != nullptr)
+		{
+			struct nfsdir *dir = nullptr;
+			if (nfs_opendir(nfs, ("/" + rel).c_str(), &dir) != 0)
+				return broken(nfs_get_error(nfs), error);
+			while (struct nfsdirent *e = nfs_readdir(nfs, dir))
+			{
+				if (e->name[0] == '.')
+					continue;
+				const bool isDir = S_ISDIR(e->mode);
+				out.emplace_back(e->name, url + e->name, isDir, (size_t)e->size, false, (u64)e->mtime.tv_sec);
+			}
+			nfs_closedir(nfs, dir);
+		}
+		else
+		{
+			struct smb2dir *dir = smb2_opendir(smb, smbPath(rel).c_str());
+			if (dir == nullptr)
+				return broken(smb2_get_error(smb), error);
+			while (struct smb2dirent *e = smb2_readdir(smb, dir))
+			{
+				if (e->name[0] == '.')
+					continue;
+				const bool isDir = e->st.smb2_type == SMB2_TYPE_DIRECTORY;
+				out.emplace_back(e->name, url + e->name, isDir, (size_t)e->st.smb2_size, false, (u64)e->st.smb2_mtime);
+			}
+			smb2_closedir(smb, dir);
+		}
+		return true;
+	}
+
+	bool stat(const std::string& rel, bool& isDir, u64& size, std::string& error)
+	{
+		if (!connect(error))
+			return false;
+		if (nfs != nullptr)
+		{
+			struct nfs_stat_64 st {};
+			if (nfs_stat64(nfs, ("/" + rel).c_str(), &st) != 0)
+				return softFail(nfs_get_error(nfs), error);
+			isDir = S_ISDIR(st.nfs_mode);
+			size = st.nfs_size;
+		}
+		else
+		{
+			struct smb2_stat_64 st {};
+			if (smb2_stat(smb, smbPath(rel).c_str(), &st) != 0)
+				return softFail(smb2_get_error(smb), error);
+			isDir = st.smb2_type == SMB2_TYPE_DIRECTORY;
+			size = st.smb2_size;
+		}
+		return true;
+	}
+
+	void *open(const std::string& rel, std::string& error)
+	{
+		if (!connect(error))
+			return nullptr;
+		if (nfs != nullptr)
+		{
+			struct nfsfh *fh = nullptr;
+			if (nfs_open(nfs, ("/" + rel).c_str(), O_RDONLY, &fh) != 0)
+			{
+				softFail(nfs_get_error(nfs), error);
+				return nullptr;
+			}
+			return fh;
+		}
+		struct smb2fh *fh = smb2_open(smb, smbPath(rel).c_str(), O_RDONLY);
+		if (fh == nullptr)
+			softFail(smb2_get_error(smb), error);
+		return fh;
+	}
+
+	void close(void *fh)
+	{
+		if (fh == nullptr)
+			return;
+		if (nfs != nullptr)
+			nfs_close(nfs, (struct nfsfh *)fh);
+		else if (smb != nullptr)
+			smb2_close(smb, (struct smb2fh *)fh);
+	}
+
+	// bytes read (0 at the end), -1 when the connection broke
+	s64 pread(void *fh, u8 *buf, size_t count, u64 offset)
+	{
+		size_t done = 0;
+		while (done < count)
+		{
+			int r;
+			if (nfs != nullptr)
+			{
+				const size_t step = std::min<size_t>(count - done, std::max<size_t>(nfs_get_readmax(nfs), 32768));
+				r = nfs_pread(nfs, (struct nfsfh *)fh, buf + done, step, offset + done);
+			}
+			else if (smb != nullptr)
+			{
+				const size_t step = std::min<size_t>(count - done, std::max<u32>(smb2_get_max_read_size(smb), 65536));
+				r = smb2_pread(smb, (struct smb2fh *)fh, buf + done, (u32)step, offset + done);
+			}
+			else
+				return -1;
+			if (r < 0)
+			{
+				std::string ignored;
+				broken(nfs != nullptr ? nfs_get_error(nfs) : smb2_get_error(smb), ignored);
+				return -1;
+			}
+			if (r == 0)
+				break;
+			done += r;
+		}
+		return (s64)done;
+	}
+
+	const Share share;
+
+private:
+	std::string smbPath(const std::string& rel) const
+	{
+		if (smbBase.empty())
+			return rel;
+		return rel.empty() ? smbBase : smbBase + "/" + rel;
+	}
+
+	bool fail(const char *what, std::string& error)
+	{
+		error = what != nullptr && *what ? what : "connection failed";
+		lastError = error;
+		retryAt = nowMs() + 20000;
+		char line[512];
+		snprintf(line, sizeof(line), "netfs: %s: %s", share.url().c_str(), error.c_str());
+		ps4_boot_trace(line);
+		disconnect();
+		return false;
+	}
+	// the call failed and the connection may be gone: start again next time
+	bool broken(const char *what, std::string& error)
+	{
+		error = what != nullptr && *what ? what : "network error";
+		char line[512];
+		snprintf(line, sizeof(line), "netfs: %s: %s (reconnecting)", share.url().c_str(), error.c_str());
+		ps4_boot_trace(line);
+		disconnect();
+		return false;
+	}
+	// a missing file: the connection is fine
+	bool softFail(const char *what, std::string& error)
+	{
+		error = what != nullptr && *what ? what : "not found";
+		return false;
+	}
+
+	struct nfs_context *nfs = nullptr;
+	struct smb2_context *smb = nullptr;
+	std::string smbBase;
+	std::string lastError;
+	u64 retryAt = 0;
+};
+
+std::mutex gConnectionsMutex;
+std::map<std::string, std::shared_ptr<Connection>> gConnections;	// by label
+
+std::shared_ptr<Connection> connectionFor(const std::string& label)
+{
+	std::lock_guard<std::mutex> _(gConnectionsMutex);
+	auto it = gConnections.find(label);
+	if (it != gConnections.end())
+		return it->second;
+	for (const Share& s : loadShares())
+		if (s.label == label)
+		{
+			auto c = std::make_shared<Connection>(s);
+			gConnections[label] = c;
+			return c;
+		}
+	return nullptr;
+}
+
+void forget(const std::string& label)
+{
+	std::lock_guard<std::mutex> _(gConnectionsMutex);
+	gConnections.erase(label);
+}
+
+// "nfs://label/a/b" -> label, "a/b"
+bool parse(const std::string& url, std::string& label, std::string& rel)
+{
+	const size_t scheme = url.find("://");
+	if (scheme == std::string::npos)
+		return false;
+	const size_t start = scheme + 3;
+	const size_t slash = url.find('/', start);
+	label = url.substr(start, slash == std::string::npos ? std::string::npos : slash - start);
+	rel = slash == std::string::npos ? "" : url.substr(slash + 1);
+	while (!rel.empty() && rel.back() == '/')
+		rel.pop_back();
+	return !label.empty();
+}
+
+// ---- files: 1 MiB pieces, a few kept, the next one fetched ahead ----
+
+constexpr size_t PIECE = 1 << 20;
+constexpr size_t KEEP = 6;
+
+struct FileState
+{
+	std::shared_ptr<Connection> conn;
+	std::string rel;
+	u64 size = 0;
+	std::mutex mutex;					// the pieces below
+	std::list<std::pair<u64, std::vector<u8>>> pieces;	// most recent first
+	std::set<u64> loading;
+	std::condition_variable loaded;
+	void *fh = nullptr;					// under conn->mutex
+	u64 fhGeneration = 0;
+
+	~FileState()
+	{
+		std::lock_guard<std::mutex> _(conn->mutex);
+		if (fh != nullptr && fhGeneration == conn->generation)
+			conn->close(fh);
+	}
+
+	// one piece from the share (conn->mutex held by the caller)
+	bool fetch(u64 index, std::vector<u8>& out)
+	{
+		for (int attempt = 0; attempt < 2; attempt++)
+		{
+			std::string error;
+			if (!conn->connect(error))
+				return false;
+			if (fh == nullptr || fhGeneration != conn->generation)
+			{
+				fh = conn->open(rel, error);
+				fhGeneration = conn->generation;
+				if (fh == nullptr)
+					return false;
+			}
+			const u64 offset = index * PIECE;
+			out.resize((size_t)std::min<u64>(PIECE, size - offset));
+			const s64 r = conn->pread(fh, out.data(), out.size(), offset);
+			if (r >= 0)
+			{
+				out.resize((size_t)r);
+				return true;
+			}
+			fh = nullptr;	// the connection broke: once more on a new one
+		}
+		return false;
+	}
+
+	void store(u64 index, std::vector<u8>&& data)
+	{
+		pieces.emplace_front(index, std::move(data));
+		while (pieces.size() > KEEP)
+			pieces.pop_back();
+	}
+
+	// the piece, from the cache or the share; nullptr when it can't be read
+	const std::vector<u8> *piece(u64 index, std::unique_lock<std::mutex>& lock)
+	{
+		for (;;)
+		{
+			for (auto it = pieces.begin(); it != pieces.end(); ++it)
+				if (it->first == index)
+				{
+					pieces.splice(pieces.begin(), pieces, it);
+					return &pieces.front().second;
+				}
+			if (loading.count(index) == 0)
+				break;
+			loaded.wait(lock);	// the read-ahead is bringing it
+		}
+		loading.insert(index);
+		lock.unlock();
+		std::vector<u8> data;
+		bool ok;
+		{
+			std::lock_guard<std::mutex> _(conn->mutex);
+			ok = fetch(index, data);
+		}
+		lock.lock();
+		loading.erase(index);
+		loaded.notify_all();
+		if (!ok)
+			return nullptr;
+		store(index, std::move(data));
+		return &pieces.front().second;
+	}
+};
+
+// One thread fetching the next pieces of the files being read
+class ReadAhead
+{
+public:
+	void request(const std::shared_ptr<FileState>& file, u64 index)
+	{
+		{
+			std::lock_guard<std::mutex> _(mutex);
+			if (!started)
+			{
+				started = true;
+				std::thread([this] { run(); }).detach();
+			}
+			if (queue.size() > 8)
+				queue.pop_front();
+			queue.emplace_back(file, index);
+		}
+		cv.notify_one();
+	}
+
+private:
+	void run()
+	{
+		ThreadName _("NetReadAhead");
+		for (;;)
+		{
+			std::weak_ptr<FileState> weak;
+			u64 index;
+			{
+				std::unique_lock<std::mutex> lock(mutex);
+				cv.wait_for(lock, std::chrono::milliseconds(500), [this] { return !queue.empty(); });
+				if (queue.empty())
+					continue;
+				weak = queue.front().first;
+				index = queue.front().second;
+				queue.pop_front();
+			}
+			std::shared_ptr<FileState> file = weak.lock();
+			if (!file || index * PIECE >= file->size)
+				continue;
+			{
+				std::unique_lock<std::mutex> lock(file->mutex);
+				bool have = file->loading.count(index) != 0;
+				for (auto& p : file->pieces)
+					have = have || p.first == index;
+				if (have)
+					continue;
+				file->loading.insert(index);
+			}
+			std::vector<u8> data;
+			bool ok;
+			{
+				std::lock_guard<std::mutex> _(file->conn->mutex);
+				ok = file->fetch(index, data);
+			}
+			std::unique_lock<std::mutex> lock(file->mutex);
+			file->loading.erase(index);
+			if (ok)
+				file->store(index, std::move(data));
+			file->loaded.notify_all();
+		}
+	}
+
+	std::mutex mutex;
+	std::condition_variable cv;
+	std::deque<std::pair<std::weak_ptr<FileState>, u64>> queue;
+	bool started = false;
+};
+
+ReadAhead gReadAhead;
+
+class NetFile : public hostfs::File
+{
+public:
+	explicit NetFile(std::shared_ptr<FileState> state) : state(std::move(state)) {}
+
+	size_t read(void *buffer, size_t size, size_t count) override
+	{
+		const u64 want = (u64)size * count;
+		if (size == 0 || want == 0)
+			return 0;
+		u8 *out = (u8 *)buffer;
+		u64 done = 0;
+		std::unique_lock<std::mutex> lock(state->mutex);
+		while (done < want && pos < state->size)
+		{
+			const u64 index = pos / PIECE;
+			const std::vector<u8> *p = state->piece(index, lock);
+			if (p == nullptr)
+			{
+				failed = true;
+				break;
+			}
+			const u64 inPiece = pos - index * PIECE;
+			if (inPiece >= p->size())
+				break;
+			const u64 n = std::min<u64>(want - done, p->size() - inPiece);
+			memcpy(out + done, p->data() + inPiece, (size_t)n);
+			done += n;
+			pos += n;
+			if (index != lastPiece)
+			{
+				// reading on in order: have the next piece fetched meanwhile
+				lastPiece = index;
+				if ((index + 1) * PIECE < state->size)
+				{
+					lock.unlock();
+					gReadAhead.request(state, index + 1);
+					lock.lock();
+				}
+			}
+		}
+		if (pos >= state->size)
+			atEnd = done < want;
+		return (size_t)(done / size);
+	}
+
+	size_t write(const void *, size_t, size_t) override {
+		return 0;	// read only
+	}
+	s64 tell() override {
+		return (s64)pos;
+	}
+	int seek(s64 offset, int whence) override
+	{
+		s64 base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? (s64)pos : (s64)state->size;
+		const s64 target = base + offset;
+		if (target < 0)
+			return -1;
+		pos = (u64)target;
+		atEnd = false;
+		return 0;
+	}
+	char *gets(char *str, int count) override
+	{
+		if (count <= 0)
+			return nullptr;
+		int n = 0;
+		while (n < count - 1)
+		{
+			char c;
+			if (read(&c, 1, 1) != 1)
+				break;
+			str[n++] = c;
+			if (c == '\n')
+				break;
+		}
+		if (n == 0)
+			return nullptr;
+		str[n] = '\0';
+		return str;
+	}
+	s64 size() override {
+		return (s64)state->size;
+	}
+	int eof() override {
+		return atEnd ? 1 : 0;
+	}
+	int error() override {
+		return failed ? 1 : 0;
+	}
+
+private:
+	std::shared_ptr<FileState> state;
+	u64 pos = 0;
+	u64 lastPiece = ~0ull;
+	bool atEnd = false, failed = false;
+};
+
+// ---- Flycast's storage layer ----
+
+class NetStorage : public hostfs::CustomStorage
+{
+public:
+	bool isKnownPath(const std::string& path) override {
+		return path.rfind("nfs://", 0) == 0 || path.rfind("smb://", 0) == 0;
+	}
+
+	std::vector<hostfs::FileInfo> listContent(const std::string& path) override
+	{
+		std::vector<hostfs::FileInfo> out;
+		if (!isKnownPath(path))
+			return out;
+		std::string label, rel, error;
+		if (!parse(path, label, rel))
+			return out;
+		std::shared_ptr<Connection> c = connectionFor(label);
+		if (!c)
+			throw hostfs::StorageException("unknown share " + label);
+		std::string base = path;
+		if (base.back() != '/')
+			base += '/';
+		std::lock_guard<std::mutex> _(c->mutex);
+		if (!c->list(rel, out, base, error))
+			throw hostfs::StorageException(path + ": " + error);
+		return out;
+	}
+
+	hostfs::File *openFile(const std::string& path, const std::string& mode) override
+	{
+		if (mode.find('w') != std::string::npos || mode.find('a') != std::string::npos || mode.find('+') != std::string::npos)
+			return nullptr;	// the library is read only
+		std::string label, rel, error;
+		if (!parse(path, label, rel))
+			return nullptr;
+		std::shared_ptr<Connection> c = connectionFor(label);
+		if (!c)
+			return nullptr;
+		auto state = std::make_shared<FileState>();
+		state->conn = c;
+		state->rel = rel;
+		{
+			std::lock_guard<std::mutex> _(c->mutex);
+			bool isDir = false;
+			u64 size = 0;
+			if (!c->stat(rel, isDir, size, error) || isDir)
+				return nullptr;
+			state->size = size;
+			state->fh = c->open(rel, error);
+			state->fhGeneration = c->generation;
+			if (state->fh == nullptr)
+				return nullptr;
+		}
+		return new NetFile(state);
+	}
+
+	std::string getParentPath(const std::string& path) override
+	{
+		std::string label, rel;
+		if (!parse(path, label, rel))
+			return path;
+		const std::string root = path.substr(0, path.find("://") + 3) + label;
+		const size_t slash = rel.find_last_of('/');
+		return slash == std::string::npos ? root : root + "/" + rel.substr(0, slash);
+	}
+
+	std::string getSubPath(const std::string& reference, const std::string& subpath) override
+	{
+		std::string out = reference;
+		if (!out.empty() && out.back() != '/')
+			out += '/';
+		return out + subpath;
+	}
+
+	hostfs::FileInfo getFileInfo(const std::string& path) override
+	{
+		std::string label, rel, error;
+		if (!parse(path, label, rel))
+			throw hostfs::StorageException("bad path " + path);
+		std::shared_ptr<Connection> c = connectionFor(label);
+		if (!c)
+			throw hostfs::StorageException("unknown share " + label);
+		bool isDir = rel.empty();
+		u64 size = 0;
+		if (!rel.empty())
+		{
+			std::lock_guard<std::mutex> _(c->mutex);
+			if (!c->stat(rel, isDir, size, error))
+				throw hostfs::StorageException(path + ": " + error);
+		}
+		const size_t slash = path.find_last_of('/');
+		return hostfs::FileInfo(path.substr(slash + 1), path, isDir, (size_t)size);
+	}
+
+	bool exists(const std::string& path) override
+	{
+		try {
+			getFileInfo(path);
+			return true;
+		} catch (const hostfs::StorageException&) {
+			return false;
+		}
+	}
+
+	bool addStorage(bool, bool, const std::string&, void (*)(bool, std::string), const std::string&) override {
+		return false;	// shares are added in Resonance's settings
+	}
+};
+
+} // namespace
+
+std::string Share::describe() const
+{
+	if (type == "nfs")
+		return "NFS  " + host + ":" + path;
+	return "SMB  \\\\" + host + "\\" + path + (user.empty() ? "" : "  (" + user + ")");
+}
+
+std::vector<Share> shares() {
+	return loadShares();
+}
+
+std::string makeLabel(const std::string& host, const std::string& path)
+{
+	std::string tail = path;
+	while (!tail.empty() && tail.back() == '/')
+		tail.pop_back();
+	const size_t slash = tail.find_last_of('/');
+	if (slash != std::string::npos)
+		tail = tail.substr(slash + 1);
+	std::string label;
+	for (char c : host + (tail.empty() ? "" : "-" + tail))
+		label += isalnum((unsigned char)c) || c == '.' || c == '-' || c == '_' ? c : '_';
+	std::string unique = label;
+	const std::vector<Share> list = loadShares();
+	for (int n = 2;; n++)
+	{
+		bool used = false;
+		for (const Share& s : list)
+			used = used || s.label == unique;
+		if (!used)
+			return unique;
+		unique = label + "-" + std::to_string(n);
+	}
+}
+
+void addShare(Share share)
+{
+	std::vector<Share> list = loadShares();
+	list.erase(std::remove_if(list.begin(), list.end(), [&](const Share& s) { return s.label == share.label; }), list.end());
+	list.push_back(share);
+	saveShares(list);
+	forget(share.label);
+	std::vector<std::string> content = config::ContentPath.get();
+	if (std::find(content.begin(), content.end(), share.url()) == content.end())
+	{
+		content.push_back(share.url());
+		config::ContentPath.set(content);
+	}
+	SaveSettings();
+}
+
+void removeShare(const std::string& label)
+{
+	std::vector<Share> list = loadShares();
+	std::string url;
+	for (const Share& s : list)
+		if (s.label == label)
+			url = s.url();
+	list.erase(std::remove_if(list.begin(), list.end(), [&](const Share& s) { return s.label == label; }), list.end());
+	saveShares(list);
+	forget(label);
+	std::vector<std::string> content = config::ContentPath.get();
+	content.erase(std::remove(content.begin(), content.end(), url), content.end());
+	config::ContentPath.set(content);
+	SaveSettings();
+}
+
+std::string test(const Share& share, int& entries)
+{
+	Connection c(share);
+	std::lock_guard<std::mutex> _(c.mutex);
+	std::vector<hostfs::FileInfo> list;
+	std::string error;
+	if (!c.list("", list, share.url(), error))
+		return error.empty() ? "connection failed" : error;
+	entries = (int)list.size();
+	return "";
+}
+
+} // namespace netfs
+
+namespace hostfs
+{
+// Flycast's storage layer asks here for the paths it doesn't know (core/oslib/storage.cpp)
+CustomStorage& customStorage()
+{
+	static netfs::NetStorage storage;
+	return storage;
+}
+}
