+namespace launcher
+{
+
+constexpr float PI = 3.14159265f;
+
+struct Color
+{
+	float r = 0, g = 0, b = 0;
+	ImU32 u32(float a = 1.f) const {
+		auto c = [](float v) { return (int)std::lround(std::fmin(1.f, std::fmax(0.f, v)) * 255.f); };
+		return IM_COL32(c(r), c(g), c(b), c(a));
+	}
+};
+Color mix(const Color& a, const Color& b, float t);
+Color hsv(float h, float s, float v);
+// Moves a colour toward a target at a rate (frame-rate independent)
+void approach(Color& c, const Color& target, float rate, float dt);
+
+struct Game
+{
+	LauncherEntry e;
+	std::string cover;		// cover image to show (user's, downloaded, from the disc), or empty
+	std::string format;		// GDI, CHD, CDI
+	std::string regionName;	// USA, Japan, Europe
+	Color c1, c2;			// bright and dark colour of the game (from its cover once read)
+	bool paletteFromCover = false;
+};
+
+// Everything a theme needs for one frame.
+struct Frame
+{
+	ImDrawList *dl;
+	float w, h;				// screen size
+	float t, dt;			// seconds since the launcher started, frame time
+	std::vector<Game> *games;
+	int sel;				// selected game
+	int goal;				// selection without wrapping (themes ride springs toward it)
+	float selectedAt;		// when the selection last changed
+	float launchAt;			// when Start was pressed, or < 0
+};
+
+struct MenuInput;
+
+class Theme
+{
+public:
+	virtual ~Theme() = default;
+	virtual const char *name() const = 0;
+	virtual void draw(Frame& f) = 0;
+	// Seconds the start animation takes before the game is booted.
+	virtual float launchSeconds() const { return 1.4f; }
+	// Directional input: true when the theme used it (the Cross bar has two axes).
+	virtual bool navigate(Frame& f, int dx, int dy) { return false; }
+	// Cross: true when the theme handled it itself (Cross bar menus other than Games).
+	virtual bool activate(Frame& f) { return false; }
+	// Circle: true when the theme used it (leaving a Cross bar settings list).
+	virtual bool back(Frame& f) { return false; }
+	// While true the theme has a menu of its own open: it gets the pad as MenuInput (drawn in
+	// draw()), the core's own buttons (Square, Triangle, L1/R1, Cross to start) stay quiet.
+	virtual bool busy() const { return false; }
+	virtual void menuInput(Frame& f, const MenuInput& in) {}
+};
+std::unique_ptr<Theme> makeOrbit();
+std::unique_ptr<Theme> makeChannel();
+std::unique_ptr<Theme> makeShelf();
+std::unique_ptr<Theme> makeCrossBar();
+constexpr int THEME_COUNT = 4;
+const char *themeName(int index);
+
+// Menu languages (Flycast's UILanguage values; "" = the PS4's system language)
+int languageCount();
+const char *languageName(int index);	// in its own script
+const char *languageCode(int index);
+int currentLanguage();
+void setLanguage(int index);
+
+// Requests from themes to the core
+void requestTheme(int index);
+// Look for new games now (R3, Settings > Home Screen > Refresh Game List)
+void refreshGames();
+int currentTheme();
+void openSettings();
+void moveSelection(int delta);
+
+// Drawing helpers (launcher.cpp)
+ImFont *displayFont();	// Michroma
+ImFont *bodyFont();		// Flycast's UI font (Roboto, with Font Awesome icons)
+ImTextureID coverTexture(const Game& g);	// 0 while loading or without a cover
+float coverLeftBand(const Game& g);		// a US cover's light left strip, of its width (0: none or not read yet)
+ImTextureID blobTexture();		// soft round light, white
+ImTextureID discTexture();		// silver disc surface
+ImTextureID noiseTexture();		// TV static
+ImVec2 whiteUV(ImDrawList *dl);
+void drawBlob(ImDrawList *dl, ImVec2 c, float r, ImU32 col);
+// Text: align 0 = left, .5 = centre, 1 = right; clipped with an ellipsis at maxWidth (0 = none)
+float drawText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, ImU32 col, const std::string& text,
+		float align = 0.f, float maxWidth = 0.f);
+float textWidth(ImFont *font, float size, const std::string& text);
+// Michroma has Latin only: text it can't draw goes to the body font
+ImFont *fontFor(ImFont *font, const std::string& text);
+// The PS button symbols: 'x' cross, 'o' circle, 's' square, 't' triangle
+void drawButton(ImDrawList *dl, char which, ImVec2 c, float size, float alpha = 1.f);
+// The control hints along the bottom of the screen
+void drawHints(Frame& f, float alpha = 1.f);
+// A textured (or plain, tex = 0) quad with per-corner uv and colour: p0..p3 clockwise from top left
+void drawQuad(ImDrawList *dl, ImTextureID tex, const ImVec2 p[4], const ImVec2 uv[4], const ImU32 col[4]);
+// Library empty: the message in the middle of the screen
+void drawEmptyLibrary(Frame& f);
+// The logo (launcher/logo.png from scripts/make-logo.py): 0 until it is up; aspect = width / height
+ImTextureID logoTexture(float& aspect);
+struct LogoInfo
+{
+	float pad = .17f;						// the glow's margin, of the height
+	float swirlX = 2.2f, swirlY = .37f, swirlR = .27f;	// the swirl's centre and radius, of the height
+};
+const LogoInfo& logoInfo();
+// The logo in the top-left corner of the menus; left: where the letters start (< 0: the corner)
+void drawCornerLogo(Frame& f, float alpha, float left = -1.f);
+// The game being started: its cover on the game's colours, title below; the themes' start
+// animations end on it and it stays up while the game loads (progress < 0: no figure yet)
+void drawLaunchCard(Frame& f, const Game& g, float alpha, float progress = -1.f, const std::string& label = "");
+float easeOut(float t);
+// The console's local time (time zone and summer time from its settings) as a tm
+const struct tm *localTm(time_t t);
+float clamp01(float t);
+// Spring toward goal (critically damped-ish); returns the new position
+void spring(float& pos, float& vel, float goal, float stiffness, float damping, float dt);
+bool reducedMotion();
+
+// intro.cpp: the opening; false once it is over (or the pictures are missing)
+bool introDraw(Frame& f);
+bool introEnabled();
+void setIntroEnabled(bool on);
+
+// xmb_style.cpp: the PS3 look shared by the Cross bar, the settings and the quick menu
+Color xmbTone();							// this month's colour, as on the PS3
+// Gradient and the slow wave; overGame: translucent, the paused game shows through
+void xmbBackground(Frame& f, bool overGame = false);
+// White text with a soft shadow
+float xmbText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, float alpha, const std::string& text,
+		float align = 0.f, float maxWidth = 0.f, ImU32 color = IM_COL32(255, 255, 255, 255));
+void xmbClock(Frame& f, float alpha);
+// Button hints at the bottom right: {'x', "Select"}, {'o', "Back"}
+struct Hint { char button; std::string label; };
+void xmbHints(Frame& f, const std::vector<Hint>& hints, float alpha = 1.f);
+// A Cross bar item at c: a Font Awesome glyph, or a game's cover; its title (and, focused, a
+// second line); focus 0..1
+void xmbItem(Frame& f, ImVec2 c, const char *glyph, const Game *game, const std::string& title,
+		const std::string& subtitle, float focus, float alpha);
+// A frame for the menus outside the home screen (settings, quick menu)
+Frame menuFrame();
+
+// The pad for menus: new presses, held directions with repeat. Buttons already down when a menu
+// (re)appears aren't new presses in it.
+struct MenuInput
+{
+	int dx = 0, dy = 0;
+	bool cross = false, circle = false, triangle = false, square = false, l1 = false, r1 = false;
+	void read(float t);
+private:
+	u32 prev = 0;
+	int held = -1;
+	float repeatAt = 0;
+	int lastFrame = -10;
+};
+
+// settings_menu.cpp: the emulator's settings, PS3 style: groups, their options with the current
+// value on the right, a drop-down list to change one
+class SettingsPanel
+{
+public:
+	SettingsPanel();
+	~SettingsPanel();
+	int groupCount() const;
+	const char *groupIcon(int g) const;
+	std::string groupName(int g) const;
+	std::string groupSummary(int g) const;
+	// show a group's options; Circle there closes the panel (changes applied and saved)
+	void openGroup(int g, float t);
+	bool isOpen() const;
+	void input(const MenuInput& in, float t);
+	void draw(Frame& f, float alpha);
+private:
+	void close();
+	struct Impl;
+	std::unique_ptr<Impl> impl;
+};
+// keyboard.cpp: the PS4's on-screen keyboard over the menus (they skip the pad while it is open
+// and call keyboardUpdate() every frame); done(ok, text) when it closes
+bool keyboardOpen();
+void openKeyboard(const std::string& title, const std::string& text, bool secret,
+		std::function<void(bool ok, const std::string& text)> done);
+void keyboardUpdate();
+
+// cheats_db.cpp: RetroArch .cht cheats from libretro's database or /data/Resonance/cheats
+struct CheatCandidate { std::string name; float score; };
+// database files whose names fit the title, best first (network: off the UI thread)
+std::vector<CheatCandidate> cheatCandidates(const std::string& title, std::string& error);
+std::string downloadCheat(const std::string& name, const std::string& dest);	// "" when done
+std::vector<std::string> folderCheats();	// paths of the files in the cheats folder
+bool cheatsAutomatic();						// Settings > System > Cheat Source
+float titleScore(const std::string& title, const std::string& name);	// about 1: the same game
+// game_codes.cpp: the running game's cheats and patches (patches on unless switched off)
+struct CodeRow { std::string name; bool patch; bool on; };
+void codesGameStarted();
+void codesReload();
+void codesPickCheatFile(const std::string& path);
+std::vector<CodeRow> codeRows();		// one per code, patches first
+void codeToggle(const std::string& name);
+// A code typed in on the console (name, then GameShark / CodeBreaker words): "" when added, else
+// what is wrong. Kept in <id>-typed.txt in the cheats or the patches folder
+std::string codeAdd(const std::string& name, const std::string& codes, bool patch);
+bool codeTyped(const std::string& name);
+void codeRemoveTyped(const std::string& name);
+// cheats_menu.cpp: the quick menu's cheats; cheatsInput false = back to the quick menu
+void cheatsOpen(float t);
+bool cheatsInput(const MenuInput& in, float t);
+void cheatsDraw(Frame& f, float alpha, float x0, float x1);
+
+// vmu.cpp: memory cards (Flycast's VMU images)
+struct VmuSave
+{
+	std::string fileName, title, description;
+	bool game = false, copyProtected = false;
+	int blocks = 0, firstBlock = 0, headerBlock = 0;
+	int year = 0, month = 0, day = 0, hour = 0, minute = 0;
+	int frames = 0, speed = 0;
+	u32 palette[16] {};				// ImU32 colours
+	std::vector<std::vector<u8>> icons;	// 32x32, 4 bits a pixel, per frame
+	int dirBlock = 0, dirOffset = 0;
+};
+struct VmuCard
+{
+	std::string path;
+	std::vector<u8> image;
+	int totalBlocks = 200, freeBlocks = 0;
+	std::vector<VmuSave> saves;
+};
+bool readVmu(const std::string& path, VmuCard& card);
+std::string deleteSave(VmuCard& card, int index);			// "" when done
+std::string copySave(const VmuCard& from, int index, VmuCard& to);
+std::vector<std::string> vmuFiles();	// the VMU images in Flycast's data folder
+// vmu_viewer.cpp: a card's saves over the settings panel; vmuViewerInput false = closed
+void vmuViewerOpen(const std::string& path, float t);
+bool vmuViewerActive();
+bool vmuViewerInput(const MenuInput& in, float t);
+void vmuViewerDraw(Frame& f, float alpha);
+// "Sonic Adventure  A1" for <serial>_vmu_save_A1.bin, "A2" for vmu_save_A2.bin
+std::string vmuLabel(const std::string& path);
+
+// The cover of the game being played, for the quick menu (the launcher sets it when starting one)
+extern std::string currentGameCover;
+extern std::vector<std::string> currentGameDiscs;	// several: the game is on more than one disc
+
+// covers.cpp
+// The cover to show for a game: the user's own file in /data/Resonance/covers wins, else the
+// box-art database's (downloaded from libretro, or the disc's own 0GDTEX image).
+std::string userCover(const LauncherEntry& e);
+// Bright/dark colours from a cover image (false when it can't be read)
+bool paletteFromImage(const std::string& path, Color& c1, Color& c2);
+
+// sound.cpp
+enum class Sound { Move, Category, Confirm, Launch, Back, Error };
+void soundStart();
+void soundStop();
+void playSound(Sound s);
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/libretro_scraper.h b/shell/ps4/launcher/libretro_scraper.h
new file mode 100644
index 000000000..5605ef4cb
--- /dev/null
+++ b/shell/ps4/launcher/libretro_scraper.h
@@ -0,0 +1,51 @@
+/*
+	Resonance: box art from the libretro thumbnail server, matched by the disc's serial.
+
+	The serial (the IP.BIN product number Flycast's offline scraper reads, e.g. T13002N, MK-51117)
+	is looked up in libretro-database's Redump DAT for the Dreamcast, which gives the Redump name;
+	the thumbnail server names its box art after it. The DAT is downloaded once and kept with the
+	box art. Used on PS4 instead of TheGamesDB (core/ui/boxart/boxart.cpp).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include "ui/boxart/scraper.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+class LibretroScraper : public Scraper
+{
+public:
+	bool initialize(const std::string& saveDirectory) override;
+	// Throws std::runtime_error on network errors (the box-art thread retries those later).
+	void scrape(GameBoxart& item) override;
+
+private:
+	struct DatGame
+	{
+		std::string name;		// Redump name, e.g. "Sonic Adventure 2 (USA) (En,Ja,Fr,De,Es)"
+		std::string region;		// "USA", "Japan", "Europe", "USA, Europe", ...
+	};
+	bool loadDat();
+	bool parseDat(const std::string& text);
+	const DatGame *find(const std::string& serial, u32 region) const;
+
+	std::string directory;
+	std::unordered_map<std::string, std::vector<DatGame>> bySerial;	// normalized serial
+	u64 nextDatAttempt = 0;
+};
diff --git a/shell/ps4/launcher/quick_menu.cpp b/shell/ps4/launcher/quick_menu.cpp
new file mode 100644
index 000000000..23c193b51
--- /dev/null
+++ b/shell/ps4/launcher/quick_menu.cpp
@@ -0,0 +1,347 @@
+/*
+	Resonance's quick menu during a game (L3+R3, or the touchpad), in place of Flycast's commands
+	window: the game paused behind a side panel with its cover and name; Resume, Save State and Load
+	State each with their slot (Left/Right) and a picture of what the slot holds, the volume and the
+	FPS counter changed on the spot, the disc, Settings, Close Game.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "cfg/option.h"
+#include "emulator.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <ctime>
+
+using i18n::T;
+
+namespace launcher
+{
+std::string currentGameCover;
+std::vector<std::string> currentGameDiscs;
+}
+
+using namespace launcher;
+
+namespace
+{
+enum Row { RESUME, SAVE, LOAD, VOLUME, FPS, CHEATS, DISC, SETTINGS, CLOSE, ROWS };
+bool gInCheats;
+
+MenuInput gIn;
+int gSel;
+float gPos, gVel;
+int gLastFrame = -10;
+float gOpenedAt;
+bool gChanged;
+bool gReloadPicture = true;
+Game gCover;
+int gDiscPick;		// the disc the Disc row shows (several discs)
+
+int currentDisc()
+{
+	const std::string path = gui_ps4_disc_path();
+	for (size_t i = 0; i < currentGameDiscs.size(); i++)
+		if (currentGameDiscs[i] == path)
+			return (int)i;
+	return 0;
+}
+
+void changeSlot(int step)
+{
+	config::SavestateSlot = (config::SavestateSlot + step + 10) % 10;
+	gReloadPicture = true;
+	playSound(Sound::Move);
+}
+}
+
+bool launcher_quick_menu_draw()
+{
+	Frame f = menuFrame();
+	const int frame = ImGui::GetFrameCount();
+	if (frame != gLastFrame + 1)
+	{
+		gSel = RESUME;
+		gPos = 0;
+		gOpenedAt = f.t;
+		gReloadPicture = true;
+		gChanged = false;
+		gCover = Game();
+		gCover.cover = currentGameCover;
+		gInCheats = false;
+		gDiscPick = currentDisc();
+		soundStart();
+		playSound(Sound::Category);
+	}
+	gLastFrame = frame;
+	gIn.read(f.t);
+	// the on-screen keyboard (typing a code): the menu waits, and the press that closes it isn't
+	// taken by the menu too
+	static bool keyboardWasOpen;
+	keyboardUpdate();
+	if (keyboardOpen() || keyboardWasOpen)
+	{
+		gIn.dx = gIn.dy = 0;
+		gIn.cross = gIn.circle = gIn.square = gIn.triangle = gIn.l1 = gIn.r1 = false;
+	}
+	keyboardWasOpen = keyboardOpen();
+	ImDrawList *dl = f.dl;
+	const float in = easeOut((f.t - gOpenedAt) / .25f);
+
+	// ---- input ----
+	if (gInCheats)
+	{
+		if (!cheatsInput(gIn, f.t))
+			gInCheats = false;
+	}
+	else if (gIn.dy != 0)
+	{
+		gSel = (gSel + gIn.dy + ROWS) % ROWS;
+		playSound(Sound::Move);
+	}
+	if (gIn.dx != 0 && !gInCheats)
+	{
+		switch (gSel)
+		{
+		case SAVE:
+		case LOAD:
+			changeSlot(gIn.dx);
+			break;
+		case VOLUME:
+			config::AudioVolume.set(std::clamp(config::AudioVolume.get() + gIn.dx * 10, 0, 100));
+			config::AudioVolume.calcDbPower();
+			gChanged = true;
+			playSound(Sound::Move);
+			break;
+		case FPS:
+			config::ShowFPS.set(!config::ShowFPS);
+			gChanged = true;
+			playSound(Sound::Move);
+			break;
+		case DISC:
+			if (currentGameDiscs.size() > 1)
+			{
+				gDiscPick = (gDiscPick + gIn.dx + (int)currentGameDiscs.size()) % (int)currentGameDiscs.size();
+				playSound(Sound::Move);
+			}
+			break;
+		}
+	}
+	const long long date = gui_ps4_state_date(config::SavestateSlot);
+	bool leaving = false;
+	if (gIn.cross && !gInCheats)
+	{
+		switch (gSel)
+		{
+		case RESUME:
+			leaving = true;
+			break;
+		case SAVE:
+			playSound(Sound::Confirm);
+			if (gChanged)
+				SaveSettings();
+			gui_ps4_save_state();
+			return true;
+		case LOAD:
+			if (date == 0)
+				playSound(Sound::Error);
+			else
+			{
+				playSound(Sound::Confirm);
+				if (gChanged)
+					SaveSettings();
+				gui_ps4_load_state();
+				return true;
+			}
+			break;
+		case VOLUME:
+			break;
+		case FPS:
+			config::ShowFPS.set(!config::ShowFPS);
+			gChanged = true;
+			playSound(Sound::Move);
+			break;
+		case CHEATS:
+			playSound(Sound::Confirm);
+			gInCheats = true;
+			cheatsOpen(f.t);
+			break;
+		case DISC:
+			if (currentGameDiscs.size() > 1)
+			{
+				if (gDiscPick == currentDisc() && !gui_ps4_disc_open())
+				{
+					playSound(Sound::Error);
+					break;
+				}
+				playSound(Sound::Confirm);
+				if (gChanged)
+					SaveSettings();
+				gui_ps4_change_disc(currentGameDiscs[gDiscPick]);
+				return true;
+			}
+			playSound(Sound::Confirm);
+			gui_ps4_swap_disc();
+			return true;
+		case SETTINGS:
+			playSound(Sound::Confirm);
+			if (gChanged)
+				SaveSettings();
+			gui_ps4_open_settings();
+			return true;
+		case CLOSE:
+			playSound(Sound::Back);
+			if (gChanged)
+				SaveSettings();
+			soundStop();
+			gui_ps4_quit_game();
+			return true;
+		}
+	}
+	if (gIn.circle && !gInCheats)
+		leaving = true;
+	if (leaving)
+	{
+		playSound(Sound::Back);
+		if (gChanged)
+			SaveSettings();
+		gui_ps4_resume();
+		return true;
+	}
+
+	// ---- the paused game behind a side panel ----
+	const float panelW = f.w * .4f;
+	const float slide = (1 - in) * -panelW * .3f;
+	const ImU32 dark = IM_COL32(4, 8, 18, (int)(235 * in)), mid = IM_COL32(4, 8, 18, (int)(150 * in)), clear = IM_COL32(4, 8, 18, 0);
+	dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(70 * in)));
+	dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(panelW, f.h), dark, mid, mid, dark);
+	dl->AddRectFilledMultiColor(ImVec2(panelW, 0), ImVec2(panelW + f.w * .15f, f.h), mid, clear, clear, mid);
+	const Color tone = xmbTone();
+	dl->AddRectFilled(ImVec2(panelW - 2 + slide, 0), ImVec2(panelW + slide, f.h), tone.u32(.6f * in));
+
+	// cover, name, PAUSED
+	const float x = f.w * .05f + slide;
+	const float coverH = f.h * .1f;
+	const float headY = f.h * .135f;	// under the logo
+	drawCornerLogo(f, in, x);
+	const ImTextureID cover = coverTexture(gCover);
+	if (cover != ImTextureID())
+	{
+		dl->AddRectFilled(ImVec2(x + 4, headY + 5), ImVec2(x + coverH + 4, headY + coverH + 5), IM_COL32(0, 0, 0, (int)(110 * in)), 6.f);
+		dl->AddImageRounded(cover, ImVec2(x, headY), ImVec2(x + coverH, headY + coverH), ImVec2(0, 0), ImVec2(1, 1),
+				IM_COL32(255, 255, 255, (int)(255 * in)), 6.f);
+	}
+	else
+		xmbText(dl, bodyFont(), coverH * .6f, ImVec2(x + coverH * .5f, headY + coverH * .15f), in, ICON_FA_COMPACT_DISC, .5f);
+	const float tx = x + coverH + f.w * .015f;
+	const float pill = f.h * .02f;
+	const std::string paused = T("PAUSED");
+	const float pw = textWidth(bodyFont(), pill, paused) + pill * 1.4f;
+	const float pulse = .75f + .25f * std::sin(f.t * 3.f);
+	dl->AddRectFilled(ImVec2(tx, (headY + f.h * .005f)), ImVec2(tx + pw, (headY + f.h * .005f) + pill * 1.6f), tone.u32(.9f * in * pulse), pill * .8f);
+	xmbText(dl, bodyFont(), pill, ImVec2(tx + pill * .7f, (headY + f.h * .005f) + pill * .28f), in, paused);
+	xmbText(dl, bodyFont(), f.h * .032f, ImVec2(tx, (headY + f.h * .005f) + pill * 2.3f), in, gui_ps4_game_title(), 0, panelW - (tx - slide) - f.w * .02f);
+
+	// the rows
+	spring(gPos, gVel, (float)gSel, 170.f, 26.f, f.dt);
+	char buf[96];
+	struct RowView { const char *icon; std::string label, value; bool arrows; bool dim; };
+	snprintf(buf, sizeof(buf), T("Slot %d"), (int)config::SavestateSlot + 1);
+	const std::string slot = buf;
+	snprintf(buf, sizeof(buf), T("Disc %d"), gDiscPick + 1);
+	const bool severalDiscs = currentGameDiscs.size() > 1;
+	const std::string discValue = severalDiscs ? std::string(buf) : std::string();
+	const RowView rows[ROWS] = {
+		{ ICON_FA_PLAY, T("Resume"), "", false, false },
+		{ ICON_FA_DOWNLOAD, T("Save State"), slot, true, false },
+		{ ICON_FA_CLOCK_ROTATE_LEFT, T("Load State"), slot, true, date == 0 },
+		{ ICON_FA_VOLUME_HIGH, T("Volume Level"), std::to_string(config::AudioVolume.get()) + "%", true, false },
+		{ ICON_FA_GAUGE_HIGH, T("Show FPS Counter"), config::ShowFPS ? T("On") : T("Off"), true, false },
+		{ ICON_FA_MASK, T("Cheats & Patches"), "", false, false },
+		{ ICON_FA_COMPACT_DISC, severalDiscs ? T("Change Disc") : gui_ps4_disc_open() ? T("Insert Disk") : T("Eject Disk"), discValue,
+				severalDiscs, false },
+		{ ICON_FA_GEAR, T("Settings"), "", false, false },
+		{ ICON_FA_POWER_OFF, T("Close Game"), "", false, false },
+	};
+	const float rowH = f.h * .068f, top = f.h * .27f;
+	const float rx0 = x - f.w * .01f, rx1 = panelW - f.w * .025f + slide;
+	// the highlight glides between rows
+	const float hy = top + gPos * rowH;
+	dl->AddRectFilledMultiColor(ImVec2(rx0, hy), ImVec2(rx1, hy + rowH), tone.u32(.55f * in), tone.u32(.12f * in), tone.u32(.12f * in), tone.u32(.55f * in));
+	dl->AddRectFilled(ImVec2(rx0, hy), ImVec2(rx0 + 4, hy + rowH), IM_COL32(255, 255, 255, (int)(230 * in)));
+	const float ts = f.h * .029f;
+	for (int i = 0; i < ROWS; i++)
+	{
+		const RowView& r = rows[i];
+		const float y = top + i * rowH;
+		const float a = in * (r.dim ? .45f : 1.f) * (i == gSel ? 1.f : .82f);
+		const float ty = y + (rowH - ts) * .5f;
+		xmbText(dl, bodyFont(), ts * .95f, ImVec2(x + ts * .7f, ty), a, r.icon, .5f);
+		xmbText(dl, bodyFont(), ts, ImVec2(x + ts * 2.f, ty), a, r.label);
+		if (!r.value.empty())
+		{
+			std::string v = r.value;
+			if (r.arrows && i == gSel)
+				v = std::string(ICON_FA_CARET_LEFT "  ") + v + "  " ICON_FA_CARET_RIGHT;
+			xmbText(dl, bodyFont(), ts * .9f, ImVec2(rx1 - f.w * .01f, ty), a, v, 1.f);
+		}
+	}
+
+	// the slot's card beside the panel while on Save/Load
+	if (gInCheats)
+		cheatsDraw(f, in, panelW + f.w * .04f, f.w * .95f);
+	const float card = clamp01((gSel == SAVE || gSel == LOAD) && !gInCheats ? 1.f : 0.f) * in;
+	if (card > 0)
+	{
+		const ImTextureID pic = (ImTextureID)(uintptr_t)gui_ps4_state_picture(gReloadPicture);
+		gReloadPicture = false;
+		const float cw = f.w * .32f, chh = cw * 3 / 4;
+		const ImVec2 a(panelW + f.w * .08f, f.h * .27f), b(a.x + cw, a.y + chh);
+		dl->AddRectFilled(ImVec2(a.x + 6, a.y + 8), ImVec2(b.x + 6, b.y + 8), IM_COL32(0, 0, 0, (int)(110 * card)), 8.f);
+		dl->AddRectFilled(a, b, IM_COL32(10, 14, 24, (int)(220 * card)), 8.f);
+		if (date != 0 && pic != ImTextureID())
+			dl->AddImageRounded(pic, a, b, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * card)), 8.f);
+		else
+			xmbText(dl, bodyFont(), f.h * .03f, ImVec2((a.x + b.x) / 2, (a.y + b.y) / 2 - f.h * .015f), card * .8f, T("Empty"), .5f);
+		dl->AddRect(a, b, IM_COL32(255, 255, 255, (int)(80 * card)), 8.f, 0, 1.5f);
+		// ten dots: which slot
+		for (int i = 0; i < 10; i++)
+		{
+			const ImVec2 c(a.x + cw * .5f + (i - 4.5f) * f.h * .022f, b.y + f.h * .03f);
+			dl->AddCircleFilled(c, i == config::SavestateSlot ? f.h * .006f : f.h * .0035f,
+					IM_COL32(255, 255, 255, (int)((i == config::SavestateSlot ? 255 : 110) * card)), 12);
+		}
+		std::string when = T("Empty");
+		if (date != 0)
+		{
+			const time_t t = (time_t)date;
+			char tb[64];
+			strftime(tb, sizeof(tb), "%d/%m/%Y  %H:%M", localTm(t));
+			when = tb;
+		}
+		xmbText(dl, bodyFont(), f.h * .026f, ImVec2(a.x, b.y + f.h * .055f), card, slot + "   " + when);
+	}
+
+	xmbClock(f, in);
+	xmbHints(f, { { 'x', T("Select") }, { 'o', gInCheats ? T("Back") : T("Resume") } }, in);
+	return true;
+}
+
+void launcher_open_quick_menu()
+{
+	if (gui_ps4_game_running())
+		gui_ps4_open_quick_menu();
+}
diff --git a/shell/ps4/launcher/settings_menu.cpp b/shell/ps4/launcher/settings_menu.cpp
new file mode 100644
index 000000000..2f0c13cdc
--- /dev/null
+++ b/shell/ps4/launcher/settings_menu.cpp
@@ -0,0 +1,927 @@
+/*
+	Resonance's settings, PS3 style, in place of Flycast's settings window: five groups (Video,
+	Audio, Controllers, System, Home Screen); a group lists its options with the current value on the
+	right; Cross on one opens a drop-down list of its values. The same panel runs inside the Cross
+	bar (Settings column) and as the settings screen (Triangle on the home screen, Settings in the
+	quick menu during a game).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "cfg/cfg.h"
+#include "cfg/option.h"
+#include "emulator.h"
+#include "hw/maple/maple_cfg.h"
+#include "stdclass.h"
+#include "ui/IconsFontAwesome6.h"
+#include "netfs.h"
+#include "updater.h"
+
+#include <atomic>
+#include <functional>
+#include <future>
+
+using i18n::T;
+
+namespace launcher
+{
+namespace
+{
+
+struct Choice
+{
+	std::string label;
+	int value;
+};
+
+struct Setting
+{
+	std::string name, help;
+	std::vector<Choice> choices;
+	std::function<int()> get;
+	std::function<void(int)> set;
+	bool lockedInGame = false;		// needs the game restarted: not while one runs
+	std::function<std::string()> value;	// shown instead of the chosen value's label
+	std::function<void()> action;		// Cross does this instead of opening a list
+};
+
+struct Group
+{
+	const char *icon;
+	std::string name, summary;
+	std::vector<Setting> items;
+};
+
+std::vector<Choice> onOff() {
+	return { { T("Off"), 0 }, { T("On"), 1 } };
+}
+
+template<typename O>
+Setting toggle(const char *name, const char *help, O& opt, bool locked = false)
+{
+	Setting s { T(name), help ? T(help) : "", onOff(),
+		[&opt] { return opt.get() ? 1 : 0; },
+		[&opt](int v) { opt.set(v != 0); }, locked };
+	return s;
+}
+
+template<typename O>
+Setting pick(const char *name, const char *help, O& opt, std::vector<Choice> choices, bool locked = false)
+{
+	using V = std::remove_reference_t<decltype(opt.get())>;
+	Setting s { T(name), help ? T(help) : "", std::move(choices),
+		[&opt] { return (int)opt.get(); },
+		[&opt](int v) { opt.set((V)v); }, locked };
+	return s;
+}
+
+} // namespace
+
+struct SettingsPanel::Impl
+{
+	std::vector<Group> groups;
+	bool open = false;
+	int group = 0, sel = 0;
+	float selPos = 0, selVel = 0, openedAt = -10;
+	bool dropOpen = false;
+	int dropSel = 0;
+	float dropPos = 0, dropVel = 0, dropAt = -10;
+	bool mapleChanged[4] {};
+	bool expansionChanged[4][2] {};
+	bool changed = false;
+
+	void build()
+	{
+		groups.clear();
+		char buf[128];
+
+		Group video { ICON_FA_DISPLAY, T("Video Settings"), T("Resolution, widescreen, filtering, frame rate"), {} };
+		// in a game: its own settings or every game's (a 2D game without widescreen, say)
+		if (gui_ps4_game_running())
