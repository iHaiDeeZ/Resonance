+			ISP_BACKGND_T.full, ISP_BACKGND_D.f, FPU_PARAM_CFG, ISP_FEED_CFG, FOG_COL_RAM, FOG_COL_VERT, FOG_DENSITY.full,
+			PAL_RAM_CTRL);
+	for (const RenderPass& p : rc.render_passes)
+		fprintf(f, "pass autosort %d zclear %d op %u mvo %u pt %u tr %u mvo_tr %u sorted %u\n", p.autosort, p.z_clear, p.op_count,
+				p.mvo_count, p.pt_count, p.tr_count, p.mvo_tr_count, p.sorted_tr_count);
+	auto list = [&](const char *name, const std::vector<PolyParam>& polys) {
+		fprintf(f, "== %s %zu\n", name, polys.size());
+		int n = 0;
+		for (const PolyParam& pp : polys)
+		{
+			if (n++ >= 600)
+				break;
+			float x0 = 1e9f, y0 = 1e9f, z0 = 1e9f, x1 = -1e9f, y1 = -1e9f, z1 = -1e9f, u0 = 1e9f, v0 = 1e9f, u1 = -1e9f, v1 = -1e9f;
+			u32 c = 0;
+			for (u32 i = pp.first; i < pp.first + pp.count && i < rc.idx.size(); i++)
+			{
+				const u32 vi = rc.idx[i];
+				if (vi >= rc.verts.size())
+					continue;
+				const Vertex& v = rc.verts[vi];
+				x0 = std::min(x0, v.x); x1 = std::max(x1, v.x);
+				y0 = std::min(y0, v.y); y1 = std::max(y1, v.y);
+				z0 = std::min(z0, v.z); z1 = std::max(z1, v.z);
+				u0 = std::min(u0, v.u); u1 = std::max(u1, v.u);
