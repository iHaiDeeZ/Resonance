+const char *const kPatchFileUrl = "https://raw.githubusercontent.com/iHaiDeeZ/Resonance/main/game-patches/";
+// The community's Flycast chart (nexus382/Flycast-Widescreen-Compatability-And-Cheat-Chart): a
+// "60 FPS Cheats" column of CodeBreaker codes per game and region. Read where it is, not copied
+const char *const kChartUrl = "https://raw.githubusercontent.com/nexus382/Flycast-Widescreen-Compatability-And-Cheat-Chart/main/Dreamcast%20Widescreen.md";
+
+// the keys of one entry in a RetroArch .cht
+const char *const kChtKeys[] = { "address", "address_bit_position", "big_endian", "cheat_type", "code", "desc", "dest_address",
+	"enable", "handler", "memory_search_size", "value", "repeat_count", "repeat_add_to_value", "repeat_add_to_address" };
+
+std::mutex gMutex;
+std::string gGameId;
+std::map<std::string, bool> gIsPatch;	// entry name -> patch (else cheat)
+std::map<std::string, bool> gState;		// entry name -> on, as the player left it
+std::set<std::string> gTyped;			// names of the codes typed in on the console
+
+std::string typedPath(bool patch);
+
+std::string dir(const char *sub) {
+	return std::string(kRoot) + "/" + sub;
+}
+
+void mkdirs()
+{
+	mkdir(kRoot, 0777);
+	mkdir(dir("cheats").c_str(), 0777);
+	mkdir(dir("cheats/state").c_str(), 0777);
+	mkdir(dir("patches").c_str(), 0777);
+	mkdir(dir("patches/online").c_str(), 0777);
+}
+
+std::string safeId(std::string id)
+{
+	for (char& c : id)
+		if (!isalnum((unsigned char)c) && c != '-')
+			c = '_';
+	return id.empty() ? "game" : id;
+}
+
+bool readFile(const std::string& path, std::string& out)
+{
+	FILE *f = fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	out.clear();
+	char buf[8192];
+	size_t n;
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0 && out.size() < (1u << 20))
+		out.append(buf, n);
+	fclose(f);
+	return true;
+}
+
+bool writeFile(const std::string& path, const std::string& data)
+{
+	FILE *f = fopen(path.c_str(), "wb");
+	if (f == nullptr)
+		return false;
+	const bool ok = fwrite(data.data(), 1, data.size(), f) == data.size();
+	fclose(f);
+	return ok;
+}
+
+bool endsWith(const std::string& s, const char *ext)
+{
+	const size_t n = strlen(ext);
+	if (s.size() < n)
+		return false;
+	for (size_t i = 0; i < n; i++)
+		if (tolower((unsigned char)s[s.size() - n + i]) != ext[i])
+			return false;
+	return true;
+}
+
+// a cheat file's entry that is really a patch
+bool patchByName(const std::string& name)
+{
+	static const std::regex re("60 ?fps|60 ?hz|frame ?rate|widescreen|wide screen|16:9|no ?blur|deflicker|progressive", std::regex::icase);
+	return std::regex_search(name, re);
+}
+
+std::string statePath() {
+	return dir("cheats/state/") + safeId(gGameId) + ".txt";
+}
+
+void loadState()
+{
+	gState.clear();
+	std::string text;
+	if (!readFile(statePath(), text))
+		return;
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == std::string::npos)
+			end = text.size();
+		const std::string line = text.substr(at, end - at);
+		at = end + 1;
+		if (line.size() > 2 && (line[0] == '0' || line[0] == '1') && line[1] == '\t')
+			gState[line.substr(2)] = line[0] == '1';
+	}
+}
+
+void saveState()
+{
+	std::string text = "# Resonance: cheats and patches switched on (1) or off (0) for this game\n";
+	for (const auto& [name, on] : gState)
+		text += std::string(on ? "1" : "0") + "\t" + name + "\n";
+	writeFile(statePath(), text);
+}
+
+// The game's patch files of the player's own and the downloaded ones
+std::vector<std::string> patchFiles()
+{
+	std::vector<std::string> out;
+	const std::string title = gui_ps4_game_title();
+	for (const char *sub : { "patches", "patches/online" })
+	{
+		DIR *d = opendir(dir(sub).c_str());
+		if (d == nullptr)
+			continue;
+		while (dirent *e = readdir(d))
+		{
+			const std::string name = e->d_name;
+			if (!endsWith(name, ".cht") && !endsWith(name, ".txt"))
+				continue;
+			const std::string stem = name.substr(0, name.size() - 4);
+			if (stem == safeId(gGameId) || stem == gGameId || stem == safeId(gGameId) + "-typed" || stem == safeId(gGameId) + "-chart"
+					|| (!title.empty() && titleScore(title, stem) >= .75f))
+				out.push_back(dir(sub) + "/" + name);
+		}
+		closedir(d);
+	}
+	std::sort(out.begin(), out.end());
+	return out;
+}
+
+// One .cht's entries appended to the merged file
+void appendCht(const std::string& path, bool patches, config::IniFile& out, int& n)
+{
+	std::string text;
+	if (!readFile(path, text))
+		return;
+	config::IniFile in;
+	in.load(text);
+	const int count = in.getInt("", "cheats", 0);
+	for (int i = 0; count == 0 || i < count; i++)
+	{
+		const std::string from = "cheat" + std::to_string(i) + "_";
+		if (!in.hasEntry("", from + "address"))
+		{
+			if (count == 0)
+				break;
+			continue;
+		}
+		const std::string to = "cheat" + std::to_string(n) + "_";
+		for (const char *key : kChtKeys)
+			if (in.hasEntry("", from + key))
+				out.set("", to + key, in.getString("", from + key));
+		const std::string name = in.getString("", from + "desc", "Cheat " + std::to_string(i + 1));
+		gIsPatch[name] = patches || patchByName(name);
+		n++;
+	}
+}
+
+// A list of GameShark / CodeBreaker codes: a name line, then its codes ("XXXXXXXX YYYYYYYY")
+void addCodeList(const std::string& path, bool patches)
+{
+	std::string text;
+	if (!readFile(path, text))
+		return;
+	const bool typed = endsWith(path, "-typed.txt");
+	std::string name, codes;
+	auto flush = [&]() {
+		if (!name.empty() && !codes.empty())
+		{
+			try {
+				cheatManager.addGameSharkCheat(name, codes);
+				gIsPatch[name] = patches || patchByName(name);
+				if (typed)
+					gTyped.insert(name);
+			} catch (const std::exception& e) {
+				WARN_LOG(COMMON, "codes '%s': %s", name.c_str(), e.what());
+			}
+		}
+		codes.clear();
+	};
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == std::string::npos)
+			end = text.size();
+		std::string line = text.substr(at, end - at);
+		at = end + 1;
+		while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+			line.pop_back();
+		if (line.empty() || line[0] == '#' || line[0] == ';')
+			continue;
+		bool hex = true;
+		int digits = 0;
+		for (char c : line)
+		{
+			if (isxdigit((unsigned char)c))
+				digits++;
+			else if (c != ' ' && c != '-' && c != '\t')
+				hex = false;
+		}
+		if (hex && digits >= 8)
+			codes += line + " ";
+		else
+		{
+			flush();
+			name = line;
+		}
+	}
+	flush();
+}
+
+// Everything for the game into Flycast's cheat engine (the emulation is stopped, or this runs on
+// its thread)
+void rebuild()
+{
+	std::lock_guard<std::mutex> lock(gMutex);
+	mkdirs();
+	gIsPatch.clear();
+	gTyped.clear();
+	const std::string cheatFile = config::loadStr("cheats", gGameId);
+	const int patchSource = config::loadInt("resonance", "PatchSource", 0);
+	config::IniFile merged;
+	int n = 0;
+	std::vector<std::string> lists;
+	if (patchSource != 2)
+		for (const std::string& p : patchFiles())
+		{
+			if (endsWith(p, ".cht"))
+				appendCht(p, true, merged, n);
+			else
+				lists.push_back(p);
+		}
+	if (!cheatFile.empty() && cheatFile.find("-active.cht") == std::string::npos)
+	{
+		if (endsWith(cheatFile, ".txt") && !endsWith(cheatFile, ".cht"))
+			lists.push_back(cheatFile);
+		else
+			appendCht(cheatFile, false, merged, n);
+	}
+	merged.set("", "cheats", n);
+	std::string data;
+	merged.save(data);
+	const std::string active = dir("cheats/state/") + safeId(gGameId) + "-active.cht";
+	writeFile(active, data);
+	cheatManager.loadCheatFile(active);
+	// Flycast remembers the file it loaded: keep the one the player picked
+	config::saveStr("cheats", gGameId, cheatFile);
+	// cheats typed in on the console go with the picked file
+	struct stat st;
+	if (stat(typedPath(false).c_str(), &st) == 0)
+		lists.push_back(typedPath(false));
+	for (const std::string& p : lists)
+	{
+		const bool patches = p.find("/patches/") != std::string::npos;
+		addCodeList(p, patches);
+	}
+	// on or off: as left, else patches on and cheats off
+	for (size_t i = 0; i < cheatManager.cheatCount(); i++)
+	{
+		const std::string name = cheatManager.cheatDescription(i);
+		auto st = gState.find(name);
+		const bool patch = gIsPatch.count(name) ? gIsPatch[name] : patchByName(name);
+		cheatManager.enableCheat(i, st != gState.end() ? st->second : patch);
+	}
+	if (patchSource == 2)
+		for (size_t i = 0; i < cheatManager.cheatCount(); i++)
+			if (gIsPatch[cheatManager.cheatDescription(i)])
+				cheatManager.enableCheat(i, false);
+	char line[160];
+	snprintf(line, sizeof(line), "codes: %s: %d entries", gGameId.c_str(), (int)cheatManager.cheatCount());
+	ps4_boot_trace(line);
+}
+
+// Patch Source on Download automatically: the library's patch for the game, a day at most old
+void fetchPatches(std::string gameId, std::string title)
+{
+	mkdirs();
+	const std::string indexPath = dir("patches/online/index.txt");
+	std::string index, error;
+	struct stat st;
+	if (stat(indexPath.c_str(), &st) != 0 || time(nullptr) - st.st_mtime > 24 * 3600 || !readFile(indexPath, index))
+	{
+		if (ps4_http_get(kPatchIndexUrl, index, error) != 200)
+			return;
+		writeFile(indexPath, index);
+	}
+	// "<file>\t<product id>\t<title>" lines
+	std::string best;
+	float bestScore = 0;
+	size_t at = 0;
+	while (at < index.size())
+	{
+		size_t end = index.find('\n', at);
+		if (end == std::string::npos)
+			end = index.size();
+		std::string line = index.substr(at, end - at);
+		at = end + 1;
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+		if (line.empty() || line[0] == '#')
+			continue;
+		const size_t t1 = line.find('\t'), t2 = t1 == std::string::npos ? t1 : line.find('\t', t1 + 1);
+		if (t1 == std::string::npos)
+			continue;
+		const std::string file = line.substr(0, t1);
+		const std::string id = line.substr(t1 + 1, t2 == std::string::npos ? std::string::npos : t2 - t1 - 1);
+		const std::string name = t2 == std::string::npos ? "" : line.substr(t2 + 1);
+		const float score = !id.empty() && id == gameId ? 2.f : name.empty() ? 0.f : titleScore(title, name);
+		if (score > bestScore && file.find('/') == std::string::npos && (endsWith(file, ".cht") || endsWith(file, ".txt")))
+		{
+			bestScore = score;
+			best = file;
+		}
+	}
+	if (best.empty() || bestScore < .75f)
+		return;
+	const std::string dest = dir("patches/online/") + safeId(gameId) + (endsWith(best, ".txt") ? ".txt" : ".cht");
+	std::string body, old;
+	if (ps4_http_get(kPatchFileUrl + best, body, error) != 200 || body.empty())
+		return;
+	if (readFile(dest, old) && old == body)
+		return;
+	writeFile(dest, body);
+	ps4_boot_trace(("codes: patches for " + gameId + " from the library: " + best).c_str());
+	// into the running game, from the emulation thread
+	emu.run([gameId] {
+		if (gameId == gGameId)
+			rebuild();
+	});
+}
+
+// The disc's region from its product id: NA (T13002N, MK-51000), EU (T13002D, MK-5100050,
+// T-8117D-50), JP (T1218M, HDR-0080); "" when it can't be told
+std::string regionOf(const std::string& id)
+{
+	std::string s;
+	for (char c : id)
+		if (isalnum((unsigned char)c))
+			s += (char)toupper((unsigned char)c);
+	if (s.empty())
+		return "";
+	if (s.rfind("HDR", 0) == 0 || s.back() == 'M')
+		return "JP";
+	if (s.back() == 'N')
+		return "NA";
+	if (s.find('D') != std::string::npos && s.rfind("MK", 0) != 0)
+		return "EU";
+	if (s.rfind("MK51", 0) == 0)
+		return s.size() > 7 ? "EU" : "NA";	// MK-51000 / MK-5100050
+	if (s.size() > 2 && s.compare(s.size() - 2, 2, "50") == 0)
+		return "EU";
+	return "";
+}
+
+// The code words in a chart cell: pairs of 8 hex digits ("0103337C 00000009, ..."); a first word
+// written with 7 digits gets its leading 0 back. Words without a partner (disc offsets) are left out
+std::string chartCodes(const std::string& cell)
+{
+	static const std::regex pair("\\b([0-9A-Fa-f]{7,8})\\s+([0-9A-Fa-f]{8})\\b");
+	std::string out;
+	for (auto it = std::sregex_iterator(cell.begin(), cell.end(), pair); it != std::sregex_iterator(); ++it)
+	{
+		std::string a = (*it)[1].str(), b = (*it)[2].str();
+		if (a.size() == 7)
+			a = "0" + a;
+		for (char& c : a) c = (char)toupper((unsigned char)c);
+		for (char& c : b) c = (char)toupper((unsigned char)c);
+		out += a + " " + b + "\n";
+	}
+	return out;
+}
+
+// Patch Source on Download automatically: the chart's 60 fps code for the game, when its row is
+// for the disc's region (codes differ between regions)
+void fetchChart(std::string gameId, std::string title)
+{
+	const std::string chartPath = dir("patches/online/chart-dreamcast.md");
+	std::string chart, error;
+	struct stat st;
+	if (stat(chartPath.c_str(), &st) != 0 || time(nullptr) - st.st_mtime > 24 * 3600 || !readFile(chartPath, chart))
+	{
+		if (ps4_http_get(kChartUrl, chart, error) != 200 || chart.empty())
+			return;
+		writeFile(chartPath, chart);
+	}
+	const std::string region = regionOf(gameId);
+	// "| title | region | native ws | ws hack | ws cheat | 60 fps | notes |"
+	std::string bestCodes, bestTitle, bestNote;
+	float bestScore = 0;
+	int rowsForTitle = 0;
+	size_t at = 0;
+	while (at < chart.size())
+	{
+		size_t end = chart.find('\n', at);
+		if (end == std::string::npos)
+			end = chart.size();
+		const std::string line = chart.substr(at, end - at);
+		at = end + 1;
+		if (line.size() < 2 || line[0] != '|' || line.compare(0, 4, "|---") == 0)
+			continue;
+		std::vector<std::string> cells;
+		size_t p = 1;
+		while (p < line.size())
+		{
+			size_t q = line.find('|', p);
+			if (q == std::string::npos)
+				break;
+			std::string c = line.substr(p, q - p);
+			while (!c.empty() && isspace((unsigned char)c.back())) c.pop_back();
+			while (!c.empty() && isspace((unsigned char)c[0])) c.erase(0, 1);
+			cells.push_back(c);
+			p = q + 1;
+		}
+		if (cells.size() < 6 || cells[0] == "Game Title")
+			continue;
+		const float score = titleScore(title, cells[0]);
+		if (score < .75f)
+			continue;
+		rowsForTitle++;
+		const std::string codes = chartCodes(cells[5]);
+		if (codes.empty())
+			continue;
+		const bool regionOk = region.empty() ? false : cells[1] == region;
+		if (!regionOk)
+			continue;
+		if (score > bestScore)
+		{
+			bestScore = score;
+			bestCodes = codes;
+			bestTitle = cells[0];
+			// words before the codes say what the code does ("60fps battles ...")
+			static const std::regex firstPair("[0-9A-Fa-f]{7,8}\\s+[0-9A-Fa-f]{8}");
+			std::smatch m;
+			bestNote = std::regex_search(cells[5], m, firstPair) ? cells[5].substr(0, m.position(0)) : std::string();
+		}
+	}
+	if (bestCodes.empty())
+		return;
+	std::string name = "60 FPS";
+	{
+		std::string lower;
+		for (char c : bestNote)
+			lower += (char)tolower((unsigned char)c);
+		if (lower.find("battle") != std::string::npos)
+			name = "60 FPS (battles)";
+	}
+	const std::string dest = dir("patches/online/") + safeId(gameId) + "-chart.txt";
+	const std::string body = "# " + bestTitle + " (" + region + "): from the Flycast Widescreen Compatibility and Cheat Chart\n"
+			"# https://github.com/nexus382/Flycast-Widescreen-Compatability-And-Cheat-Chart\n" + name + "\n" + bestCodes;
+	std::string old;
+	if (readFile(dest, old) && old == body)
+		return;
+	writeFile(dest, body);
+	ps4_boot_trace(("codes: 60 fps for " + gameId + " from the Flycast chart (" + bestTitle + ", " + region + ")").c_str());
+	emu.run([gameId] {
+		if (gameId == gGameId)
+			rebuild();
+	});
+}
+
+// Cheat Source on Download automatically and nothing picked: the best match from libretro's
+// database (left off)
+void fetchCheats(std::string gameId, std::string title)
+{
+	std::string error;
+	const std::vector<CheatCandidate> found = cheatCandidates(title, error);
+	if (found.empty() || found[0].score < .75f)
+		return;
+	const std::string dest = dir("cheats/") + safeId(gameId) + ".cht";
+	if (!downloadCheat(found[0].name, dest).empty())
+		return;
+	ps4_boot_trace(("codes: cheats for " + gameId + ": " + found[0].name).c_str());
+	emu.run([gameId, dest] {
+		if (gameId != gGameId || !config::loadStr("cheats", gameId).empty())
+			return;
+		config::saveStr("cheats", gameId, dest);
+		rebuild();
+	});
+}
+std::string typedPath(bool patch) {
+	return dir(patch ? "patches/" : "cheats/") + safeId(gGameId) + "-typed.txt";
+}
+
+// a typed file without the code of this name (its name line and the code lines under it)
+void removeBlock(const std::string& path, const std::string& name)
+{
+	std::string text, out;
+	if (!readFile(path, text))
+		return;
+	bool skipping = false;
+	size_t at = 0;
+	while (at < text.size())
+	{
+		size_t end = text.find('\n', at);
+		if (end == std::string::npos)
+			end = text.size();
+		const std::string line = text.substr(at, end - at);
+		at = end + 1;
+		bool hex = !line.empty();
+		for (char c : line)
+			if (!isxdigit((unsigned char)c) && c != ' ')
+				hex = false;
+		if (!hex && !line.empty() && line[0] != '#')
+			skipping = line == name;
+		if (!skipping)
+			out += line + "\n";
+	}
+	writeFile(path, out);
+}
+} // namespace
+
+std::string codeAdd(const std::string& rawName, const std::string& codes, bool patch)
+{
+	if (gGameId.empty())
+		return i18n::T("Start a game first");
+	std::string name = rawName;
+	while (!name.empty() && isspace((unsigned char)name.back()))
+		name.pop_back();
+	while (!name.empty() && isspace((unsigned char)name[0]))
+		name.erase(0, 1);
+	// the words: 8 hex digits each, separated by spaces, dashes, colons or nothing
+	std::string digits;
+	for (char c : codes)
+	{
+		if (isxdigit((unsigned char)c))
+			digits += (char)toupper((unsigned char)c);
+		else if (!isspace((unsigned char)c) && c != '-' && c != ':' && c != ',')
+			return i18n::T("Codes are hex digits only: XXXXXXXX YYYYYYYY");
+	}
+	if (digits.size() < 16 || digits.size() % 8 != 0)
+		return i18n::T("Codes are hex digits only: XXXXXXXX YYYYYYYY");
+	bool nameLooksLikeCode = true;
+	int nameDigits = 0;
+	for (char c : name)
+	{
+		if (isxdigit((unsigned char)c))
+			nameDigits++;
+		else if (c != ' ' && c != '-')
+			nameLooksLikeCode = false;
+	}
+	if (name.empty() || (nameLooksLikeCode && nameDigits >= 8))
+	{
+		char buf[64];
+		snprintf(buf, sizeof(buf), patch ? i18n::T("Patch %d") : i18n::T("Cheat %d"), (int)codeRows().size() + 1);
+		name = buf;
+	}
+	for (const CodeRow& r : codeRows())
+		if (r.name == name)
+			return i18n::T("A code with this name is already there");
+	std::string block = name + "\n";
+	for (size_t i = 0; i < digits.size(); i += 8)
+		block += digits.substr(i, 8) + ((i / 8) % 2 == 0 && i + 8 < digits.size() ? " " : "\n");
+	mkdirs();
+	std::string text;
+	readFile(typedPath(patch), text);
+	if (!text.empty() && text.back() != '\n')
+		text += "\n";
+	if (text.empty())
+		text = std::string("# typed in on the console: a name line, then its codes\n");
+	writeFile(typedPath(patch), text + block);
+	{
+		std::lock_guard<std::mutex> lock(gMutex);
+		gState[name] = true;	// typed in to be used
+		saveState();
+	}
+	rebuild();
+	return "";
+}
+
+bool codeTyped(const std::string& name)
+{
+	std::lock_guard<std::mutex> lock(gMutex);
+	return gTyped.count(name) != 0;
+}
+
+void codeRemoveTyped(const std::string& name)
+{
+	if (!codeTyped(name))
+		return;
+	removeBlock(typedPath(false), name);
+	removeBlock(typedPath(true), name);
+	{
+		std::lock_guard<std::mutex> lock(gMutex);
+		gState.erase(name);
+		saveState();
+	}
+	rebuild();
+}
+
+void codesGameStarted()
+{
+	// a game's start also reports a disc change: once is enough
+	static std::string lastId;
+	static time_t lastAt;
+	const time_t now = time(nullptr);
+	if (settings.content.gameId == lastId && now - lastAt < 5)
+		return;
+	lastId = settings.content.gameId;
+	lastAt = now;
+	gGameId = settings.content.gameId;
+	if (gGameId.empty())
+		return;
+	loadState();
+	rebuild();
+	const std::string title = gui_ps4_game_title();
+	const std::string id = gGameId;
+	const bool cheatsMissing = config::loadStr("cheats", id).empty();
+	if (config::loadInt("resonance", "PatchSource", 0) == 0 || (cheatsAutomatic() && cheatsMissing))
+		std::thread([id, title, cheatsMissing] {
+			ThreadName _("GameCodes");
+			if (config::loadInt("resonance", "PatchSource", 0) == 0)
+			{
+				fetchPatches(id, title);
+				fetchChart(id, title);
+			}
+			if (cheatsAutomatic() && cheatsMissing)
+				fetchCheats(id, title);
+		}).detach();
+}
+
+void codesReload() {
+	rebuild();
+}
+
+void codesPickCheatFile(const std::string& path)
+{
+	config::saveStr("cheats", gGameId, path);
+	rebuild();
+}
+
+std::vector<CodeRow> codeRows()
+{
+	std::vector<CodeRow> rows;
+	for (size_t i = 0; i < cheatManager.cheatCount(); i++)
+	{
+		const std::string name = cheatManager.cheatDescription(i);
+		// a GameShark code is several entries under one name: one row
+		if (!rows.empty() && rows.back().name == name)
+			continue;
+		bool patch;
+		{
+			std::lock_guard<std::mutex> lock(gMutex);
+			patch = gIsPatch.count(name) ? gIsPatch[name] : patchByName(name);
+		}
+		rows.push_back({ name, patch, cheatManager.cheatEnabled(i) });
+	}
+	std::stable_sort(rows.begin(), rows.end(), [](const CodeRow& a, const CodeRow& b) { return a.patch > b.patch; });
+	return rows;
+}
+
+void codeToggle(const std::string& name)
+{
+	bool on = false;
+	for (size_t i = 0; i < cheatManager.cheatCount(); i++)
+		if (cheatManager.cheatDescription(i) == name)
+		{
+			on = !cheatManager.cheatEnabled(i);
+			break;
+		}
+	for (size_t i = 0; i < cheatManager.cheatCount(); i++)
+		if (cheatManager.cheatDescription(i) == name)
+			cheatManager.enableCheat(i, on);
+	std::lock_guard<std::mutex> lock(gMutex);
+	gState[name] = on;
+	saveState();
+}
+
+} // namespace launcher
+
+void launcher_game_started()
+{
+	static bool listening;
+	if (!listening)
+	{
+		listening = true;
+		// another disc: Flycast reloads its cheats for it
+		EventManager::listen(Event::DiskChange, [](Event, void *) { launcher::codesGameStarted(); }, nullptr);
+	}
+	launcher::codesGameStarted();
+}
