+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include <string>
+#include <vector>
+
+namespace netfs
+{
+
+struct Share
+{
+	std::string type;		// "nfs" or "smb"
+	std::string label;		// in paths: nfs://<label>/...
+	std::string host;		// IP address or name
+	std::string path;		// NFS: the exported folder ("/d/games"); SMB: share[/folder] ("Games/Dreamcast")
+	std::string user, password;	// SMB only
+	std::string url() const { return type + "://" + label + "/"; }
+	std::string describe() const;	// "NFS  192.168.0.10:/d/games"
+};
+
+std::vector<Share> shares();
+// Adds (or, label already there, replaces) a share and puts it in the content folders; saved
+void addShare(Share share);
+void removeShare(const std::string& label);
+// A label for a new share from its server and folder, unique among the shares
+std::string makeLabel(const std::string& host, const std::string& path);
+// Connects and lists the share's top folder: "" when it works, else what went wrong.
+// games = files with a game extension found directly in it (for the message)
+std::string test(const Share& share, int& entries);
+
+}
