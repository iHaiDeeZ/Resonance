+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "ps4_gamepad.h"
+#include "imgui_internal.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <chrono>
+#include <ctime>
+
+namespace launcher
+{
+
+Color xmbTone()
+{
+	// January silver, February gold, March lime, April pink, May green, June violet, July teal,
+	// August blue, September purple, October amber, November brown, December red
+	static const Color months[12] = {
+		{ .62f, .64f, .70f }, { .80f, .64f, .16f }, { .46f, .66f, .16f }, { .84f, .42f, .60f },
+		{ .14f, .56f, .26f }, { .56f, .34f, .76f }, { .10f, .56f, .64f }, { .16f, .38f, .82f },
+		{ .44f, .24f, .66f }, { .76f, .56f, .12f }, { .52f, .32f, .18f }, { .74f, .14f, .16f },
+	};
+	const time_t now = time(nullptr);
+	const tm *lt = localTm(now);
+	return months[lt != nullptr ? lt->tm_mon % 12 : 7];
+}
+
+void xmbBackground(Frame& f, bool overGame)
+{
+	ImDrawList *dl = f.dl;
+	const Color tone = xmbTone();
+	const Color top = mix(tone, { 0, 0, 0 }, .55f), mid = mix(tone, { 0, 0, 0 }, .15f), bottom = mix(tone, { 0, 0, 0 }, .6f);
+	const float a = overGame ? .82f : 1.f;
+	const float split = f.h * .55f;
+	dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, split), top.u32(a), top.u32(a), mid.u32(a), mid.u32(a));
+	dl->AddRectFilledMultiColor(ImVec2(0, split), ImVec2(f.w, f.h), mid.u32(a), mid.u32(a), bottom.u32(a), bottom.u32(a));
+
+	// the wave: two thin sheets of light rolling slowly across the middle
+	constexpr int N = 120;
+	const ImVec2 white = whiteUV(dl);
+	for (int s = 0; s < 2; s++)
+	{
+		ImVec2 upper[N + 1], lower[N + 1];
+		for (int i = 0; i <= N; i++)
+		{
+			const float x = (float)i / N;
+			const float ph = f.t * (.18f + .07f * s) + s * 1.9f;
+			const float y = f.h * (.56f + .03f * s) + f.h * .045f * std::sin(x * 5.2f + ph) + f.h * .02f * std::sin(x * 11.f - ph * 1.3f);
+			const float thick = f.h * (.035f + .025f * std::sin(x * 3.1f + ph * .7f + s));
+			upper[i] = ImVec2(x * f.w, y - thick * .5f);
+			lower[i] = ImVec2(x * f.w, y + thick * .5f);
+		}
+		dl->PrimReserve(N * 6, (N + 1) * 2);
+		const u32 base = dl->_VtxCurrentIdx;
+		for (int i = 0; i <= N; i++)
+		{
+			const float edge = clamp01(std::min(i, N - i) / 14.f);
+			dl->PrimWriteVtx(upper[i], white, IM_COL32(255, 255, 255, (int)(26 * edge * a)));
+			dl->PrimWriteVtx(lower[i], white, IM_COL32(255, 255, 255, (int)(6 * edge * a)));
+		}
+		for (int i = 0; i < N; i++)
+		{
+			const ImDrawIdx v = (ImDrawIdx)(base + i * 2);
+			dl->PrimWriteIdx(v); dl->PrimWriteIdx(v + 1); dl->PrimWriteIdx(v + 3);
+			dl->PrimWriteIdx(v); dl->PrimWriteIdx(v + 3); dl->PrimWriteIdx(v + 2);
+		}
+		// the bright edge of the sheet
+		dl->AddPolyline(upper, N + 1, IM_COL32(255, 255, 255, (int)(70 * a)), 0, 1.5f);
+	}
+}
+
+float xmbText(ImDrawList *dl, ImFont *font, float size, ImVec2 pos, float alpha, const std::string& text,
+		float align, float maxWidth, ImU32 color)
+{
+	if (alpha <= 0)
+		return 0;
+	const float off = std::max(1.f, size * .06f);
+	drawText(dl, font, size, ImVec2(pos.x + off, pos.y + off), IM_COL32(0, 0, 0, (int)(110 * alpha)), text, align, maxWidth);
+	const ImU32 c = (color & ~IM_COL32_A_MASK) | ((ImU32)(((color >> IM_COL32_A_SHIFT) & 0xff) * alpha) << IM_COL32_A_SHIFT);
+	return drawText(dl, font, size, pos, c, text, align, maxWidth);
+}
+
+void xmbClock(Frame& f, float alpha)
+{
+	char clock[32];
+	const time_t now = time(nullptr);
+	const tm *lt = localTm(now);
+	strftime(clock, sizeof(clock), "%d/%m  %H:%M", lt);
+	const float size = f.h * .026f;
+	const float w = xmbText(f.dl, bodyFont(), size, ImVec2(f.w * .94f, f.h * .055f), alpha, clock, 1.f);
+	// the PS3's little clock face beside it
+	const ImVec2 c(f.w * .94f - w - size * .9f, f.h * .055f + size * .55f);
+	f.dl->AddCircle(c, size * .45f, IM_COL32(255, 255, 255, (int)(220 * alpha)), 20, 1.5f);
+	const float h = (lt->tm_hour % 12 + lt->tm_min / 60.f) / 12.f * 2 * PI, m = lt->tm_min / 60.f * 2 * PI;
+	f.dl->AddLine(c, ImVec2(c.x + std::sin(h) * size * .25f, c.y - std::cos(h) * size * .25f), IM_COL32(255, 255, 255, (int)(220 * alpha)), 1.5f);
+	f.dl->AddLine(c, ImVec2(c.x + std::sin(m) * size * .36f, c.y - std::cos(m) * size * .36f), IM_COL32(255, 255, 255, (int)(220 * alpha)), 1.5f);
+}
+
+void xmbHints(Frame& f, const std::vector<Hint>& hints, float alpha)
+{
+	if (alpha <= 0)
+		return;
+	ImFont *font = bodyFont();
+	const float size = f.h * .028f, fs = f.h * .022f, y = f.h * .935f, gap = size * .5f;
+	float total = 0;
+	for (const Hint& h : hints)
+		total += size + gap + textWidth(font, fs, h.label) + size * 1.2f;
+	float x = f.w * .94f - total;
+	for (const Hint& h : hints)
+	{
+		drawButton(f.dl, h.button, ImVec2(x + size / 2, y), size, alpha);
+		x += size + gap;
+		x += xmbText(f.dl, font, fs, ImVec2(x, y - fs * .62f), alpha * .9f, h.label);
+		x += size * 1.2f;
+	}
+}
+
+void xmbItem(Frame& f, ImVec2 c, const char *glyph, const Game *game, const std::string& title,
+		const std::string& subtitle, float focus, float alpha)
+{
+	if (alpha <= .01f)
+		return;
+	ImDrawList *dl = f.dl;
+	const float icon = f.h * (.07f + .03f * focus);
+	if (focus > .01f)
+		drawBlob(dl, c, icon * 1.3f, IM_COL32(255, 255, 255, (int)(40 * focus * alpha)));
+	if (game != nullptr)
+	{
+		// a game: its cover (wider than tall, like a PS3 game icon), else its colours and a disc
+		const ImVec2 a(c.x - icon * .75f, c.y - icon * .5f), b(c.x + icon * .75f, c.y + icon * .5f);
+		const ImTextureID tex = coverTexture(*game);
+		dl->AddRectFilled(ImVec2(a.x + 3, a.y + 4), ImVec2(b.x + 3, b.y + 4), IM_COL32(0, 0, 0, (int)(70 * alpha)), icon * .05f);
+		if (tex != ImTextureID())
+			// the cover's middle band
+			dl->AddImageRounded(tex, a, b, ImVec2(0, .17f), ImVec2(1, .83f), IM_COL32(255, 255, 255, (int)(255 * alpha)), icon * .05f);
+		else
+		{
+			dl->AddRectFilledMultiColor(a, b, game->c1.u32(alpha), game->c2.u32(alpha), game->c2.u32(alpha), game->c1.u32(alpha));
+			drawText(dl, bodyFont(), icon * .5f, ImVec2(c.x, c.y - icon * .28f), IM_COL32(255, 255, 255, (int)(200 * alpha)), ICON_FA_COMPACT_DISC, .5f);
+		}
+	}
+	else if (glyph != nullptr)
+		xmbText(dl, bodyFont(), icon * .78f, ImVec2(c.x, c.y - icon * .42f), alpha, glyph, .5f);
+	const float tx = c.x + f.h * .1f;
+	const float ts = f.h * (.028f + .006f * focus);
+	const float maxW = f.w * .94f - tx;
+	if (subtitle.empty() || focus < .01f)
+		xmbText(dl, bodyFont(), ts, ImVec2(tx, c.y - ts * .6f), alpha, title, 0, maxW);
+	else
+	{
+		xmbText(dl, bodyFont(), ts, ImVec2(tx, c.y - ts * (.6f + .55f * focus)), alpha, title, 0, maxW);
+		xmbText(dl, bodyFont(), f.h * .021f, ImVec2(tx, c.y + ts * .35f), alpha * focus, subtitle, 0, maxW, IM_COL32(220, 226, 236, 255));
+	}
+}
+
+Frame menuFrame()
+{
+	static auto start = std::chrono::steady_clock::now();
+	ImGuiIO& io = ImGui::GetIO();
+	Frame f {};
+	f.dl = ImGui::GetBackgroundDrawList();
+	f.w = io.DisplaySize.x;
+	f.h = io.DisplaySize.y;
+	f.t = std::chrono::duration<float>(std::chrono::steady_clock::now() - start).count();
+	f.dt = std::min(.05f, io.DeltaTime);
+	f.games = nullptr;
+	f.launchAt = -1;
+	return f;
+}
+
+void MenuInput::read(float t)
+{
+	u32 buttons = 0;
+	float lx = 0, ly = 0;
+	ps4_pad_state(buttons, lx, ly);
+	const int frame = ImGui::GetFrameCount();
+	if (frame != lastFrame + 1)
+	{
+		// (re)appearing: what's held now was pressed for something else
+		prev = buttons;
+		held = -1;
+	}
+	lastFrame = frame;
+	const u32 pressed = buttons & ~prev;
+	prev = buttons;
+	cross = pressed & ORBIS_PAD_BUTTON_CROSS;
+	circle = pressed & ORBIS_PAD_BUTTON_CIRCLE;
+	triangle = pressed & ORBIS_PAD_BUTTON_TRIANGLE;
+	square = pressed & ORBIS_PAD_BUTTON_SQUARE;
+	l1 = pressed & ORBIS_PAD_BUTTON_L1;
+	r1 = pressed & ORBIS_PAD_BUTTON_R1;
+	int dir = 0;
+	if ((buttons & ORBIS_PAD_BUTTON_LEFT) || lx < -.55f) dir = 1;
+	else if ((buttons & ORBIS_PAD_BUTTON_RIGHT) || lx > .55f) dir = 2;
+	else if ((buttons & ORBIS_PAD_BUTTON_UP) || ly < -.55f) dir = 3;
+	else if ((buttons & ORBIS_PAD_BUTTON_DOWN) || ly > .55f) dir = 4;
+	dx = dy = 0;
+	if (held == -1)
+	{
+		// wait for a direction held across the change to be let go
+		if (dir == 0)
+			held = 0;
+		return;
+	}
+	bool fire = false;
+	if (dir != held)
+	{
+		held = dir;
+		fire = dir != 0;
+		repeatAt = t + .38f;
+	}
+	else if (dir != 0 && t >= repeatAt)
+	{
+		fire = true;
+		repeatAt = t + .085f;
+	}
+	if (fire)
+	{
+		dx = dir == 1 ? -1 : dir == 2 ? 1 : 0;
+		dy = dir == 3 ? -1 : dir == 4 ? 1 : 0;
+	}
+}
+
