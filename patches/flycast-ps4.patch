+		{
+			VmuCard card;
+			const bool ok = readVmu(path, card);
+			char buf[96];
+			snprintf(buf, sizeof(buf), T("%d of %d blocks free"), card.freeBlocks, card.totalBlocks);
+			Setting item { vmuLabel(path), T("Cross: the saves on this card"), {}, [] { return 0; }, [](int) {} };
+			const std::string value = ok ? std::string(buf) : std::string("?");
+			item.value = [value] { return value; };
+			item.action = [this, path] { vmuViewerOpen(path, now); };
+			cards.items.push_back(item);
+		}
+		if (cards.items.empty())
+		{
+			Setting none { T("No memory cards yet"), T("A game creates them when it saves"), {}, [] { return 0; }, [](int) {} };
+			none.action = [] {};
+			none.value = [] { return std::string(); };
+			cards.items.push_back(none);
+		}
+		return cards;
+	}
