+// The games folders on the console's own disk changed (a game folder added or removed, a file put
+// in one): a number from their times and entry counts. Shares on the network are left to R3.
+u64 libraryStamp()
+{
+	u64 stamp = 0;
+	for (const std::string& root : config::ContentPath.get())
+	{
+		if (root.empty() || root.find("://") != std::string::npos)
+			continue;
+		struct stat st;
+		if (stat(root.c_str(), &st) != 0)
+			continue;
+		stamp = stamp * 31 + (u64)st.st_mtime;
+		DIR *d = opendir(root.c_str());
+		if (d == nullptr)
+			continue;
+		int entries = 0;
+		while (dirent *e = readdir(d))
+		{
+			entries++;
+			if (e->d_type != DT_DIR || e->d_name[0] == '.')
+				continue;
+			const std::string sub = root + (root.back() == '/' ? "" : "/") + e->d_name;
+			if (stat(sub.c_str(), &st) == 0)
+				stamp = stamp * 31 + (u64)st.st_mtime;
+		}
+		closedir(d);
+		stamp = stamp * 31 + (u64)entries;
+	}
+	return stamp;
+}
