new file mode 100644
index 000000000..c970bb9f7
--- /dev/null
+++ b/shell/ps4/audiobackend_ps4.cpp
@@ -0,0 +1,196 @@
+/*
+	Resonance: audio through sceAudioOut.
+
+	The AICA's 44.1 kHz stereo goes into a ring buffer; an output thread resamples it to the
+	48 kHz the PS4's audio out plays and hands it over one 256-frame grain at a time
+	(sceAudioOutOutput blocks until the previous grain plays, which paces the thread).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "audio/audiostream.h"
+#include "cfg/option.h"
+#include "oslib/oslib.h"
+#include "stdclass.h"
+
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+constexpr int32_t kSystemUser = 0xFF;		// the main port, whoever is signed in
+constexpr u32 kGrainFrames = 256;
+constexpr u32 kOutputRate = 48000;
+constexpr u32 kInputRate = 44100;
+constexpr int32_t kVolumeMax = 32768;		// SCE_AUDIO_VOLUME_0DB
+// libkernel declares these without parameters
+using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+using SetPrioFn = int32_t (*)(OrbisPthread, int);
+}
+
+class PS4AudioBackend : public AudioBackend
+{
+public:
+	PS4AudioBackend()
+		: AudioBackend("ps4", "PS4 Audio Out") {}
+
+	bool init() override
+	{
+		const int32_t result = sceAudioOutInit();
+		// already initialized by an earlier backend instance is fine
+		if (result != 0 && result != (int32_t)0x8026000E)
+		{
+			ERROR_LOG(AUDIO, "PS4: sceAudioOutInit failed: %x", result);
+			return false;
+		}
+		port = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, kOutputRate,
+				ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+		if (port < 0)
+		{
+			ERROR_LOG(AUDIO, "PS4: sceAudioOutOpen failed: %x", port);
+			return false;
+		}
+		int32_t volume[2] = { kVolumeMax, kVolumeMax };
+		sceAudioOutSetVolume(port, 0x3, volume);	// front left + right
+
+		capacity = std::max<u32>(SAMPLE_COUNT * 2, (u32)config::AudioBufferSize);
+		ring.assign(capacity, 0);
+		readPos = 0;
+		count = 0;
+		position = 0.0;
+		underruns = 0;
+		running = true;
+		thread = std::thread(&PS4AudioBackend::outputLoop, this);
+		INFO_LOG(AUDIO, "PS4: audio port %x, buffer %u frames", port, capacity);
+		return true;
+	}
+
+	u32 push(const void *data, u32 frames, bool wait) override
+	{
+		const u32 *in = (const u32 *)data;
+		std::unique_lock<std::mutex> lock(mutex);
+		// timed: a signal can make a PS4 condition variable lose its wakeup (DolphinPS4)
+		if (wait)
+			while (!spaceFreed.wait_for(lock, std::chrono::milliseconds(20),
+					[&] { return count + frames <= capacity || !running; }))
+				;
+		const u32 n = std::min(frames, capacity - count);
+		u32 writePos = (readPos + count) % capacity;
+		for (u32 i = 0; i < n; i++)
+		{
+			ring[writePos] = in[i];
+			writePos = writePos + 1 == capacity ? 0 : writePos + 1;
+		}
+		count += n;
+		return 1;
+	}
+
+	void term() override
+	{
+		if (!running)
+			return;
+		{
+			std::lock_guard<std::mutex> lock(mutex);
+			running = false;
+		}
+		spaceFreed.notify_all();
+		if (thread.joinable())
+			thread.join();
+		if (port >= 0)
+		{
+			sceAudioOutClose(port);
+			port = -1;
+		}
+	}
+
+private:
+	static s16 left(u32 frame) { return (s16)(frame & 0xffff); }
+	static s16 right(u32 frame) { return (s16)(frame >> 16); }
+
+	void outputLoop()
+	{
+		ThreadName _("PS4AudioOut");
+		// a thread inherits its creator's cores; take all of the app's, and a priority above the
+		// emulation's so a slow frame doesn't make the sound crackle
+		const OrbisPthread self = scePthreadSelf();
+		((SetAffinityFn)&scePthreadSetaffinity)(self, 0x3F);
+		((SetPrioFn)&scePthreadSetprio)(self, 400);
+
+		alignas(32) s16 grains[2][kGrainFrames * 2];
+		int current = 0;
+		const double step = (double)kInputRate / kOutputRate;
+		while (running)
+		{
+			s16 *out = grains[current];
+			bool filled = false;
+			{
+				std::lock_guard<std::mutex> lock(mutex);
+				// input frames this grain reads (plus one to interpolate towards)
+				const u32 needed = (u32)(position + step * kGrainFrames) + 2;
+				if (count >= needed)
+				{
+					double pos = position;
+					for (u32 i = 0; i < kGrainFrames; i++)
+					{
+						const u32 index = (u32)pos;
+						const float frac = (float)(pos - index);
+						const u32 a = ring[(readPos + index) % capacity];
+						const u32 b = ring[(readPos + index + 1) % capacity];
+						out[i * 2] = (s16)(left(a) + (left(b) - left(a)) * frac);
+						out[i * 2 + 1] = (s16)(right(a) + (right(b) - right(a)) * frac);
+						pos += step;
+					}
+					const u32 consumed = (u32)pos;
+					position = pos - consumed;
+					readPos = (readPos + consumed) % capacity;
+					count -= consumed;
+					filled = true;
+				}
+			}
+			if (filled)
+				spaceFreed.notify_all();
+			else
+			{
+				// the emulator is behind (a slow frame, the menu, loading): silence
+				std::fill(out, out + kGrainFrames * 2, 0);
+				underruns++;
+			}
+			sceAudioOutOutput(port, out);
+			current ^= 1;
+		}
+		sceAudioOutOutput(port, nullptr);	// wait for the last grain
+	}
+
+	int32_t port = -1;
+	std::vector<u32> ring;
+	u32 capacity = 0;
+	u32 readPos = 0;
+	u32 count = 0;
+	double position = 0.0;		// fractional read position (input frames)
+	u64 underruns = 0;
+	std::atomic<bool> running { false };
+	std::mutex mutex;
+	std::condition_variable spaceFreed;
+	std::thread thread;
+};
+static PS4AudioBackend ps4AudioBackend;
diff --git a/shell/ps4/launcher/cheats_db.cpp b/shell/ps4/launcher/cheats_db.cpp
new file mode 100644
index 000000000..c03302c84
--- /dev/null
+++ b/shell/ps4/launcher/cheats_db.cpp
@@ -0,0 +1,253 @@
+/*
+	Resonance cheats: RetroArch .cht files, from libretro's cheat database (libretro-database,
+	cht/Sega - Dreamcast) or from /data/Resonance/cheats. The database's file names are loose titles
+	("Vigilante 8-2nd Offense.cht"), so a game's title is matched by its words; the list of names is
+	kept for a week (/data/Resonance/cheats/libretro-index.txt).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "updater.h"
+#include "cfg/cfg.h"
+#include "json.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <dirent.h>
+#include <set>
+#include <sys/stat.h>
+
+namespace launcher
+{
+namespace
+{
+const char *const kListUrl = "https://api.github.com/repos/libretro/libretro-database/contents/cht/Sega%20-%20Dreamcast";
+const char *const kRawUrl = "https://raw.githubusercontent.com/libretro/libretro-database/master/cht/Sega%20-%20Dreamcast/";
+
+std::string cheatsDir() {
+	return "/data/Resonance/cheats";
+}
+
+std::vector<std::string> words(const std::string& s)
+{
+	// region and edition words don't tell games apart; "Version 1.0" is an edition, not a sequel
+	static const std::set<std::string> noise = { "the", "usa", "us", "europe", "european", "japan", "japanese", "version",
+		"en", "fr", "de", "es", "it", "ja", "rev", "disc", "cht", "included", "with" };
+	std::vector<std::string> out;
+	std::string w;
+	bool afterVersion = false;
+	auto flush = [&]() {
+		if (w.empty())
+			return;
+		const bool number = isdigit((unsigned char)w[0]);
+		if (w == "version")
+			afterVersion = true;
+		else if (afterVersion && number)
+			;
+		else
+		{
+			afterVersion = false;
+			if (noise.count(w) == 0 && std::find(out.begin(), out.end(), w) == out.end())
+				out.push_back(w);
+		}
+		w.clear();
+	};
+	for (char c : s)
+	{
+		if (isalnum((unsigned char)c))
+			w += (char)tolower((unsigned char)c);
+		else
+			flush();
+	}
+	flush();
+	return out;
+}
+
+std::string joined(const std::vector<std::string>& words)
+{
+	std::string s;
+	for (const std::string& w : words)
+		s += w;
+	return s;
+}
+
+std::string urlEncode(const std::string& s)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	std::string out;
+	for (unsigned char c : s)
+	{
+		if (isalnum(c) || strchr("-_.~()!,'", c) != nullptr)
+			out += (char)c;
+		else
+		{
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 15];
+		}
+	}
+	return out;
+}
+
+// The database's file names, from the cache when it's less than a week old
+std::vector<std::string> index(std::string& error)
+{
+	const std::string path = cheatsDir() + "/libretro-index.txt";
+	std::vector<std::string> names;
+	struct stat st;
+	if (stat(path.c_str(), &st) == 0 && time(nullptr) - st.st_mtime < 7 * 24 * 3600)
+	{
+		if (FILE *f = fopen(path.c_str(), "r"))
+		{
+			char line[512];
+			while (fgets(line, sizeof(line), f) != nullptr)
+			{
+				std::string s = line;
+				while (!s.empty() && (s.back() == '\n' || s.back() == '\r'))
+					s.pop_back();
+				if (!s.empty())
+					names.push_back(s);
+			}
+			fclose(f);
+		}
+		if (!names.empty())
+			return names;
+	}
+	std::string body;
+	const long status = ps4_http_get(kListUrl, body, error);
+	if (status != 200)
+	{
+		if (error.empty())
+			error = "GitHub answered " + std::to_string(status);
+		return names;
+	}
+	try {
+		for (const auto& e : nlohmann::json::parse(body))
+		{
+			const std::string name = e.value("name", "");
+			if (name.size() > 4 && (name.compare(name.size() - 4, 4, ".cht") == 0))
+				names.push_back(name);
+		}
+	} catch (const std::exception&) {
+		error = "unexpected answer from GitHub";
+		return {};
+	}
+	mkdir(cheatsDir().c_str(), 0777);
+	if (FILE *f = fopen(path.c_str(), "w"))
+	{
+		for (const std::string& n : names)
+			fprintf(f, "%s\n", n.c_str());
+		fclose(f);
+	}
+	return names;
+}
+} // namespace
+
+float titleScore(const std::string& title, const std::string& name)
+{
+	const std::vector<std::string> want = words(title), have = words(name);
+	if (want.empty() || have.empty())
+		return 0.f;
+	{
+		int common = 0;
+		for (const std::string& w : want)
+			common += std::count(have.begin(), have.end(), w) > 0;
+		// the same title written differently ("Soulcalibur", "Soul Calibur")
+		const bool same = joined(want) == joined(have);
+		if (common == 0 && !same)
+			return 0.f;
+		// every word of the title found, few extra words: near 1
+		float score = same ? 1.f : (float)common / want.size() - .08f * std::max(0, (int)have.size() - common);
+		// numbers must agree ("Crazy Taxi" vs "Crazy Taxi 2")
+		if (!same)
+		{
+			for (const std::string& w : have)
+				if (isdigit((unsigned char)w[0]) && std::find(want.begin(), want.end(), w) == want.end())
+					score -= .5f;
+			for (const std::string& w : want)
+				if (isdigit((unsigned char)w[0]) && std::find(have.begin(), have.end(), w) == have.end())
+					score -= .5f;
+		}
+		// a file for another region's disc: its codes are for other addresses; offered, never picked alone
+		std::string lowerName;
+		for (char c : name)
+			lowerName += (char)tolower((unsigned char)c);
+		if (lowerName.find("japan") != std::string::npos || lowerName.find("europe") != std::string::npos)
+			score -= .3f;
+		return score;
+	}
+}
+
+std::vector<CheatCandidate> cheatCandidates(const std::string& title, std::string& error)
+{
+	std::vector<CheatCandidate> out;
+	if (words(title).empty())
+		return out;
+	for (const std::string& name : index(error))
+	{
+		const float score = titleScore(title, name.substr(0, name.size() - 4));
+		if (score > .3f)
+			out.push_back({ name, score });
+	}
+	std::sort(out.begin(), out.end(), [](const CheatCandidate& a, const CheatCandidate& b) { return a.score > b.score; });
+	if (out.size() > 12)
+		out.resize(12);
+	return out;
+}
+
+std::string downloadCheat(const std::string& name, const std::string& dest)
+{
+	std::string body, error;
+	const long status = ps4_http_get(kRawUrl + urlEncode(name), body, error);
+	if (status != 200)
+		return error.empty() ? "GitHub answered " + std::to_string(status) : error;
+	mkdir(cheatsDir().c_str(), 0777);
+	FILE *f = fopen(dest.c_str(), "wb");
+	if (f == nullptr)
+		return "can't write " + dest;
+	fwrite(body.data(), 1, body.size(), f);
+	fclose(f);
+	return "";
+}
+
+std::vector<std::string> folderCheats()
+{
+	std::vector<std::string> out;
+	if (DIR *d = opendir(cheatsDir().c_str()))
+	{
+		while (dirent *e = readdir(d))
+		{
+			const std::string name = e->d_name;
+			if (name.size() < 5 || name == "libretro-index.txt" || name.find("-typed.txt") != std::string::npos)
+				continue;
+			const std::string ext = name.substr(name.size() - 4);
+			if (ext == ".cht" || ext == ".txt")
+				out.push_back(cheatsDir() + "/" + name);
+		}
+		closedir(d);
+	}
+	std::sort(out.begin(), out.end());
+	return out;
+}
+
+bool cheatsAutomatic() {
+	return config::loadInt("resonance", "CheatSource", 0) == 0;
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/cheats_menu.cpp b/shell/ps4/launcher/cheats_menu.cpp
new file mode 100644
index 000000000..924623f74
--- /dev/null
+++ b/shell/ps4/launcher/cheats_menu.cpp
@@ -0,0 +1,334 @@
+/*
+	Resonance's cheats in the quick menu: the game's cheats, each On/Off, and "Get Cheats": a list of
+	matching files from libretro's cheat database (by the game's title) and the files in
+	/data/Resonance/cheats. With Cheat Source on Download automatically, a game without cheats gets
+	the best match when the list is opened. The file chosen is remembered for the game (Flycast's
+	[cheats] in emu.cfg).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "cheats.h"
+#include "emulator.h"
+#include "cfg/cfg.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <future>
+
+using i18n::T;
+
+namespace launcher
+{
+namespace
+{
+enum class View { LIST, PICK };
+
+struct Source
+{
+	std::string label;		// shown
+	std::string name;		// database file name, or
+	std::string path;		// a file in the folder
+	bool online = false;
+};
+
+View gView;
+int gSel;
+float gPos, gVel;
+std::vector<Source> gSources;
+std::future<std::vector<CheatCandidate>> gSearch;
+std::string gSearchError;
+std::future<std::string> gDownload;
+std::string gDownloadPath, gDownloadLabel;
+bool gAutoPick;			// the search was started to take the best match by itself
+std::string gStatus;
+float gStatusAt = -10;
+bool gStatusBad;
+float gNow;
+
+void say(const std::string& text, bool bad)
+{
+	gStatus = text;
+	gStatusAt = gNow;
+	gStatusBad = bad;
+}
+
+std::string fileStem(const std::string& path)
+{
+	std::string s = path.substr(path.find_last_of('/') + 1);
+	const size_t dot = s.find_last_of('.');
+	return dot == std::string::npos ? s : s.substr(0, dot);
+}
+
+// where a downloaded file for this game goes
+std::string downloadPath()
+{
+	std::string id = settings.content.gameId;
+	for (char& c : id)
+		if (!isalnum((unsigned char)c) && c != '-')
+			c = '_';
+	if (id.empty())
+		id = "game";
+	return "/data/Resonance/cheats/" + id + ".cht";
+}
+
+void load(const std::string& path, const std::string& label)
+{
+	codesPickCheatFile(path);
+	char buf[256];
+	snprintf(buf, sizeof(buf), T("Cheats loaded: %s"), label.c_str());
+	say(buf, false);
+	playSound(Sound::Confirm);
+	gView = View::LIST;
+	gSel = 0;
+}
+
+void startSearch(bool autoPick)
+{
+	if (gSearch.valid())
+		return;
+	gAutoPick = autoPick;
+	gSources.clear();
+	gSearchError.clear();
+	say(T("Searching for cheats..."), false);
+	const std::string title = gui_ps4_game_title();
+	if (cheatsAutomatic())
+		gSearch = std::async(std::launch::async, [title] {
+			std::string error;
+			auto list = cheatCandidates(title, error);
+			gSearchError = error;
+			return list;
+		});
+	else
+		gSearch = std::async(std::launch::deferred, [] { return std::vector<CheatCandidate>(); });
+}
+
+void startDownload(const Source& s)
+{
+	if (gDownload.valid())
+		return;
+	gDownloadPath = downloadPath();
+	gDownloadLabel = s.label;
+	say(T("Downloading..."), false);
+	const std::string name = s.name, dest = gDownloadPath;
+	gDownload = std::async(std::launch::async, [name, dest] { return downloadCheat(name, dest); });
+}
+
+void poll()
+{
+	if (gSearch.valid() && gSearch.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+	{
+		const std::vector<CheatCandidate> found = gSearch.get();
+		gSources.clear();
+		for (const CheatCandidate& c : found)
+			gSources.push_back({ c.name.substr(0, c.name.size() - 4), c.name, "", true });
+		for (const std::string& p : folderCheats())
+			gSources.push_back({ fileStem(p), "", p, false });
+		if (gAutoPick && !found.empty() && found[0].score >= .75f)
+		{
+			startDownload(gSources[0]);
+			return;
+		}
+		if (gSources.empty())
+		{
+			if (!gSearchError.empty())
+			{
+				char buf[256];
+				snprintf(buf, sizeof(buf), T("Couldn't download the cheats: %s"), gSearchError.c_str());
+				say(buf, true);
+			}
+			else
+				say(cheatsAutomatic() ? T("No cheats found for this game") : T("Put .cht or .txt files in /data/Resonance/cheats"), false);
+			return;
+		}
+		gStatus.clear();
+		gView = View::PICK;
+		gSel = 0;
+		gPos = 0;
+	}
+	if (gDownload.valid() && gDownload.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+	{
+		const std::string error = gDownload.get();
+		if (error.empty())
+			load(gDownloadPath, gDownloadLabel);
+		else
+		{
+			char buf[256];
+			snprintf(buf, sizeof(buf), T("Couldn't download the cheats: %s"), error.c_str());
+			say(buf, true);
+			playSound(Sound::Error);
+		}
+	}
+}
+} // namespace
+
+void cheatsOpen(float t)
+{
+	gNow = t;
+	gView = View::LIST;
+	gSel = 0;
+	gPos = 0;
+	gStatus.clear();
+	// nothing picked for the game yet: the best match by itself
+	if (config::loadStr("cheats", settings.content.gameId).empty() && cheatsAutomatic())
+		startSearch(true);
+}
+
+bool cheatsInput(const MenuInput& in, float t)
+{
+	gNow = t;
+	poll();
+	const std::vector<CodeRow> codes = codeRows();
+	// LIST: Get Cheats, Add Cheat Code, Add Patch Code, then the codes
+	constexpr int FIRST_CODE = 3;
+	const int n = gView == View::LIST ? (int)codes.size() + FIRST_CODE : (int)gSources.size();
+	if (in.dy != 0 && n > 0)
+	{
+		gSel = std::clamp(gSel + in.dy, 0, n - 1);
+		playSound(Sound::Move);
+	}
+	if (in.circle)
+	{
+		playSound(Sound::Back);
+		if (gView == View::PICK)
+		{
+			gView = View::LIST;
+			gSel = 0;
+			return true;
+		}
+		return false;
+	}
+	// Square: a code typed in here goes again
+	if (in.square && gView == View::LIST && gSel >= FIRST_CODE && gSel - FIRST_CODE < (int)codes.size()
+			&& codeTyped(codes[gSel - FIRST_CODE].name))
+	{
+		const std::string name = codes[gSel - FIRST_CODE].name;
+		codeRemoveTyped(name);
+		char buf[256];
+		snprintf(buf, sizeof(buf), T("Removed: %s"), name.c_str());
+		say(buf, false);
+		playSound(Sound::Back);
+		gSel = std::min(gSel, (int)codeRows().size() + FIRST_CODE - 1);
+		return true;
+	}
+	if (!in.cross || gSearch.valid() || gDownload.valid())
+		return true;
+	if (gView == View::LIST)
+	{
+		if (gSel == 0)
+		{
+			playSound(Sound::Confirm);
+			startSearch(false);
+		}
+		else if (gSel == 1 || gSel == 2)
+		{
+			// typed in: a name, then the codes
+			const bool patch = gSel == 2;
+			playSound(Sound::Confirm);
+			openKeyboard(patch ? T("Name of the patch (e.g. 60 FPS)") : T("Name of the cheat (e.g. Infinite Lives)"), "", false,
+				[patch](bool ok, const std::string& name) {
+					if (!ok)
+						return;
+					openKeyboard(T("Codes: XXXXXXXX YYYYYYYY XXXXXXXX YYYYYYYY ..."), "", false,
+						[patch, name](bool ok, const std::string& codes) {
+							if (!ok)
+								return;
+							const std::string error = codeAdd(name, codes, patch);
+							if (error.empty())
+							{
+								say(T("Code added"), false);
+								playSound(Sound::Confirm);
+							}
+							else
+							{
+								say(error, true);
+								playSound(Sound::Error);
+							}
+						});
+				});
+		}
+		else if (gSel - FIRST_CODE < (int)codes.size())
+		{
+			// remembered for the game; a GameShark code's lines go together
+			codeToggle(codes[gSel - FIRST_CODE].name);
+			playSound(Sound::Move);
+		}
+	}
+	else if (gSel < (int)gSources.size())
+	{
+		const Source& s = gSources[gSel];
+		if (s.online)
+			startDownload(s);
+		else
+			load(s.path, s.label);
+	}
+	return true;
+}
+
+void cheatsDraw(Frame& f, float alpha, float x0, float x1)
+{
+	ImDrawList *dl = f.dl;
+	const float top = f.h * .2f, rowH = f.h * .058f, ts = f.h * .026f;
+	const Color tone = xmbTone();
+	dl->AddRectFilled(ImVec2(x0, top - f.h * .08f), ImVec2(x1, f.h * .9f), IM_COL32(6, 10, 20, (int)(200 * alpha)), 10.f);
+	xmbText(dl, bodyFont(), f.h * .032f, ImVec2(x0 + f.w * .015f, top - f.h * .065f), alpha,
+			std::string(ICON_FA_MASK "  ") + (gView == View::LIST ? T("Cheats & Patches") : T("Get Cheats")));
+
+	struct Line { std::string label, value; };
+	std::vector<Line> lines;
+	const std::vector<CodeRow> codes = gView == View::LIST ? codeRows() : std::vector<CodeRow>();
+	if (gView == View::LIST)
+	{
+		lines.push_back({ std::string(ICON_FA_DOWNLOAD "  ") + T("Get Cheats"), "" });
+		lines.push_back({ std::string(ICON_FA_KEYBOARD "  ") + T("Add Cheat Code"), "" });
+		lines.push_back({ std::string(ICON_FA_KEYBOARD "  ") + T("Add Patch Code"), "" });
+		// patches (a wrench) above cheats
+		for (const CodeRow& c : codes)
+			lines.push_back({ std::string(c.patch ? ICON_FA_WRENCH "  " : ICON_FA_MASK "  ") + c.name, c.on ? T("On") : T("Off") });
+	}
+	else
+		for (const Source& s : gSources)
+			lines.push_back({ s.label, s.online ? std::string(ICON_FA_GLOBE) : std::string(ICON_FA_FOLDER_OPEN) });
+
+	spring(gPos, gVel, (float)gSel, 170.f, 26.f, f.dt);
+	const int visible = (int)((f.h * .62f) / rowH);
+	const float scroll = std::clamp(gPos - visible * .4f, 0.f, std::max(0.f, (float)lines.size() - visible));
+	dl->PushClipRect(ImVec2(x0, top), ImVec2(x1, top + visible * rowH), true);
+	const float hy = top + (gPos - scroll) * rowH;
+	dl->AddRectFilledMultiColor(ImVec2(x0 + 6, hy), ImVec2(x1 - 6, hy + rowH), tone.u32(.5f * alpha), tone.u32(.12f * alpha),
+			tone.u32(.12f * alpha), tone.u32(.5f * alpha));
+	for (int i = 0; i < (int)lines.size(); i++)
+	{
+		const float y = top + (i - scroll) * rowH;
+		if (y < top - rowH || y > top + visible * rowH)
+			continue;
+		const float a = alpha * (i == gSel ? 1.f : .8f);
+		const float ty = y + (rowH - ts) * .5f;
+		xmbText(dl, bodyFont(), ts, ImVec2(x0 + f.w * .015f, ty), a, lines[i].label, 0, (x1 - x0) * .75f);
+		if (!lines[i].value.empty())
+			xmbText(dl, bodyFont(), ts * .92f, ImVec2(x1 - f.w * .015f, ty), a, lines[i].value, 1.f);
+	}
+	dl->PopClipRect();
+	if (gView == View::LIST && codes.empty() && gStatus.empty())
+		xmbText(dl, bodyFont(), ts * .9f, ImVec2(x0 + f.w * .015f, top + rowH * 1.6f), alpha * .8f, T("No cheats or patches yet"));
+	if (gView == View::LIST && gSel >= 3 && gSel - 3 < (int)codes.size() && codeTyped(codes[gSel - 3].name) && gStatus.empty())
+		xmbText(dl, bodyFont(), f.h * .023f, ImVec2(x0 + f.w * .015f, f.h * .86f), alpha * .85f, T("Square: remove this code"));
+	const bool busy = gSearch.valid() || gDownload.valid();
+	if (!gStatus.empty() && (busy || gNow - gStatusAt < 8.f))
+		xmbText(dl, bodyFont(), f.h * .023f, ImVec2(x0 + f.w * .015f, f.h * .86f), alpha, gStatus, 0, x1 - x0 - f.w * .03f,
+				gStatusBad ? IM_COL32(255, 150, 140, 255) : IM_COL32(170, 240, 190, 255));
+}
