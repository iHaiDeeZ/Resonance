+extern "C" void ps4_boot_trace(const char *line);
+
+namespace
+{
+const char *const kLatest = "https://api.github.com/repos/iHaiDeeZ/Resonance/releases/latest";
+const std::string kData = "/data/Resonance";
+const std::string kUpdateDir = kData + "/app";			// the unpacked update
+const std::string kPending = kData + "/app-pending.txt";	// written before starting it
+const std::string kFailed = kData + "/app-failed";		// an update that didn't start
+const char *const kRunningUpdate = "--resonance-update";	// argument to the update we start
+
+bool gRunningUpdate;
+
+void log(const std::string& text) {
+	ps4_boot_trace(("update: " + text).c_str());
+}
+
+std::string firstLine(const std::string& path)
+{
+	std::string line;
+	if (FILE *f = fopen(path.c_str(), "r"))
+	{
+		char buf[64] = {};
+		if (fgets(buf, sizeof(buf), f) != nullptr)
+			line = buf;
+		fclose(f);
+	}
+	while (!line.empty() && (line.back() == '\n' || line.back() == '\r' || line.back() == ' '))
+		line.pop_back();
+	return line;
+}
+
+void removeTree(const std::string& path)
+{
+	if (DIR *d = opendir(path.c_str()))
+	{
+		while (dirent *e = readdir(d))
+		{
+			if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+				continue;
+			const std::string child = path + "/" + e->d_name;
+			struct stat st;
+			if (stat(child.c_str(), &st) == 0 && S_ISDIR(st.st_mode))
+				removeTree(child);
+			else
+				remove(child.c_str());
+		}
+		closedir(d);
+	}
+	rmdir(path.c_str());
+}
+
+void makeDirs(const std::string& path)
+{
+	for (size_t p = 1; p != std::string::npos; p = path.find('/', p + 1))
+		mkdir(path.substr(0, p).c_str(), 0777);
+	mkdir(path.c_str(), 0777);
+}
+
+std::string lower(std::string s)
+{
+	for (char& c : s)
+		c = (char)tolower((unsigned char)c);
+	return s;
+}
+
+bool endsWith(const std::string& s, const std::string& end) {
+	return s.size() >= end.size() && s.compare(s.size() - end.size(), end.size(), end) == 0;
+}
+
+std::string caFile() {
+	return std::string(ps4_app_dir()) + "/launcher/cacert.pem";
+}
+
+// A GET through libcurl: the body to sink (false stops it), progress(done, total). HTTP status, or 0
+long get(const std::string& url, const std::function<bool(const char *, size_t)>& sink,
+		const std::function<bool(uint64_t, uint64_t)>& progress, long timeout, std::string& error)
+{
+	struct Context {
+		const std::function<bool(const char *, size_t)> *sink;
+		const std::function<bool(uint64_t, uint64_t)> *progress;
+	} ctx { &sink, &progress };
+	CURL *curl = curl_easy_init();
+	if (curl == nullptr)
+	{
+		error = "curl failed to start";
+		return 0;
+	}
+	char curlError[CURL_ERROR_SIZE] = {};
+	curl_slist *headers = nullptr;
+	headers = curl_slist_append(headers, "Accept: application/vnd.github+json");
+	headers = curl_slist_append(headers, "X-GitHub-Api-Version: 2022-11-28");
+	curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+	curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+	curl_easy_setopt(curl, CURLOPT_USERAGENT, ("Resonance/" + ps4_app_version()).c_str());
+	curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+	curl_easy_setopt(curl, CURLOPT_CAINFO, caFile().c_str());
+	curl_easy_setopt(curl, CURLOPT_ERRORBUFFER, curlError);
+	curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 20L);
+	if (timeout > 0)
+		curl_easy_setopt(curl, CURLOPT_TIMEOUT, timeout);
+	else
+	{
+		// a large file on a slow line: a stalled one ends instead
+		curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1024L);
+		curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, 30L);
+	}
+	curl_easy_setopt(curl, CURLOPT_WRITEDATA, &ctx);
+	curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, +[](char *data, size_t size, size_t n, void *user) -> size_t {
+		Context *c = (Context *)user;
+		return (*c->sink)(data, size * n) ? size * n : 0;
+	});
+	if (progress)
+	{
+		curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+		curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &ctx);
+		curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, +[](void *user, curl_off_t total, curl_off_t done, curl_off_t, curl_off_t) -> int {
+			Context *c = (Context *)user;
+			return (*c->progress)((uint64_t)done, (uint64_t)total) ? 0 : 1;
+		});
+	}
+	const CURLcode r = curl_easy_perform(curl);
+	long status = 0;
+	curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status);
+	if (r != CURLE_OK)
+	{
+		error = curlError[0] ? curlError : curl_easy_strerror(r);
+		status = 0;
+	}
+	curl_slist_free_all(headers);
+	curl_easy_cleanup(curl);
+	return status;
+}
+
+std::string hex(const unsigned char *data, size_t size)
+{
+	static const char digits[] = "0123456789abcdef";
+	std::string s;
+	for (size_t i = 0; i < size; i++)
+	{
+		s += digits[data[i] >> 4];
+		s += digits[data[i] & 15];
+	}
+	return s;
+}
+
+// Downloads url to path (through path.part), checking its size and SHA-256
+std::string download(const std::string& url, uint64_t size, const std::string& sha256, const std::string& path,
+		const std::function<bool(uint64_t, uint64_t)>& progress)
+{
+	const std::string part = path + ".part";
+	FILE *f = fopen(part.c_str(), "wb");
+	if (f == nullptr)
+		return "can't write " + part;
+	SHA256_CTX sha;
+	SHA256_Init(&sha);
+	uint64_t written = 0;
+	bool writeFailed = false;
+	std::string error;
+	const long status = get(url,
+		[&](const char *data, size_t n) {
+			if (fwrite(data, 1, n, f) != n) {
+				writeFailed = true;
+				return false;
+			}
+			SHA256_Update(&sha, data, n);
+			written += n;
+			return true;
+		},
+		[&](uint64_t done, uint64_t total) { return progress(done, total ? total : size); },
+		0, error);
+	fclose(f);
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	SHA256_Final(digest, &sha);
+	if (writeFailed)
+		error = "couldn't write the download (is the PS4's storage full?)";
+	else if (status != 200 && error.empty())
+		error = "GitHub answered " + std::to_string(status);
+	else if (status == 200 && written != size)
+		error = "the download is incomplete";
+	else if (status == 200 && hex(digest, sizeof(digest)) != sha256)
+		error = "the download doesn't match GitHub's checksum";
+	if (!error.empty())
+	{
+		remove(part.c_str());
+		log("download failed: " + error);
+		return error;
+	}
+	remove(path.c_str());
+	if (rename(part.c_str(), path.c_str()) != 0)
+	{
+		remove(part.c_str());
+		return "can't rename " + part;
+	}
+	log("downloaded " + path + " (" + std::to_string(written) + " bytes, checksum OK)");
+	return "";
+}
+
+// A ustar archive (plain files and folders) into dir
+std::string extractTar(const std::string& tar, const std::string& dir)
+{
+	FILE *in = fopen(tar.c_str(), "rb");
+	if (in == nullptr)
+		return "can't open " + tar;
+	std::vector<char> buffer(1 << 20);
+	std::string error;
+	int files = 0;
+	for (;;)
+	{
+		unsigned char header[512];
+		if (fread(header, 1, sizeof(header), in) != sizeof(header))
+		{
+			error = "the archive is cut short";
+			break;
+		}
+		if (std::all_of(header, header + sizeof(header), [](unsigned char c) { return c == 0; }))
+			break;
+		auto field = [&](size_t at, size_t length) {
+			const char *begin = (const char *)header + at;
+			return std::string(begin, strnlen(begin, length));
+		};
+		std::string name = field(0, 100);
+		const std::string prefix = field(345, 155);
+		if (!prefix.empty())
+			name = prefix + "/" + name;
+		const uint64_t size = strtoull(field(124, 12).c_str(), nullptr, 8);
+		const char type = (char)header[156];
+		while (name.rfind("./", 0) == 0)
+			name.erase(0, 2);
+		while (!name.empty() && name.back() == '/')
+			name.pop_back();
+		if (name.empty())
+			continue;
+		if (name[0] == '/' || name.find("..") != std::string::npos)
+		{
+			error = "the archive has an unsafe path: " + name;
+			break;
+		}
+		const std::string path = dir + "/" + name;
+		if (type == '5')
+		{
+			makeDirs(path);
+			continue;
+		}
+		if (type != '0' && type != '\0')
+		{
+			fseek(in, (long)((size + 511) / 512 * 512), SEEK_CUR);
+			continue;
+		}
+		makeDirs(path.substr(0, path.find_last_of('/')));
+		FILE *out = fopen(path.c_str(), "wb");
+		if (out == nullptr)
+		{
+			error = "can't write " + path;
+			break;
+		}
+		uint64_t left = size;
+		while (left > 0 && error.empty())
+		{
+			const size_t chunk = (size_t)std::min<uint64_t>(left, buffer.size());
+			if (fread(buffer.data(), 1, chunk, in) != chunk || fwrite(buffer.data(), 1, chunk, out) != chunk)
+				error = "can't unpack " + name;
+			left -= chunk;
+		}
+		fclose(out);
+		if (!error.empty())
+			break;
+		files++;
+		const uint64_t padding = (512 - size % 512) % 512;
+		if (padding)
+			fseek(in, (long)padding, SEEK_CUR);
+	}
+	fclose(in);
+	if (error.empty())
+		log("unpacked " + std::to_string(files) + " files into " + dir);
+	return error;
+}
+} // namespace
+
+const char *ps4_app_dir()
+{
+	return gRunningUpdate ? kUpdateDir.c_str() : "/app0";
+}
+
+std::string ps4_app_version()
+{
+	static std::string version;
+	if (version.empty())
+	{
+		version = firstLine(std::string(ps4_app_dir()) + "/version.txt");
+		if (version.empty())
+			version = "00.00";
+	}
+	return version;
+}
+
+long ps4_http_get(const std::string& url, std::string& body, std::string& error)
+{
+	body.clear();
+	return get(url, [&body](const char *data, size_t n) {
+		body.append(data, n);
+		return body.size() < 16 * 1024 * 1024;
+	}, {}, 60, error);
+}
+
+namespace updater
+{
+
+int compareVersions(const std::string& a, const std::string& b)
+{
+	auto parts = [](const std::string& text) {
+		std::vector<long> n;
+		for (size_t i = 0; i < text.size();)
+		{
+			if (isdigit((unsigned char)text[i]))
+			{
+				char *end = nullptr;
+				n.push_back(strtol(text.c_str() + i, &end, 10));
+				i = (size_t)(end - text.c_str());
+			}
+			else
+				i++;
+		}
+		return n;
+	};
+	const std::vector<long> x = parts(a), y = parts(b);
+	for (size_t i = 0; i < std::max(x.size(), y.size()); i++)
+	{
+		const long p = i < x.size() ? x[i] : 0, q = i < y.size() ? y[i] : 0;
+		if (p != q)
+			return p < q ? -1 : 1;
+	}
+	return 0;
+}
+
+Release checkLatest()
+{
+	Release release;
+	std::string body, error;
+	const long status = get(kLatest, [&body](const char *data, size_t n) {
+		body.append(data, n);
+		return body.size() < 4 * 1024 * 1024;
+	}, {}, 30, error);
+	if (status == 404)
+	{
+		release.error = "no releases yet";
+		log("check: no releases yet");
+		return release;
+	}
+	if (status != 200)
+	{
+		release.error = status == 0 ? error : "GitHub answered " + std::to_string(status);
+		log("check failed: " + release.error);
+		return release;
+	}
+	try {
+		const nlohmann::json root = nlohmann::json::parse(body);
+		std::string tag = root.value("tag_name", "");
+		if (!tag.empty() && (tag[0] == 'v' || tag[0] == 'V'))
+			tag.erase(0, 1);
+		release.version = tag;
+		release.title = root.value("name", "");
+		for (const auto& asset : root.value("assets", nlohmann::json::array()))
+		{
+			const std::string name = asset.value("name", "");
+			const uint64_t size = asset.value("size", (uint64_t)0);
+			const std::string digest = asset.value("digest", "");
+			const std::string sha = digest.rfind("sha256:", 0) == 0 ? lower(digest.substr(7)) : "";
+			const std::string url = asset.value("browser_download_url", "");
+			if (endsWith(lower(name), "-update.tar") && release.archiveUrl.empty())
+			{
+				release.archive = name;
+				release.archiveUrl = url;
+				release.archiveSize = size;
+				release.archiveSha256 = sha;
+			}
+			else if (endsWith(lower(name), ".pkg") && release.url.empty())
+			{
+				release.package = name;
+				release.url = url;
+				release.size = size;
+				release.sha256 = sha;
+			}
+		}
+	} catch (const std::exception& e) {
+		release.error = "unexpected answer from GitHub";
+		log("check failed: " + release.error + " (" + e.what() + ")");
+		return release;
+	}
+	if (release.archiveSha256.size() != 64)
+		release.archiveUrl.clear();	// unchecked: the package instead
+	if (release.version.empty() || (release.url.empty() && release.archiveUrl.empty()))
+		release.error = "the latest release has nothing to install";
+	else if (release.archiveUrl.empty() && release.sha256.size() != 64)
+		release.error = "the latest release has no checksum";
+	else
+		release.ok = true;
+	log("latest release " + release.version + (release.ok ? "" : ": " + release.error));
+	return release;
+}
+
+std::string install(const Release& release, const std::function<bool(uint64_t, uint64_t)>& progress, bool *needsInstaller)
+{
+	*needsInstaller = false;
+	if (!release.archiveUrl.empty())
+	{
+		const std::string tar = kData + "/" + release.archive;
+		std::string error = download(release.archiveUrl, release.archiveSize, release.archiveSha256, tar, progress);
+		if (!error.empty())
+			return error;
+		// unpacked next to the current one, then swapped in
+		const std::string fresh = kUpdateDir + ".new";
+		removeTree(fresh);
+		makeDirs(fresh);
+		error = extractTar(tar, fresh);
+		remove(tar.c_str());
+		if (error.empty() && firstLine(fresh + "/version.txt") != release.version)
+			error = "the update archive doesn't hold version " + release.version;
+		if (!error.empty())
+		{
+			removeTree(fresh);
+			return error;
+		}
+		if (!gRunningUpdate)
+			removeTree(kUpdateDir);
+		else
+			removeTree(kUpdateDir + ".old");	// still running from it: moved aside, gone next start
+		if (gRunningUpdate)
+			rename(kUpdateDir.c_str(), (kUpdateDir + ".old").c_str());
+		if (rename(fresh.c_str(), kUpdateDir.c_str()) != 0)
+			return "can't move the update into place";
+		remove(kPending.c_str());
+		removeTree(kFailed);
+		log("v" + release.version + " ready: it starts next time");
+		return "";
+	}
+	*needsInstaller = true;
+	mkdir("/data/pkg", 0777);
+	return download(release.url, release.size, release.sha256, "/data/pkg/" + release.package, progress);
+}
+
+void startDownloadedUpdate(int argc, char *argv[])
+{
+	for (int i = 1; i < argc; i++)
+		if (argv[i] != nullptr && !strcmp(argv[i], kRunningUpdate))
+		{
+			gRunningUpdate = true;
+			remove(kPending.c_str());	// it started
+			removeTree(kUpdateDir + ".old");
+			log("running the downloaded update v" + ps4_app_version() + " (installed: v" + firstLine("/app0/version.txt") + ")");
+			return;
+		}
+	removeTree(kUpdateDir + ".old");
+	const std::string update = firstLine(kUpdateDir + "/version.txt");
+	if (update.empty())
+		return;
+	const std::string installed = firstLine("/app0/version.txt");
+	if (compareVersions(update, installed) <= 0)
+	{
+		removeTree(kUpdateDir);
+		remove(kPending.c_str());
+		log("removed the downloaded v" + update + ": the installed v" + installed + " is as new");
+		return;
+	}
+	if (FILE *pending = fopen(kPending.c_str(), "r"))
+	{
+		// started last time and never said so: set aside, the installed one runs
+		fclose(pending);
+		remove(kPending.c_str());
+		removeTree(kFailed);
+		rename(kUpdateDir.c_str(), kFailed.c_str());
+		log("the downloaded v" + update + " didn't start last time: set aside in " + kFailed);
+		return;
+	}
+	if (FILE *pending = fopen(kPending.c_str(), "w"))
+	{
+		fprintf(pending, "%s\n", update.c_str());
+		fclose(pending);
+	}
+	log("starting the downloaded v" + update + " (installed: v" + installed + ")");
+	const std::string eboot = kUpdateDir + "/eboot.bin";
+	const char *args[] = { kRunningUpdate, nullptr };
+	const int r = sceSystemServiceLoadExec(eboot.c_str(), args);
+	// still here: it couldn't be started
+	remove(kPending.c_str());
+	removeTree(kFailed);
+	rename(kUpdateDir.c_str(), kFailed.c_str());
+	char line[200];
+	snprintf(line, sizeof(line), "sceSystemServiceLoadExec(%s) failed (%x): the installed version runs", eboot.c_str(), (unsigned)r);
+	log(line);
+}
+
+} // namespace updater
