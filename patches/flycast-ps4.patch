+#ifdef __ORBIS__
+// Resonance launcher (shell/ps4/launcher): the library as the scanner and box-art database see it
+// "Name (Disc 2)", "Name [Disc 2 of 3]", "Name - Disc 2", "Name CD2": 2, and the name without it;
+// 0 when there is no disc number
+static int ps4DiscNumber(const std::string& name, std::string& base)
+{
+	std::string lower = name;
+	for (char& c : lower)
+		c = (char)tolower((unsigned char)c);
+	for (const char *word : { "disc", "disk", "cd" })
+	{
+		size_t at = 0;
+		while ((at = lower.find(word, at)) != std::string::npos)
+		{
+			const size_t start = at;
+			at += strlen(word);
+			if (start > 0 && isalnum((unsigned char)lower[start - 1]))
+				continue;
+			size_t p = at;
+			while (p < lower.size() && (lower[p] == ' ' || lower[p] == '_' || lower[p] == '-'))
+				p++;
+			if (p >= lower.size() || !isdigit((unsigned char)lower[p]))
+				continue;
+			int n = 0;
+			while (p < lower.size() && isdigit((unsigned char)lower[p]))
+				n = n * 10 + (lower[p++] - '0');
+			if (n < 1 || n > 9)
+				continue;
+			// " of 3"
+			if (lower.compare(p, 4, " of ") == 0)
+			{
+				size_t q = p + 4;
+				while (q < lower.size() && isdigit((unsigned char)lower[q]))
+					q++;
+				p = q;
+			}
+			size_t from = start, to = p;
+			if (from > 0 && (lower[from - 1] == '(' || lower[from - 1] == '[') && to < lower.size() && (lower[to] == ')' || lower[to] == ']'))
+			{
+				from--;
+				to++;
+			}
+			base = name.substr(0, from) + name.substr(to);
+			// spaces and dashes left at the join or the ends
+			while (!base.empty() && (base.back() == ' ' || base.back() == '-' || base.back() == '_'))
+				base.pop_back();
+			size_t b = 0;
+			while (b < base.size() && base[b] == ' ')
+				b++;
+			base.erase(0, b);
+			for (size_t d; (d = base.find("  ")) != std::string::npos; )
+				base.erase(d, 1);
+			if (base.empty())
+				continue;
+			return n;
+		}
+	}
+	return 0;
+}
+
+void gui_ps4_list_games(std::vector<LauncherEntry>& out)
+{
+	out.clear();
+	scanner.fetch_game_list();
+	std::lock_guard<std::mutex> _(scanner.get_mutex());
+	for (const auto& game : scanner.get_game_list())
+	{
+		if (game.path.empty() || game.device)
+			continue;	// the BIOS entry, CD drives
+		GameBoxart art = boxart.getBoxartAndLoad(game);
+		LauncherEntry e;
+		e.path = game.path;
+		e.fileName = game.fileName;
+		e.title = art.name.empty() || art.name == game.fileName ? game.name : art.name;
+		e.productId = art.uniqueId;
+		e.region = art.region;
+		e.coverPath = art.boxartPath;
+		out.push_back(std::move(e));
+	}
+	// A .cue beside the same disc's .gdi or .chd (the same file name, or the same title elsewhere in
+	// the library) is a second entry for one game: hidden. Other games in its folder don't count.
+	auto isCue = [](const LauncherEntry& e) {
+		const std::string& n = e.path;
+		return n.size() > 4 && strcasecmp(n.c_str() + n.size() - 4, ".cue") == 0;
+	};
+	// the path without its extension, lower case
+	auto stem = [](const std::string& path) {
+		std::string s = path.substr(0, path.find_last_of('.') == std::string::npos ? path.size() : path.find_last_of('.'));
+		for (char& c : s)
+			c = (char)tolower((unsigned char)c);
+		return s;
+	};
+	std::vector<LauncherEntry> kept;
+	for (const LauncherEntry& e : out)
+	{
+		bool duplicate = false;
+		if (isCue(e))
+			for (const LauncherEntry& other : out)
+				if (&other != &e && !isCue(other) && (stem(other.path) == stem(e.path) || other.title == e.title))
+				{
+					duplicate = true;
+					break;
+				}
+		if (!duplicate)
+			kept.push_back(e);
+	}
+	out = std::move(kept);
+
+	// Games on several discs ("Shenmue II (Disc 1)", "... (Disc 2)") become one entry that starts
+	// with disc 1; the quick menu changes discs
+	std::map<std::string, std::vector<std::pair<int, size_t>>> sets;
+	std::vector<std::string> bases(out.size());
+	for (size_t i = 0; i < out.size(); i++)
+	{
+		std::string stem = out[i].fileName;
+		const size_t dot = stem.find_last_of('.');
+		if (dot != std::string::npos)
+			stem.resize(dot);
+		std::string base;
+		int disc = ps4DiscNumber(stem, base);
+		if (disc == 0)
+			disc = ps4DiscNumber(out[i].title, base);
+		if (disc == 0)
+			continue;
+		for (char& c : base)
+			c = (char)tolower((unsigned char)c);
+		sets[base].emplace_back(disc, i);
+	}
+	std::vector<bool> drop(out.size(), false);
+	for (auto& [base, discs] : sets)
+	{
+		if (discs.size() < 2)
+			continue;
+		std::sort(discs.begin(), discs.end());
+		LauncherEntry& first = out[discs[0].second];
+		std::string title;
+		if (ps4DiscNumber(first.title, title) != 0)
+			first.title = title;
+		for (const auto& [n, i] : discs)
+		{
+			first.discs.push_back(out[i].path);
+			if (first.coverPath.empty())
+				first.coverPath = out[i].coverPath;
+			if (i != discs[0].second)
+				drop[i] = true;
+		}
+	}
+	kept.clear();
+	for (size_t i = 0; i < out.size(); i++)
+		if (!drop[i])
+			kept.push_back(std::move(out[i]));
+	out = std::move(kept);
+}
