+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <string>
+
+// Where the running program's files are: "/app0", or the downloaded update's folder
+const char *ps4_app_dir();
+// The running version ("01.18")
+std::string ps4_app_version();
+// An HTTPS GET into body (GitHub-friendly headers, the bundled CA list). HTTP status, or 0 with error
+long ps4_http_get(const std::string& url, std::string& body, std::string& error);
+
+namespace updater
+{
+
+struct Release
+{
+	bool ok = false;
+	std::string error;
+	std::string version;		// "01.18" (the tag without its "v")
+	std::string title;
+	std::string package, url, sha256;
+	uint64_t size = 0;
+	std::string archive, archiveUrl, archiveSha256;
+	uint64_t archiveSize = 0;
+};
+
+// The latest release on GitHub (blocks: call off the UI thread)
+Release checkLatest();
+// <0 when a is older than b
+int compareVersions(const std::string& a, const std::string& b);
+// Downloads and installs the release: the archive into the update folder (the next start runs it),
+// or the package into /data/pkg. progress(done, total) may return false to cancel.
+// "" when done; else what went wrong. *needsInstaller: the package route was taken
+std::string install(const Release& release, const std::function<bool(uint64_t, uint64_t)>& progress, bool *needsInstaller);
+
+// At the very start of main(): run the downloaded update if it is newer than the installed app
+// (doesn't return then), or tidy it away
+void startDownloadedUpdate(int argc, char *argv[]);
+
+}
