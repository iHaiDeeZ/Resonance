+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "i18n.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+#include <cstdint>
+#include <vector>
+
+namespace i18n
+{
+namespace
+{
+
+struct Forms { char32_t letter, isolated, final, initial, medial; };	// 0: no such form
+
+// Arabic letters (and the Persian ones Arabic text meets) with their presentation forms
+const Forms kForms[] = {
+	{ 0x0621, 0xFE80, 0, 0, 0 },
+	{ 0x0622, 0xFE81, 0xFE82, 0, 0 }, { 0x0623, 0xFE83, 0xFE84, 0, 0 }, { 0x0624, 0xFE85, 0xFE86, 0, 0 },
+	{ 0x0625, 0xFE87, 0xFE88, 0, 0 }, { 0x0626, 0xFE89, 0xFE8A, 0xFE8B, 0xFE8C }, { 0x0627, 0xFE8D, 0xFE8E, 0, 0 },
+	{ 0x0628, 0xFE8F, 0xFE90, 0xFE91, 0xFE92 }, { 0x0629, 0xFE93, 0xFE94, 0, 0 }, { 0x062A, 0xFE95, 0xFE96, 0xFE97, 0xFE98 },
+	{ 0x062B, 0xFE99, 0xFE9A, 0xFE9B, 0xFE9C }, { 0x062C, 0xFE9D, 0xFE9E, 0xFE9F, 0xFEA0 }, { 0x062D, 0xFEA1, 0xFEA2, 0xFEA3, 0xFEA4 },
+	{ 0x062E, 0xFEA5, 0xFEA6, 0xFEA7, 0xFEA8 }, { 0x062F, 0xFEA9, 0xFEAA, 0, 0 }, { 0x0630, 0xFEAB, 0xFEAC, 0, 0 },
+	{ 0x0631, 0xFEAD, 0xFEAE, 0, 0 }, { 0x0632, 0xFEAF, 0xFEB0, 0, 0 }, { 0x0633, 0xFEB1, 0xFEB2, 0xFEB3, 0xFEB4 },
+	{ 0x0634, 0xFEB5, 0xFEB6, 0xFEB7, 0xFEB8 }, { 0x0635, 0xFEB9, 0xFEBA, 0xFEBB, 0xFEBC }, { 0x0636, 0xFEBD, 0xFEBE, 0xFEBF, 0xFEC0 },
+	{ 0x0637, 0xFEC1, 0xFEC2, 0xFEC3, 0xFEC4 }, { 0x0638, 0xFEC5, 0xFEC6, 0xFEC7, 0xFEC8 }, { 0x0639, 0xFEC9, 0xFECA, 0xFECB, 0xFECC },
+	{ 0x063A, 0xFECD, 0xFECE, 0xFECF, 0xFED0 }, { 0x0640, 0x0640, 0x0640, 0x0640, 0x0640 },
+	{ 0x0641, 0xFED1, 0xFED2, 0xFED3, 0xFED4 }, { 0x0642, 0xFED5, 0xFED6, 0xFED7, 0xFED8 }, { 0x0643, 0xFED9, 0xFEDA, 0xFEDB, 0xFEDC },
+	{ 0x0644, 0xFEDD, 0xFEDE, 0xFEDF, 0xFEE0 }, { 0x0645, 0xFEE1, 0xFEE2, 0xFEE3, 0xFEE4 }, { 0x0646, 0xFEE5, 0xFEE6, 0xFEE7, 0xFEE8 },
+	{ 0x0647, 0xFEE9, 0xFEEA, 0xFEEB, 0xFEEC }, { 0x0648, 0xFEED, 0xFEEE, 0, 0 }, { 0x0649, 0xFEEF, 0xFEF0, 0, 0 },
+	{ 0x064A, 0xFEF1, 0xFEF2, 0xFEF3, 0xFEF4 },
+	{ 0x067E, 0xFB56, 0xFB57, 0xFB58, 0xFB59 }, { 0x0686, 0xFB7A, 0xFB7B, 0xFB7C, 0xFB7D }, { 0x0698, 0xFB8A, 0xFB8B, 0, 0 },
+	{ 0x06A9, 0xFB8E, 0xFB8F, 0xFB90, 0xFB91 }, { 0x06AF, 0xFB92, 0xFB93, 0xFB94, 0xFB95 }, { 0x06CC, 0xFBFC, 0xFBFD, 0xFBFE, 0xFBFF },
+};
+
+const Forms *formsOf(char32_t c)
+{
+	for (const Forms& f : kForms)
+		if (f.letter == c)
+			return &f;
+	return nullptr;
+}
+
+// Vowel marks: dropped (ImGui would put them beside the letter, not above it)
+bool isMark(char32_t c) {
+	return (c >= 0x064B && c <= 0x065F) || c == 0x0670;
+}
+
+bool joinsBothSides(const Forms *f) {
+	return f != nullptr && f->initial != 0;
+}
+
+bool joinsAtAll(const Forms *f) {
+	return f != nullptr && f->final != 0;
+}
+
+std::vector<char32_t> decode(const std::string& s)
+{
+	std::vector<char32_t> out;
+	for (size_t i = 0; i < s.size();)
+	{
+		const unsigned char c = s[i];
+		char32_t cp;
+		int len;
+		if (c < 0x80) { cp = c; len = 1; }
+		else if ((c >> 5) == 6) { cp = c & 0x1F; len = 2; }
+		else if ((c >> 4) == 14) { cp = c & 0x0F; len = 3; }
+		else { cp = c & 0x07; len = 4; }
+		for (int k = 1; k < len && i + k < s.size(); k++)
+			cp = (cp << 6) | (s[i + k] & 0x3F);
+		out.push_back(cp);
+		i += len;
+	}
+	return out;
+}
+
+void encode(char32_t cp, std::string& out)
+{
+	if (cp < 0x80)
+		out += (char)cp;
+	else if (cp < 0x800) {
+		out += (char)(0xC0 | (cp >> 6));
+		out += (char)(0x80 | (cp & 0x3F));
+	}
+	else if (cp < 0x10000) {
+		out += (char)(0xE0 | (cp >> 12));
+		out += (char)(0x80 | ((cp >> 6) & 0x3F));
+		out += (char)(0x80 | (cp & 0x3F));
+	}
+	else {
+		out += (char)(0xF0 | (cp >> 18));
+		out += (char)(0x80 | ((cp >> 12) & 0x3F));
+		out += (char)(0x80 | ((cp >> 6) & 0x3F));
+		out += (char)(0x80 | (cp & 0x3F));
+	}
+}
+
+// Contextual forms, in logical order
+std::vector<char32_t> shape(const std::vector<char32_t>& in)
+{
+	std::vector<char32_t> text;
+	for (char32_t c : in)
+		if (!isMark(c))
+			text.push_back(c);
+	std::vector<char32_t> out;
+	for (size_t i = 0; i < text.size(); i++)
+	{
+		const Forms *f = formsOf(text[i]);
+		if (f == nullptr)
+		{
+			out.push_back(text[i]);
+			continue;
+		}
+		const bool prev = i > 0 && joinsBothSides(formsOf(text[i - 1]));
+		// lam + alef: one ligature
+		if (text[i] == 0x0644 && i + 1 < text.size())
+		{
+			char32_t lig = 0;
+			switch (text[i + 1])
+			{
+			case 0x0622: lig = 0xFEF5; break;
+			case 0x0623: lig = 0xFEF7; break;
+			case 0x0625: lig = 0xFEF9; break;
+			case 0x0627: lig = 0xFEFB; break;
+			}
+			if (lig != 0)
+			{
+				out.push_back(prev ? lig + 1 : lig);
+				i++;
+				continue;
+			}
+		}
+		const bool next = i + 1 < text.size() && joinsAtAll(formsOf(text[i + 1])) && joinsBothSides(f);
+		if (prev && next && f->medial)
+			out.push_back(f->medial);
+		else if (prev && f->final)
+			out.push_back(f->final);
+		else if (next && f->initial)
+			out.push_back(f->initial);
+		else
+			out.push_back(f->isolated);
+	}
+	return out;
+}
+
+enum Dir { R, L, N };
+
+Dir dirOf(char32_t c)
+{
+	if ((c >= 0x0590 && c <= 0x08FF) || (c >= 0xFB1D && c <= 0xFDFF) || (c >= 0xFE70 && c <= 0xFEFF))
+		return (c >= 0x0660 && c <= 0x0669) ? L : R;	// Arabic-Indic digits run left to right
+	if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '%'
+			|| (c >= 0xC0 && c < 0x0590) || c >= 0x2C00)
+		return L;
+	return N;
+}
+
+char32_t mirror(char32_t c)
+{
+	switch (c)
+	{
+	case '(': return ')';
+	case ')': return '(';
+	case '[': return ']';
+	case ']': return '[';
+	case '{': return '}';
+	case '}': return '{';
+	case '<': return '>';
+	case '>': return '<';
+	case 0xAB: return 0xBB;
+	case 0xBB: return 0xAB;
+	default: return c;
+	}
+}
+
+// One right-to-left line in display order
+void visualLine(const std::vector<char32_t>& line, std::string& out)
+{
+	const size_t n = line.size();
+	std::vector<Dir> dir(n);
+	for (size_t i = 0; i < n; i++)
+		dir[i] = dirOf(line[i]);
+	// neutrals between two left-to-right characters go with them ("Noto Sans", "16:9"), the rest
+	// follow the line (right to left)
+	for (size_t i = 0; i < n;)
+	{
+		if (dir[i] != N) {
+			i++;
+			continue;
+		}
+		size_t j = i;
+		while (j < n && dir[j] == N)
+			j++;
+		const bool ltr = i > 0 && j < n && dir[i - 1] == L && dir[j] == L;
+		for (size_t k = i; k < j; k++)
+			dir[k] = ltr ? L : R;
+		// punctuation stuck to the front of Latin text belongs to it ("/data/...", "(PAL")
+		if (!ltr && j < n && dir[j] == L)
+			for (size_t k = j; k > i && line[k - 1] != ' '; k--)
+				dir[k - 1] = L;
+		i = j;
+	}
+	// runs from the end of the line to its start; right-to-left runs reversed and mirrored
+	size_t end = n;
+	while (end > 0)
+	{
+		size_t start = end;
+		while (start > 0 && dir[start - 1] == dir[end - 1])
+			start--;
+		if (dir[end - 1] == L)
+			for (size_t k = start; k < end; k++)
+				encode(line[k], out);
+		else
+			for (size_t k = end; k > start; k--)
+				encode(mirror(line[k - 1]), out);
+		end = start;
+	}
+}
+
+} // namespace
+
+bool hasRtl(const std::string& s)
+{
+	for (unsigned char c : s)
+		if (c >= 0xD6 && c <= 0xDF)	// lead bytes of U+0580..U+07FF
+			return true;
+	return s.find("\xEF\xAD") != std::string::npos || s.find("\xEF\xBB") != std::string::npos;
+}
+
+// printf placeholders numbered ("%d of %d" -> "%1$d of %2$d") when there are several: the
+// display order can put them the other way round
+static std::string numberPlaceholders(const std::string& s)
+{
+	auto specEnd = [&](size_t p) -> size_t {	// s[p] == '%': end of the conversion, or 0
+		size_t q = p + 1;
+		while (q < s.size() && strchr("-+#0123456789.hlzj", s[q]) != nullptr)
+			q++;
+		return q < s.size() && strchr("diouxXfFeEgGcsp", s[q]) != nullptr ? q + 1 : 0;
+	};
+	int count = 0;
+	for (size_t p = 0; p < s.size(); p++)
+		if (s[p] == '%')
+		{
+			if (p + 1 < s.size() && s[p + 1] == '%')
+				p++;
+			else if (specEnd(p) != 0)
+				count++;
+		}
+	if (count < 2)
+		return s;
+	std::string out;
+	int index = 0;
+	for (size_t p = 0; p < s.size(); p++)
+	{
+		out += s[p];
+		if (s[p] != '%')
+			continue;
+		if (p + 1 < s.size() && s[p + 1] == '%') {
+			out += s[++p];
+			continue;
+		}
+		if (specEnd(p) != 0)
+			out += std::to_string(++index) + "$";
+	}
+	return out;
+}
+
+std::string visualOrder(const std::string& logical)
+{
+	if (!hasRtl(logical))
+		return logical;
+	const std::vector<char32_t> text = shape(decode(numberPlaceholders(logical)));
+	std::string out;
+	out.reserve(logical.size() + 8);
+	std::vector<char32_t> line;
+	for (char32_t c : text)
+	{
+		if (c == '\n')
+		{
+			visualLine(line, out);
+			out += '\n';
+			line.clear();
+		}
+		else
+			line.push_back(c);
+	}
+	visualLine(line, out);
+	return out;
+}
+
+} // namespace i18n
