+			item.value = [] { return std::string(ICON_FA_FOLDER_OPEN); };
+			net.items.push_back(item);
+		}
+		Setting addNfs { T("Add NFS Share"), T("A folder exported by a NAS or a PC (WinNFSd, Linux NFS server)"), {}, [] { return 0; }, [](int) {} };
+		addNfs.action = [this] { addShare(false); };
+		addNfs.value = [] { return std::string(ICON_FA_PLUS); };
+		net.items.push_back(addNfs);
+		Setting addSmb { T("Add SMB Share"), T("A shared Windows folder, or Samba on a NAS"), {}, [] { return 0; }, [](int) {} };
+		addSmb.action = [this] { addShare(true); };
+		addSmb.value = [] { return std::string(ICON_FA_PLUS); };
+		net.items.push_back(addSmb);
+		return net;
+	}
+
+	int current(const Setting& s) const
+	{
+		const int v = s.get();
+		for (int i = 0; i < (int)s.choices.size(); i++)
+			if (s.choices[i].value == v)
+				return i;
+		return -1;
+	}
+	std::string valueText(const Setting& s) const
+	{
+		if (s.value)
+			return s.value();
+		const int i = current(s);
+		return i >= 0 ? s.choices[i].label : std::to_string(s.get());
+	}
+	bool locked(const Setting& s) const {
+		return s.lockedInGame && gui_ps4_game_running();
+	}
+};
+
+SettingsPanel::SettingsPanel() : impl(std::make_unique<Impl>()) {
+	impl->build();
+}
+SettingsPanel::~SettingsPanel() = default;
+
+int SettingsPanel::groupCount() const {
+	return (int)impl->groups.size();
+}
+const char *SettingsPanel::groupIcon(int g) const {
+	return impl->groups[g].icon;
+}
+std::string SettingsPanel::groupName(int g) const {
+	return impl->groups[g].name;
+}
+std::string SettingsPanel::groupSummary(int g) const {
+	return impl->groups[g].summary;
+}
+bool SettingsPanel::isOpen() const {
+	return impl->open;
+}
+
+void SettingsPanel::openGroup(int g, float t)
+{
+	impl->build();	// labels in the current language, values as they are now
+	impl->open = true;
+	impl->group = std::clamp(g, 0, groupCount() - 1);
+	impl->sel = 0;
+	impl->selPos = 0;
+	impl->selVel = 0;
+	impl->dropOpen = false;
+	impl->openedAt = t;
+	playSound(Sound::Confirm);
+}
+
+void SettingsPanel::close()
+{
+	Impl& m = *impl;
+	m.open = false;
+	m.dropOpen = false;
+	if (m.changed)
+	{
+		gui_ps4_apply_settings(m.mapleChanged, m.expansionChanged);
+		m.changed = false;
+		for (int i = 0; i < 4; i++)
+			m.mapleChanged[i] = m.expansionChanged[i][0] = m.expansionChanged[i][1] = false;
+	}
+	playSound(Sound::Back);
+}
+
+void SettingsPanel::input(const MenuInput& in, float t)
+{
+	Impl& m = *impl;
+	m.now = t;
+	keyboardUpdate();
+	m.pollTest();
+	m.pollUpdate();
+	if (!m.open || keyboardOpen())
+		return;
+	if (vmuViewerActive())
+	{
+		if (!vmuViewerInput(in, t))
+		{
+			// back from the viewer: the cards' free space again
+			const int g = m.group, s = m.sel;
+			m.build();
+			m.group = g;
+			m.sel = s;
+		}
+		return;
+	}
+	std::vector<Setting>& items = m.groups[m.group].items;
+	if (m.dropOpen)
+	{
+		Setting& s = items[m.sel];
+		const int n = (int)s.choices.size();
+		if (in.dy != 0)
+		{
+			const int next = std::clamp(m.dropSel + in.dy, 0, n - 1);
+			if (next != m.dropSel)
+			{
+				m.dropSel = next;
+				playSound(Sound::Move);
+			}
+		}
+		if (in.cross)
+		{
+			if (m.current(s) != m.dropSel)
+			{
+				s.set(s.choices[m.dropSel].value);
+				m.changed = true;
+			}
+			m.dropOpen = false;
+			playSound(Sound::Confirm);
+			if (m.rebuildPending)
+			{
+				// the menu language changed: the labels again, same place
+				m.rebuildPending = false;
+				const int g = m.group, sel = m.sel;
+				m.build();
+				m.group = g;
+				m.sel = sel;
+			}
+		}
+		else if (in.circle || in.dx < 0)
+		{
+			m.dropOpen = false;
+			playSound(Sound::Back);
+		}
+		return;
+	}
+	const int n = (int)items.size();
+	if (in.dy != 0)
+	{
+		const int next = std::clamp(m.sel + in.dy, 0, n - 1);
+		if (next != m.sel)
+		{
+			m.sel = next;
+			playSound(Sound::Move);
+		}
+	}
+	if (in.l1 || in.r1)
+	{
+		m.sel = in.l1 ? 0 : n - 1;
+		playSound(Sound::Move);
+	}
+	if (in.cross || in.dx > 0)
+	{
+		Setting& s = items[m.sel];
+		if (s.action)
+		{
+			if (in.cross)
+			{
+				playSound(Sound::Confirm);
+				s.action();
+			}
+		}
+		else if (m.locked(s))
+			playSound(Sound::Error);
+		else
+		{
+			m.dropOpen = true;
+			m.dropSel = std::max(0, m.current(s));
+			m.dropPos = (float)m.dropSel;
+			m.dropVel = 0;
+			m.dropAt = t;
+			playSound(Sound::Confirm);
+		}
+	}
+	else if (in.circle || in.dx < 0)
+		close();
+}
+
+void SettingsPanel::draw(Frame& f, float alpha)
+{
+	Impl& m = *impl;
+	if (!m.open || alpha <= 0)
+		return;
+	if (vmuViewerActive())
+	{
+		vmuViewerDraw(f, alpha);
+		return;
+	}
+	ImDrawList *dl = f.dl;
+	const Group& g = m.groups[m.group];
+	const float in = easeOut((f.t - m.openedAt) / .3f) * alpha;
+	spring(m.selPos, m.selVel, (float)m.sel, 160.f, 26.f, f.dt);
+
+	// the group, top left (under the logo)
+	const float hs = f.h * .034f;
+	xmbText(dl, bodyFont(), hs * 1.2f, ImVec2(f.w * .07f, f.h * .125f), in, g.icon);
+	xmbText(dl, bodyFont(), hs, ImVec2(f.w * .07f + hs * 1.9f, f.h * .125f + hs * .1f), in, g.name);
+
+	// the options: the selected one stays near the upper third, the list scrolls under it
+	const float x0 = f.w * .12f + (1 - in) * f.w * .04f, x1 = f.w * .88f;
+	const float rowH = f.h * .062f, top = f.h * .22f, bottom = f.h * .83f;
+	const int rows = (int)((bottom - top) / rowH);
+	const int n = (int)g.items.size();
+	float scroll = std::clamp(m.selPos - rows * .35f, 0.f, std::max(0.f, (float)n - rows));
+	const float ts = f.h * .028f;
+	for (int i = 0; i < n; i++)
+	{
+		const float y = top + (i - scroll) * rowH;
+		if (y < top - rowH * .5f || y > bottom)
+			continue;
+		const float edge = clamp01(std::min((y - top + rowH) / rowH, (bottom - y) / rowH));
+		const Setting& s = g.items[i];
+		const bool sel = i == m.sel;
+		const bool lock = m.locked(s);
+		const float a = in * edge * (lock ? .4f : 1.f);
+		if (sel)
+		{
+			// the PS3's highlight: a soft lit band with fine lines
+			const ImU32 band = IM_COL32(255, 255, 255, (int)(34 * in)), clear = IM_COL32(255, 255, 255, 0);
+			dl->AddRectFilledMultiColor(ImVec2(x0 - f.w * .02f, y), ImVec2(x1 + f.w * .02f, y + rowH), clear, band, band, clear);
+			dl->AddLine(ImVec2(x0, y), ImVec2(x1, y), IM_COL32(255, 255, 255, (int)(60 * in)), 1.f);
+			dl->AddLine(ImVec2(x0, y + rowH), ImVec2(x1, y + rowH), IM_COL32(255, 255, 255, (int)(60 * in)), 1.f);
+		}
+		const float ty = y + (rowH - ts) * .5f;
+		xmbText(dl, bodyFont(), ts * (sel ? 1.06f : 1.f), ImVec2(x0, ty), a, s.name, 0, (x1 - x0) * .55f);
+		xmbText(dl, bodyFont(), ts * .95f, ImVec2(x1, ty), a * (sel ? 1.f : .75f), m.valueText(s), 1.f, (x1 - x0) * .4f,
+				sel ? IM_COL32(255, 255, 255, 255) : IM_COL32(210, 220, 235, 255));
+	}
+	// scroll marks
+	if (scroll > .05f)
+		xmbText(dl, bodyFont(), ts, ImVec2(f.w * .5f, top - rowH * .9f), in * .7f, ICON_FA_CHEVRON_UP, .5f);
+	if (scroll < n - rows - .05f)
+		xmbText(dl, bodyFont(), ts, ImVec2(f.w * .5f, bottom + rowH * .1f), in * .7f, ICON_FA_CHEVRON_DOWN, .5f);
+
+	// what the selected option does
+	const Setting& cur = g.items[m.sel];
+	std::string help = cur.help;
+	const size_t nl = help.find('\n');
+	if (nl != std::string::npos)
+		help = help.substr(0, nl);
+	if (!m.status.empty() && (f.t - m.statusAt < 8.f || m.testing.valid() || m.installing.valid() || m.checking.valid()))
+	{
+		const ImU32 col = m.statusBad ? IM_COL32(255, 150, 140, 255) : IM_COL32(170, 240, 190, 255);
+		xmbText(dl, bodyFont(), f.h * .024f, ImVec2(f.w * .07f, f.h * .875f), in, m.status, 0, f.w * .86f, col);
+	}
+	else
+		xmbText(dl, bodyFont(), f.h * .022f, ImVec2(f.w * .07f, f.h * .875f), in * .85f, help, 0, f.w * .86f, IM_COL32(220, 228, 240, 255));
+
+	// the drop-down list beside the value
+	if (m.dropOpen)
+	{
+		spring(m.dropPos, m.dropVel, (float)m.dropSel, 180.f, 27.f, f.dt);
+		const float da = easeOut((f.t - m.dropAt) / .18f) * alpha;
+		const int cn = (int)cur.choices.size();
+		const float ch = f.h * .052f, cs = f.h * .026f;
+		float w = f.w * .16f;
+		for (const Choice& c : cur.choices)
+			w = std::max(w, textWidth(bodyFont(), cs, c.label) + cs * 3.f);
+		w = std::min(w, f.w * .4f);
+		const int show = std::min(cn, 9);
+		const float rowY = top + (m.selPos - scroll) * rowH + rowH * .5f;
+		const float panelH = show * ch + ch * .4f;
+		float py = rowY - panelH * .5f;
+		py = std::clamp(py, f.h * .1f, f.h * .86f - panelH);
+		const float px = x1 - w + f.w * .01f;
+		dl->AddRectFilled(ImVec2(px + 6, py + 8), ImVec2(px + w + 6, py + panelH + 8), IM_COL32(0, 0, 0, (int)(90 * da)), ch * .2f);
+		dl->AddRectFilled(ImVec2(px, py), ImVec2(px + w, py + panelH), IM_COL32(12, 16, 26, (int)(225 * da)), ch * .2f);
+		dl->AddRect(ImVec2(px, py), ImVec2(px + w, py + panelH), IM_COL32(255, 255, 255, (int)(70 * da)), ch * .2f, 0, 1.5f);
+		const float first = std::clamp(m.dropPos - show * .5f + .5f, 0.f, (float)std::max(0, cn - show));
+		dl->PushClipRect(ImVec2(px, py + 2), ImVec2(px + w, py + panelH - 2), true);
+		const int curIdx = m.current(cur);
+		for (int i = 0; i < cn; i++)
+		{
+			const float y = py + ch * .2f + (i - first) * ch;
+			if (y < py - ch || y > py + panelH)
+				continue;
+			if (i == m.dropSel)
+			{
+				dl->AddRectFilled(ImVec2(px + 4, y), ImVec2(px + w - 4, y + ch), xmbTone().u32(.55f * da), ch * .15f);
+				dl->AddRect(ImVec2(px + 4, y), ImVec2(px + w - 4, y + ch), IM_COL32(255, 255, 255, (int)(110 * da)), ch * .15f, 0, 1.f);
+			}
+			if (i == curIdx)
+				xmbText(dl, bodyFont(), cs * .8f, ImVec2(px + cs * .6f, y + (ch - cs * .8f) * .5f), da, ICON_FA_CHECK);
+			xmbText(dl, bodyFont(), cs, ImVec2(px + cs * 1.8f, y + (ch - cs) * .5f), da, cur.choices[i].label, 0, w - cs * 2.4f);
+		}
+		dl->PopClipRect();
+	}
+	xmbHints(f, m.dropOpen ? std::vector<Hint> { { 'x', T("OK") }, { 'o', T("Back") } }
+			: std::vector<Hint> { { 'x', T("Change") }, { 'o', T("Back") } }, in);
+}
+
+} // namespace launcher
+
+using namespace launcher;
+
+// ---- the settings screen (GuiState::Settings) ----
+
+namespace
+{
+SettingsPanel *gScreenPanel;
+MenuInput gScreenInput;
+int gScreenSel;
+float gScreenPos, gScreenVel;
+int gScreenLastFrame = -10;
+float gScreenOpenedAt;
+}
+
+bool launcher_settings_draw()
+{
+	Frame f = menuFrame();
+	if (gScreenPanel == nullptr)
+		gScreenPanel = new SettingsPanel();
+	SettingsPanel& panel = *gScreenPanel;
+	const int frame = ImGui::GetFrameCount();
+	if (frame != gScreenLastFrame + 1)
+	{
+		// just opened
+		gScreenSel = 0;
+		gScreenPos = 0;
+		gScreenOpenedAt = f.t;
+		soundStart();
+	}
+	gScreenLastFrame = frame;
+	gScreenInput.read(f.t);
+
+	const bool overGame = gui_ps4_game_running();
+	xmbBackground(f, overGame);
+	xmbClock(f, 1.f);
+	drawCornerLogo(f, 1.f);
+
+	const int n = panel.groupCount();
+	if (panel.isOpen())
+		panel.input(gScreenInput, f.t);
+	else
+	{
+		if (gScreenInput.dy != 0)
+		{
+			const int next = std::clamp(gScreenSel + gScreenInput.dy, 0, n - 1);
+			if (next != gScreenSel)
+			{
+				gScreenSel = next;
+				playSound(Sound::Move);
+			}
+		}
+		if (gScreenInput.cross || gScreenInput.dx > 0)
+			panel.openGroup(gScreenSel, f.t);
+		else if (gScreenInput.circle)
+		{
+			playSound(Sound::Back);
+			gui_ps4_settings_done();
+			return true;
+		}
+	}
+
+	// the Settings column, as on the Cross bar; it steps aside while a group is open
+	spring(gScreenPos, gScreenVel, (float)gScreenSel, 130.f, 23.f, f.dt);
+	const float colA = panel.isOpen() ? .0f : easeOut((f.t - gScreenOpenedAt) / .3f);
+	const ImVec2 cat(f.w * .24f, f.h * .25f);
+	if (colA > 0)
+	{
+		xmbText(f.dl, bodyFont(), f.h * .085f, ImVec2(cat.x, cat.y - f.h * .046f), colA, ICON_FA_GEAR, .5f);
+		xmbText(f.dl, bodyFont(), f.h * .024f, ImVec2(cat.x, cat.y + f.h * .055f), colA, i18n::T("Settings"), .5f);
+		for (int i = 0; i < n; i++)
+		{
+			const float d = i - gScreenPos;
+			if (d < -.5f)
+				continue;
+			const float y = cat.y + f.h * .2f + d * f.h * .11f;
+			const float focus = clamp01(1 - std::fabs(d));
+			xmbItem(f, ImVec2(cat.x, y), panel.groupIcon(i), nullptr, panel.groupName(i), panel.groupSummary(i), focus,
+					colA * (i == gScreenSel ? 1.f : .7f));
+		}
+		xmbHints(f, { { 'x', i18n::T("Select") }, { 'o', i18n::T("Back") } }, colA);
+	}
+	panel.draw(f, 1.f);
+	return true;
+}
