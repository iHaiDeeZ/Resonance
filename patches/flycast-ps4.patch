+#include "launcher_internal.h"
+
+#include <algorithm>
+#include <ctime>
+
+namespace launcher
+{
+namespace
+{
+
+class Shelf : public Theme
+{
+public:
+	const char *name() const override { return "Shelf"; }
+	float launchSeconds() const override { return 1.6f; }
+
+	void draw(Frame& f) override
+	{
+		std::vector<Game>& games = *f.games;
+		const int n = (int)games.size();
+		if (!started)
+		{
+			started = true;
+			pos = (float)f.goal;
+			if (n > 0)
+				light = games[f.sel].c1;
+		}
+		spring(pos, vel, (float)f.goal, 140.f, 24.f, f.dt);
+		if (n > 0)
+			approach(light, games[f.sel].c1, 2.5f, f.dt);
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+
+		cx = f.w * .5f;
+		cy = f.h * .42f;
+		size = f.h * .42f;
+		dist = size * 2.6f;
+		drawRoom(f);
+		if (n == 0)
+		{
+			drawEmptyLibrary(f);
+			drawHints(f);
+			return;
+		}
+
+		struct Item { int game; float k; };
+		std::vector<Item> items;
+		const int span = std::min(7, n - 1);
+		for (int i = (int)std::floor(pos) - span - 1; i <= (int)std::ceil(pos) + span + 1; i++)
+		{
+			const float k = i - pos;
+			if (std::fabs(k) > span + .5f || (n == 1 && i != f.goal))
+				continue;
+			items.push_back({ ((i % n) + n) % n, k });
+		}
+		// far boxes first
+		std::sort(items.begin(), items.end(), [](const Item& a, const Item& b) { return std::fabs(a.k) > std::fabs(b.k); });
+		const float out = easeOut(launch / .5f);
+		for (const Item& it : items)
+		{
+			const bool front = std::fabs(it.k) < .5f;
+			Pose p = poseFor(it.k);
+			float alpha = clamp01(span + .5f - std::fabs(it.k));
+			if (front)
+			{
+				// turn around and come forward
+				const float q = clamp01(launch / .55f);
+				p.angle += PI * q * q * (3 - 2 * q);
+				p.z -= size * .9f * out;
+			}
+			else
+			{
+				p.x += (it.k < 0 ? -1 : 1) * f.w * .6f * out;
+				alpha *= 1 - out;
+			}
+			drawBox(f, games[it.game], p, alpha, true);
+			drawBox(f, games[it.game], p, alpha, false);
+		}
+
+		const float uiAlpha = 1 - easeOut(launch / .3f);
+		drawInfo(f, games[f.sel], uiAlpha);
+		drawHints(f, uiAlpha);
+		if (launch > .78f)
+			drawLaunchCard(f, (*f.games)[f.sel], (launch - .78f) / .22f);
+	}
+
+private:
+	struct Pose { float x, z, angle; };
+
+	// Where a box k places from the selection stands, and how far it is turned
+	Pose poseFor(float k) const
+	{
+		const float s = std::fmax(-1.f, std::fmin(1.f, k));
+		const float a = std::fabs(k);
+		Pose p;
+		p.angle = -s * 1.2f;		// ~70 degrees, facing the middle
+		p.x = a < 1 ? k * size * .8f : (k < 0 ? -1 : 1) * (size * .8f + (a - 1) * size * .26f);
+		p.z = std::fabs(s) * size * .6f;
+		return p;
+	}
+
+	ImVec2 project(float x, float y, float z) const
+	{
+		const float s = dist / (dist + z);
+		return ImVec2(cx + x * s, cy + y * s);
+	}
+
+	// The box (or its reflection in the shelf) as vertical strips, so the perspective holds
+	void drawBox(Frame& f, const Game& g, const Pose& p, float alpha, bool reflection)
+	{
+		if (alpha <= .003f)
+			return;
+		const float ca = std::cos(p.angle), sa = std::sin(p.angle);
+		const bool back = ca < 0;
+		const ImTextureID tex = back ? ImTextureID() : coverTexture(g);
+		const float half = size * .5f;
+		constexpr int STRIPS = 12;
+		// facing light: boxes turned away are darker
+		const float shade = .45f + .55f * std::fabs(ca);
+		for (int i = 0; i < STRIPS; i++)
+		{
+			const float u0 = (float)i / STRIPS, u1 = (float)(i + 1) / STRIPS;
+			const float lx0 = -half + u0 * size, lx1 = -half + u1 * size;
+			const float x0 = p.x + lx0 * ca, z0 = p.z + lx0 * sa, x1 = p.x + lx1 * ca, z1 = p.z + lx1 * sa;
+			// from the back the picture reads mirrored
+			const float tu0 = back ? 1 - u0 : u0, tu1 = back ? 1 - u1 : u1;
+			ImVec2 q[4], uv[4];
+			ImU32 col[4];
+			if (!reflection)
+			{
+				q[0] = project(x0, -half, z0); q[1] = project(x1, -half, z1);
+				q[2] = project(x1, half, z1); q[3] = project(x0, half, z0);
+				uv[0] = ImVec2(tu0, 0); uv[1] = ImVec2(tu1, 0); uv[2] = ImVec2(tu1, 1); uv[3] = ImVec2(tu0, 1);
+				// a sheen sweeping across the front box
+				for (int c = 0; c < 4; c++)
+				{
+					const float u = (c == 0 || c == 3) ? u0 : u1;
+					const float sweep = std::exp(-std::pow((u - std::fmod(f.t * .18f, 1.6f) + .3f) * 5.f, 2.f)) * .25f * std::fabs(ca);
+					const float v = std::fmin(1.f, shade + sweep);
+					col[c] = tex != ImTextureID() ? Color { v, v, v }.u32(alpha)
+							: mix(back ? g.c2 : g.c1, g.c2, c >= 2 ? .8f : .1f + .3f * u).u32(alpha * shade);
+				}
+			}
+			else
+			{
+				// mirrored below the shelf, fading out
+				const float depth = size * .55f;
+				q[0] = project(x0, half, z0); q[1] = project(x1, half, z1);
+				q[2] = project(x1, half + depth, z1); q[3] = project(x0, half + depth, z0);
+				uv[0] = ImVec2(tu0, 1); uv[1] = ImVec2(tu1, 1); uv[2] = ImVec2(tu1, 1 - depth / size); uv[3] = ImVec2(tu0, 1 - depth / size);
+				const Color base = tex != ImTextureID() ? Color { shade, shade, shade } : mix(g.c1, g.c2, .5f);
+				col[0] = col[1] = base.u32(alpha * .28f);
+				col[2] = col[3] = base.u32(0.f);
+			}
+			drawQuad(f.dl, tex, q, uv, col);
+		}
+		if (reflection)
+			return;
+		// edges: a thin bright rim on the front, the back panel's text once it faces us
+		const ImVec2 tl = project(p.x - half * ca, -half, p.z - half * sa), tr = project(p.x + half * ca, -half, p.z + half * sa);
+		const ImVec2 br = project(p.x + half * ca, half, p.z + half * sa), bl = project(p.x - half * ca, half, p.z - half * sa);
+		f.dl->AddQuad(tl, tr, br, bl, IM_COL32(255, 255, 255, (int)(60 * alpha * std::fabs(ca))), 1.5f);
+		if (back && ca < -.85f)
+		{
+			const float a = alpha * clamp01((-ca - .85f) / .15f);
+			const ImVec2 c((tl.x + br.x) / 2, (tl.y + br.y) / 2);
+			const float w = std::fabs(tr.x - tl.x);
+			drawText(f.dl, displayFont(), w * .07f, ImVec2(c.x, c.y - w * .12f), IM_COL32(255, 255, 255, (int)(255 * a)), g.e.title, .5f, w * .86f);
+			drawText(f.dl, bodyFont(), w * .045f, ImVec2(c.x, c.y), IM_COL32(220, 225, 235, (int)(220 * a)), i18n::T("Starting..."), .5f);
+			drawText(f.dl, bodyFont(), w * .035f, ImVec2(c.x, c.y + w * .3f), IM_COL32(200, 205, 220, (int)(180 * a)),
+					g.format + (g.e.productId.empty() ? "" : "   " + g.e.productId), .5f);
+		}
+	}
+
+	void drawRoom(Frame& f)
+	{
+		ImDrawList *dl = f.dl;
+		const float shelfY = cy + size * .5f;
+		const Color top = mix(light, { 0, 0, 0 }, .88f);
+		dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, shelfY), top.u32(), top.u32(), IM_COL32(6, 6, 9, 255), IM_COL32(6, 6, 9, 255));
+		dl->AddRectFilledMultiColor(ImVec2(0, shelfY), ImVec2(f.w, f.h), IM_COL32(14, 14, 18, 255), IM_COL32(14, 14, 18, 255),
+				IM_COL32(2, 2, 3, 255), IM_COL32(2, 2, 3, 255));
+		// spot lights from above, swaying a little
+		for (int i = 0; i < 3; i++)
+		{
+			const float x = f.w * (.5f + (i - 1) * .34f) + std::sin(f.t * .3f + i * 2) * f.w * .02f;
+			drawBlob(dl, ImVec2(x, cy - size * .2f), size * (i == 1 ? 1.5f : 1.f), light.u32(i == 1 ? .2f : .09f));
+		}
+		// the shelf's front edge catching the light
+		dl->AddRectFilledMultiColor(ImVec2(0, shelfY - 1), ImVec2(f.w, shelfY + 2), IM_COL32(255, 255, 255, 0), light.u32(.35f),
+				light.u32(.35f), IM_COL32(255, 255, 255, 0));
+		dl->AddRectFilledMultiColor(ImVec2(f.w * .5f, shelfY - 1), ImVec2(f.w, shelfY + 2), light.u32(.35f), IM_COL32(255, 255, 255, 0),
+				IM_COL32(255, 255, 255, 0), light.u32(.35f));
+		// dust in the light
+		u32 x = 88172645u;
+		for (int i = 0; i < 50; i++)
+		{
+			x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+			const float px = (x & 0xffff) / 65535.f * f.w, base = (x >> 16) / 65535.f;
+			const float py = std::fmod(base * f.h * .8f - f.t * (6.f + i % 5), f.h * .8f);
+			const float a = .5f + .5f * std::sin(f.t * .7f + i);
+			dl->AddCircleFilled(ImVec2(px + std::sin(f.t * .4f + i) * 10.f, py < 0 ? py + f.h * .8f : py), 1.4f, light.u32(.25f * a), 6);
+		}
+	}
+
+	void drawInfo(Frame& f, const Game& g, float alpha)
+	{
+		if (alpha <= 0)
+			return;
+		ImDrawList *dl = f.dl;
+		const float age = f.t - f.selectedAt;
+		const float in = alpha * easeOut(age / .35f);
+		const float y = f.h * .8f;
+		drawText(dl, displayFont(), f.h * .045f, ImVec2(f.w / 2, y + (1 - in) * 8), IM_COL32(255, 255, 255, (int)(255 * in)), g.e.title, .5f, f.w * .8f);
+		std::string info = g.format;
+		if (!g.regionName.empty())
+			info += "   \xC2\xB7   " + g.regionName;
+		if (!g.e.productId.empty())
+			info += "   \xC2\xB7   " + g.e.productId;
+		drawText(dl, bodyFont(), f.h * .025f, ImVec2(f.w / 2, y + f.h * .06f), mix(g.c1, { 1, 1, 1 }, .5f).u32(.85f * in), info, .5f);
+		// where you are on the shelf
+		const int n = (int)f.games->size();
+		if (n > 1)
+		{
+			const float x0 = f.w * .35f, x1 = f.w * .65f, ly = f.h * .055f;
+			dl->AddLine(ImVec2(x0, ly), ImVec2(x1, ly), IM_COL32(255, 255, 255, (int)(50 * alpha)), 2.f);
+			const float p = ((std::fmod(pos, (float)n) + n) / n) - std::floor((std::fmod(pos, (float)n) + n) / n);
+			dl->AddCircleFilled(ImVec2(x0 + (x1 - x0) * p, ly), 5.f, light.u32(alpha));
+		}
+		char clock[16];
+		const time_t now = time(nullptr);
+		strftime(clock, sizeof(clock), "%H:%M", localTm(now));
+		drawText(dl, displayFont(), f.h * .026f, ImVec2(f.w * .95f, f.h * .04f), IM_COL32(255, 255, 255, (int)(220 * alpha)), clock, 1.f);
+	}
+
+	bool started = false;
+	float pos = 0, vel = 0;
+	float cx = 0, cy = 0, size = 0, dist = 1;
+	Color light { .5f, .6f, 1.f };
+};
+
+} // namespace
+
+std::unique_ptr<Theme> makeShelf() {
+	return std::make_unique<Shelf>();
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/theme_xmb.cpp b/shell/ps4/launcher/theme_xmb.cpp
new file mode 100644
index 000000000..38c336116
--- /dev/null
+++ b/shell/ps4/launcher/theme_xmb.cpp
@@ -0,0 +1,218 @@
+/*
+	Resonance's home screen, theme "Cross bar": the PS3's XMB, kept simple. Two categories across
+	(Settings, Games), the selected one's items down: the games with their covers, or the settings
+	groups. A settings group opens its options in place, PS3 style, with drop-down lists
+	(settings_menu.cpp). The month's colour and the slow wave behind (xmb_style.cpp).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <algorithm>
+
+namespace launcher
+{
+namespace
+{
+
+enum Category { SETTINGS, GAMES, CATEGORY_COUNT };
+const char *const kCategoryIcon[CATEGORY_COUNT] = { ICON_FA_TOOLBOX, ICON_FA_GAMEPAD };
+const char *const kCategoryName[CATEGORY_COUNT] = { Tnop("Settings"), Tnop("Games") };
+
+class CrossBar : public Theme
+{
+public:
+	const char *name() const override { return "Cross bar"; }
+	float launchSeconds() const override { return .9f; }
+
+	bool navigate(Frame& f, int dx, int dy) override
+	{
+		if (dx != 0)
+		{
+			const int next = std::clamp(cat + dx, 0, CATEGORY_COUNT - 1);
+			if (next != cat)
+			{
+				cat = next;
+				catChangedAt = f.t;
+				playSound(Sound::Category);
+			}
+			return true;
+		}
+		if (cat == GAMES)
+			moveSelection(dy);
+		else
+		{
+			const int next = std::clamp(setSel + dy, 0, panel.groupCount() - 1);
+			if (next != setSel)
+			{
+				setSel = next;
+				playSound(Sound::Move);
+			}
+		}
+		return true;
+	}
+
+	bool activate(Frame& f) override
+	{
+		if (cat == GAMES)
+			return false;	// the core starts the game
+		panel.openGroup(setSel, f.t);
+		return true;
+	}
+
+	bool busy() const override {
+		return panel.isOpen();
+	}
+
+	void menuInput(Frame& f, const MenuInput& in) override {
+		panel.input(in, f.t);
+	}
+
+	void draw(Frame& f) override
+	{
+		const int n = (int)f.games->size();
+		if (!started)
+		{
+			started = true;
+			gamePos = (float)f.goal;
+		}
+		const float launch = f.launchAt >= 0 ? clamp01((f.t - f.launchAt) / launchSeconds()) : 0.f;
+		spring(catPos, catVel, (float)cat, 120.f, 22.f, f.dt);
+		spring(gamePos, gameVel, (float)f.goal, 140.f, 24.f, f.dt);
+		spring(setPos, setVel, (float)setSel, 140.f, 24.f, f.dt);
+		// the bar steps aside while a settings group is open
+		spring(aside, asideVel, panel.isOpen() ? 1.f : 0.f, 150.f, 25.f, f.dt);
+
+		xmbBackground(f);
+		const float ui = (1 - easeOut(launch / .5f)) * clamp01(1 - aside);
+		if (ui > .01f)
+		{
+			drawCategories(f, ui);
+			drawColumn(f, ui, n);
+			if (cat == GAMES)
+				xmbHints(f, n > 0 ? std::vector<Hint> { { 'x', i18n::T("Start") }, { 'r', i18n::T("Refresh") }, { 't', i18n::T("Settings") } }
+						: std::vector<Hint> {}, ui);
+			else
+				xmbHints(f, { { 'x', i18n::T("Select") } }, ui);
+		}
+		panel.draw(f, clamp01(aside));
+		xmbClock(f, 1 - easeOut(launch / .5f));
+		if (launch > 0 && n > 0)
+			drawLaunchCard(f, (*f.games)[f.sel], easeOut(launch));
+	}
+
+private:
+	ImVec2 barOrigin(const Frame& f) const {
+		return ImVec2(f.w * .24f - aside * f.w * .1f, f.h * .25f);
+	}
+
+	void drawCategories(Frame& f, float alpha)
+	{
+		const ImVec2 o = barOrigin(f);
+		const float step = f.w * .12f;
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+		{
+			const float k = c - catPos;
+			const float near = clamp01(1 - std::fabs(k));
+			const float x = o.x + k * step;
+			const float size = f.h * (.062f + .024f * near);
+			const float a = alpha * (.55f + .45f * near);
+			xmbText(f.dl, bodyFont(), size, ImVec2(x, o.y - size * .55f), a, kCategoryIcon[c], .5f);
+			if (near > .01f)
+			{
+				const float e = easeOut((f.t - catChangedAt) / .25f);
+				xmbText(f.dl, bodyFont(), f.h * .024f, ImVec2(x, o.y + f.h * .055f), alpha * near * e, i18n::T(kCategoryName[c]), .5f);
+			}
+		}
+	}
+
+	// The selected category's items: the chosen one just under the bar, the ones after it below,
+	// the ones before it above the bar (as on the PS3)
+	void drawColumn(Frame& f, float alpha, int n)
+	{
+		const ImVec2 o = barOrigin(f);
+		const float step = f.w * .12f;
+		for (int c = 0; c < CATEGORY_COUNT; c++)
+		{
+			const float k = c - catPos;
+			const float colA = clamp01(1 - std::fabs(k) * 1.8f) * alpha;
+			if (colA <= .01f)
+				continue;
+			const float x = o.x + k * step;
+			const int count = c == GAMES ? n : panel.groupCount();
+			if (count == 0)
+			{
+				xmbText(f.dl, bodyFont(), f.h * .03f, ImVec2(x - f.h * .03f, o.y + f.h * .17f), colA, i18n::T("No games yet"));
+				xmbText(f.dl, bodyFont(), f.h * .022f, ImVec2(x - f.h * .03f, o.y + f.h * .22f), colA * .8f,
+						i18n::T("Copy games to /data/Resonance/games"));
+				continue;
+			}
+			const float pos = c == GAMES ? gamePos : setPos;
+			const int selected = c == GAMES ? f.goal : setSel;
+			const int before = std::min(3, count - 1);
+			for (int i = (int)std::floor(pos) - 3; i <= (int)std::ceil(pos) + 7; i++)
+			{
+				if (c != GAMES && (i < 0 || i >= count))
+					continue;
+				// games wrap round; each shows once
+				if (c == GAMES && (selected - i > before || i - selected > count - 1 - before))
+					continue;
+				const float d = i - pos;
+				const float below = o.y + f.h * .2f, above = o.y - f.h * .1f;
+				float y;
+				if (d >= 0)
+					y = below + d * f.h * .11f;
+				else if (d <= -1)
+					y = above + (d + 1) * f.h * .09f;
+				else
+					y = below + (above - below) * -d;
+				if (y > f.h * 1.05f || y < -f.h * .1f)
+					continue;
+				const float focus = clamp01(1 - std::fabs(d));
+				const float a = colA * (i == selected ? 1.f : .7f) * clamp01(1.3f - std::fabs(d) * .12f)
+						* clamp01((y - f.h * .1f) / (f.h * .1f));	// under the logo
+				const int idx = ((i % count) + count) % count;
+				if (c == GAMES)
+				{
+					const Game& g = (*f.games)[idx];
+					std::string sub = g.format;
+					if (!g.regionName.empty())
+						sub += "   \xC2\xB7   " + g.regionName;
+					if (!g.e.productId.empty())
+						sub += "   \xC2\xB7   " + g.e.productId;
+					xmbItem(f, ImVec2(x, y), nullptr, &g, g.e.title, sub, focus, a);
+				}
+				else
+					xmbItem(f, ImVec2(x, y), panel.groupIcon(idx), nullptr, panel.groupName(idx), panel.groupSummary(idx), focus, a);
+			}
+		}
+	}
+
+	SettingsPanel panel;
+	bool started = false;
+	int cat = GAMES, setSel = 0;
+	float catPos = GAMES, catVel = 0, gamePos = 0, gameVel = 0, setPos = 0, setVel = 0;
+	float aside = 0, asideVel = 0, catChangedAt = -10;
+};
+
+} // namespace
+
+std::unique_ptr<Theme> makeCrossBar() {
+	return std::make_unique<CrossBar>();
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/vmu.cpp b/shell/ps4/launcher/vmu.cpp
new file mode 100644
index 000000000..63936e689
--- /dev/null
+++ b/shell/ps4/launcher/vmu.cpp
@@ -0,0 +1,295 @@
+/*
+	Resonance's memory cards: Flycast's VMU images (128 KiB of flash, 256 blocks of 512 bytes) read
+	and changed the way the Dreamcast's BIOS does. Block 255 is the root (where the FAT and the
+	directory are), the FAT chains each file's blocks, the directory has 32-byte entries; a save's
+	first block (its second for a game) starts with the VMS header: descriptions, the animated
+	32x32 icon (16 colours, ARGB4444).
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "stdclass.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <dirent.h>
+
+namespace launcher
+{
+namespace
+{
+constexpr int BLOCK = 512, BLOCKS = 256;
+constexpr u16 FREE = 0xFFFC, END = 0xFFFA;
+
+u16 rd16(const u8 *p) { return p[0] | (p[1] << 8); }
+u32 rd32(const u8 *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((u32)p[3] << 24); }
+void wr16(u8 *p, u16 v) { p[0] = v & 0xFF; p[1] = v >> 8; }
+int bcd(u8 v) { return (v >> 4) * 10 + (v & 15); }
+
+std::string text(const u8 *p, size_t n)
+{
+	std::string s;
+	for (size_t i = 0; i < n; i++)
+		s += p[i] >= 0x20 && p[i] < 0x7F ? (char)p[i] : ' ';
+	while (!s.empty() && s.back() == ' ')
+		s.pop_back();
+	while (!s.empty() && s.front() == ' ')
+		s.erase(0, 1);
+	return s;
+}
+
+struct Layout { int fat, dir, dirBlocks, userBlocks; };
+
+Layout layout(const std::vector<u8>& img)
+{
+	const u8 *root = &img[255 * BLOCK];
+	Layout l { rd16(root + 0x46), rd16(root + 0x4A), rd16(root + 0x4C), rd16(root + 0x50) };
+	// an unformatted card: the standard layout
+	if (l.fat >= BLOCKS || l.dir >= BLOCKS || l.dirBlocks == 0 || l.dirBlocks > 32 || l.userBlocks == 0 || l.userBlocks > 241)
+		l = { 254, 253, 13, 200 };
+	return l;
+}
+
+u16 fat(const std::vector<u8>& img, const Layout& l, int block) {
+	return rd16(&img[l.fat * BLOCK + block * 2]);
+}
+
+void setFat(std::vector<u8>& img, const Layout& l, int block, u16 v) {
+	wr16(&img[l.fat * BLOCK + block * 2], v);
+}
+
+// A save's blocks in order: its FAT chain. Some games leave the FAT behind (their saves'
+// blocks still marked free): the BIOS allocates downward from the first block, so a chain that
+// stops short is taken as that run (the saves' CRCs agree)
+std::vector<int> chain(const std::vector<u8>& img, const Layout& l, int first, int count)
+{
+	std::vector<int> out;
+	int b = first;
+	while (b >= 0 && b < BLOCKS && (int)out.size() < count)
+	{
+		out.push_back(b);
+		const u16 next = fat(img, l, b);
+		if (next == END || next == FREE)
+			break;
+		b = next;
+	}
+	if ((int)out.size() < count && first - count + 1 >= 0)
+	{
+		out.clear();
+		for (int i = 0; i < count; i++)
+			out.push_back(first - i);
+	}
+	return out;
+}
+
+// the blocks the card's saves take, whatever its FAT says
+std::vector<bool> usedBlocks(const std::vector<u8>& img, const Layout& l, const std::vector<VmuSave>& saves)
+{
+	std::vector<bool> used(BLOCKS, false);
+	for (int b = 0; b < l.userBlocks; b++)
+		used[b] = fat(img, l, b) != FREE;
+	for (const VmuSave& s : saves)
+		for (int b : chain(img, l, s.firstBlock, s.blocks))
+			used[b] = true;
+	return used;
+}
+
+// the directory entries: (block, offset in it)
+std::vector<std::pair<int, int>> entries(const Layout& l)
+{
+	std::vector<std::pair<int, int>> out;
+	for (int i = 0; i < l.dirBlocks; i++)
+		for (int e = 0; e < BLOCK / 32; e++)
+			out.emplace_back(l.dir - i, e * 32);
+	return out;
+}
+} // namespace
+
+bool readVmu(const std::string& path, VmuCard& card)
+{
+	card = VmuCard();
+	card.path = path;
+	FILE *f = nowide::fopen(path.c_str(), "rb");
+	if (f == nullptr)
+		return false;
+	card.image.resize(BLOCKS * BLOCK);
+	const size_t n = fread(card.image.data(), 1, card.image.size(), f);
+	fclose(f);
+	if (n != card.image.size())
+		return false;
+	const std::vector<u8>& img = card.image;
+	const Layout l = layout(img);
+	card.totalBlocks = l.userBlocks;
+	card.freeBlocks = 0;
+	for (const auto& [block, offset] : entries(l))
+	{
+		const u8 *e = &img[block * BLOCK + offset];
+		if (e[0] != 0x33 && e[0] != 0xCC)
+			continue;
+		VmuSave s;
+		s.game = e[0] == 0xCC;
+		s.copyProtected = e[1] == 0xFF;
+		s.firstBlock = rd16(e + 2);
+		s.fileName = text(e + 4, 12);
+		s.year = bcd(e[0x10]) * 100 + bcd(e[0x11]);
+		s.month = bcd(e[0x12]);
+		s.day = bcd(e[0x13]);
+		s.hour = bcd(e[0x14]);
+		s.minute = bcd(e[0x15]);
+		s.blocks = rd16(e + 0x18);
+		s.headerBlock = rd16(e + 0x1A);
+		s.dirBlock = block;
+		s.dirOffset = offset;
+		// the file's bytes, in order
+		std::vector<u8> data;
+		for (int b : chain(img, l, s.firstBlock, s.blocks))
+			data.insert(data.end(), img.begin() + b * BLOCK, img.begin() + (b + 1) * BLOCK);
+		const size_t h = (size_t)s.headerBlock * BLOCK;
+		if (data.size() >= h + 0x80)
+		{
+			const u8 *hd = &data[h];
+			s.title = text(hd, 16);
+			s.description = text(hd + 0x10, 32);
+			s.frames = std::min<int>(rd16(hd + 0x40), 3);
+			s.speed = rd16(hd + 0x42);
+			for (int i = 0; i < 16; i++)
+			{
+				const u16 c = rd16(hd + 0x60 + i * 2);
+				s.palette[i] = ((c >> 12) & 15) * 17 << 24 | ((c >> 8) & 15) * 17 | ((c >> 4) & 15) * 17 << 8 | (c & 15) * 17 << 16;
+			}
+			for (int fr = 0; fr < s.frames && data.size() >= h + 0x80 + (fr + 1) * 512; fr++)
+				s.icons.emplace_back(data.begin() + h + 0x80 + fr * 512, data.begin() + h + 0x80 + (fr + 1) * 512);
+			(void)rd32;
+		}
+		if (s.title.empty())
+			s.title = s.fileName;
+		card.saves.push_back(s);
+	}
+	// free: neither in the FAT nor under a save
+	const std::vector<bool> used = usedBlocks(img, l, card.saves);
+	for (int b = 0; b < l.userBlocks; b++)
+		card.freeBlocks += !used[b];
+	return true;
+}
+
+std::string writeVmu(const VmuCard& card)
+{
+	FILE *f = nowide::fopen(card.path.c_str(), "wb");
+	if (f == nullptr)
+		return "can't write " + card.path;
+	const bool ok = fwrite(card.image.data(), 1, card.image.size(), f) == card.image.size();
+	fclose(f);
+	return ok ? "" : "can't write " + card.path;
+}
+
+std::string deleteSave(VmuCard& card, int index)
+{
+	if (index < 0 || index >= (int)card.saves.size())
+		return "no such save";
+	const VmuSave s = card.saves[index];
+	const Layout l = layout(card.image);
+	for (int b : chain(card.image, l, s.firstBlock, s.blocks))
+		setFat(card.image, l, b, FREE);
+	memset(&card.image[s.dirBlock * BLOCK + s.dirOffset], 0, 32);
+	const std::string error = writeVmu(card);
+	if (error.empty())
+		readVmu(card.path, card);
+	return error;
+}
+
+std::string copySave(const VmuCard& from, int index, VmuCard& to)
+{
+	if (index < 0 || index >= (int)from.saves.size())
+		return "no such save";
+	const VmuSave& s = from.saves[index];
+	if (s.game)
+		return "mini-games can't be copied";	// they must start at block 0
+	if (s.copyProtected)
+		return "this save is copy protected";
+	const Layout lf = layout(from.image), lt = layout(to.image);
+	for (const VmuSave& other : to.saves)
+		if (other.fileName == s.fileName)
+			return "the other card already has " + s.fileName;
+	const std::vector<int> src = chain(from.image, lf, s.firstBlock, s.blocks);
+	if ((int)src.size() < s.blocks)
+		return "this save's blocks can't be found";
+	// free blocks from the top down, as the BIOS saves, a run if possible (games that skip the FAT
+	// expect their save in one piece)
+	const std::vector<bool> used = usedBlocks(to.image, lt, to.saves);
+	std::vector<int> dst;
+	for (int top = lt.userBlocks - 1; top - s.blocks + 1 >= 0 && dst.empty(); top--)
+	{
+		bool run = true;
+		for (int i = 0; i < s.blocks && run; i++)
+			run = !used[top - i];
+		if (run)
+			for (int i = 0; i < s.blocks; i++)
+				dst.push_back(top - i);
+	}
+	if (dst.empty())
+		// no run that long: any free blocks, chained in the FAT
+		for (int b = lt.userBlocks - 1; b >= 0 && dst.size() < src.size(); b--)
+			if (!used[b])
+				dst.push_back(b);
+	if (dst.size() < src.size())
+		return "not enough free blocks on the other card";
+	int slotBlock = -1, slotOffset = 0;
+	for (const auto& [block, offset] : entries(lt))
+	{
+		const u8 t = to.image[block * BLOCK + offset];
+		if (t != 0x33 && t != 0xCC)
+		{
+			slotBlock = block;
+			slotOffset = offset;
+			break;
+		}
+	}
+	if (slotBlock < 0)
+		return "the other card's directory is full";
+	for (size_t i = 0; i < src.size(); i++)
+	{
+		memcpy(&to.image[dst[i] * BLOCK], &from.image[src[i] * BLOCK], BLOCK);
+		setFat(to.image, lt, dst[i], i + 1 < dst.size() ? (u16)dst[i + 1] : END);
+	}
+	u8 *e = &to.image[slotBlock * BLOCK + slotOffset];
+	memcpy(e, &from.image[s.dirBlock * BLOCK + s.dirOffset], 32);
+	wr16(e + 2, (u16)dst[0]);
+	const std::string error = writeVmu(to);
+	if (error.empty())
+		readVmu(to.path, to);
+	return error;
+}
+
+std::vector<std::string> vmuFiles()
+{
+	std::vector<std::string> out;
+	const std::string dir = get_writable_data_path("");
+	if (DIR *d = opendir(dir.c_str()))
+	{
+		while (dirent *e = readdir(d))
+		{
+			const std::string name = e->d_name;
+			if (name.find("vmu_save_") != std::string::npos && name.size() > 4 && name.compare(name.size() - 4, 4, ".bin") == 0)
+				out.push_back(dir + name);
+		}
+		closedir(d);
+	}
+	std::sort(out.begin(), out.end());
+	return out;
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/vmu_viewer.cpp b/shell/ps4/launcher/vmu_viewer.cpp
new file mode 100644
index 000000000..43bc91cfb
--- /dev/null
+++ b/shell/ps4/launcher/vmu_viewer.cpp
@@ -0,0 +1,330 @@
+/*
+	Resonance's memory card viewer (Settings > Memory Cards): a card's saves with their animated
+	icons, titles, sizes and dates; Cross on one: copy it to another card, or delete it (twice, to
+	be sure). Not while a game runs: the emulator has the cards open.
+
+	This file is part of Flycast.
+
+    Flycast is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 2 of the License, or
+    (at your option) any later version.
+
+    Flycast is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+#include "launcher_internal.h"
+#include "ui/imgui_driver.h"
+#include "ui/IconsFontAwesome6.h"
+
+#include <map>
+
+using i18n::T;
+
+namespace launcher
+{
+namespace
+{
+bool gOpen;
+VmuCard gCard;
+std::vector<std::string> gOthers;		// the other cards (copy targets)
+int gSel;
+float gPos, gVel, gOpenedAt;
+bool gMenu;								// the actions list
+int gMenuSel;
+std::vector<std::pair<std::string, int>> gActions;	// label, action (-1 delete, i: copy to gOthers[i])
+bool gConfirmDelete;
+std::string gStatus;
+bool gStatusBad;
+float gStatusAt = -10, gNow;
+int gTextureGeneration;
+
+void say(const std::string& s, bool bad)
+{
+	gStatus = s;
+	gStatusBad = bad;
+	gStatusAt = gNow;
+	playSound(bad ? Sound::Error : Sound::Confirm);
+}
+
+std::string alnum(const std::string& s)
+{
+	std::string out;
+	for (char c : s)
+		if (isalnum((unsigned char)c))
+			out += (char)toupper((unsigned char)c);
+	return out;
+}
+
+// One texture per save: its frames side by side (32x32 each)
+ImTextureID iconTexture(const VmuSave& s, int index)
+{
+	if (s.icons.empty() || imguiDriver == nullptr)
+		return {};
+	const std::string name = "vmu:" + gCard.path + ":" + s.fileName + ":" + std::to_string(gTextureGeneration) + ":" + std::to_string(index);
+	ImTextureID id = imguiDriver->getTexture(name);
+	if (id != ImTextureID())
+		return id;
+	const int frames = (int)s.icons.size();
+	std::vector<u8> rgba(32 * frames * 32 * 4);
+	for (int fr = 0; fr < frames; fr++)
+		for (int y = 0; y < 32; y++)
+			for (int x = 0; x < 32; x++)
+			{
+				const u8 byte = s.icons[fr][y * 16 + x / 2];
+				const u32 c = s.palette[x & 1 ? byte & 15 : byte >> 4];
+				u8 *p = &rgba[((y * 32 * frames) + fr * 32 + x) * 4];
+				p[0] = c & 0xFF;
+				p[1] = (c >> 8) & 0xFF;
+				p[2] = (c >> 16) & 0xFF;
+				p[3] = c >> 24;
+			}
+	try {
+		id = imguiDriver->updateTexture(name, rgba.data(), 32 * frames, 32, true);
+	} catch (...) {
+	}
+	return id;
+}
+
+void reload()
+{
+	readVmu(gCard.path, gCard);
+	gTextureGeneration++;
+	gSel = std::clamp(gSel, 0, std::max(0, (int)gCard.saves.size() - 1));
+}
+} // namespace
+
+std::string vmuLabel(const std::string& path)
+{
+	std::string name = path.substr(path.find_last_of('/') + 1);
+	const size_t at = name.find("vmu_save_");
+	if (at == std::string::npos)
+		return name;
+	std::string port = name.substr(at + 9);
+	port = port.substr(0, port.find('.'));
+	if (at == 0)
+		return T("Memory Card") + std::string(" ") + port;
+	// a game's own card: <serial>_vmu_save_A1.bin
+	const std::string serial = alnum(name.substr(0, at));
+	static std::map<std::string, std::string> titles;
+	if (titles.empty())
+	{
+		std::vector<LauncherEntry> games;
+		gui_ps4_list_games(games);
+		for (const LauncherEntry& g : games)
+			if (!g.productId.empty())
+				titles[alnum(g.productId)] = g.title;
+	}
+	auto it = titles.find(serial);
+	return (it != titles.end() ? it->second : name.substr(0, at - 1)) + "  " + port;
+}
+
+void vmuViewerOpen(const std::string& path, float t)
+{
+	gNow = t;
+	gOpen = true;
+	gSel = 0;
+	gPos = 0;
+	gMenu = false;
+	gConfirmDelete = false;
+	gStatus.clear();
+	gOpenedAt = t;
+	readVmu(path, gCard);
+	gTextureGeneration++;
+	gOthers.clear();
+	for (const std::string& p : vmuFiles())
+		if (p != path)
+			gOthers.push_back(p);
+	playSound(Sound::Confirm);
+}
+
+bool vmuViewerActive() {
+	return gOpen;
+}
+
+bool vmuViewerInput(const MenuInput& in, float t)
+{
+	gNow = t;
+	if (!gOpen)
+		return false;
+	const int n = (int)gCard.saves.size();
+	if (gMenu)
+	{
+		if (in.dy != 0)
+		{
+			gMenuSel = std::clamp(gMenuSel + in.dy, 0, (int)gActions.size() - 1);
+			gConfirmDelete = false;
+			playSound(Sound::Move);
+		}
+		if (in.circle)
+		{
+			gMenu = false;
+			playSound(Sound::Back);
+		}
+		else if (in.cross)
+		{
+			const int action = gActions[gMenuSel].second;
+			if (action < 0)
+			{
+				if (!gConfirmDelete)
+				{
+					gConfirmDelete = true;
+					say(T("Press X again to delete this save"), false);
+					return true;
+				}
+				const std::string error = deleteSave(gCard, gSel);
+				reload();
+				gMenu = false;
+				if (error.empty())
+					say(T("Save deleted"), false);
+				else
+					say(error, true);
+			}
+			else
+			{
+				VmuCard target;
+				std::string error = readVmu(gOthers[action], target) ? copySave(gCard, gSel, target) : "can't read the other card";
+				gMenu = false;
+				if (error.empty())
+				{
+					char buf[256];
+					snprintf(buf, sizeof(buf), T("Copied to %s"), vmuLabel(gOthers[action]).c_str());
+					say(buf, false);
+				}
+				else
+					say(error, true);
+			}
+		}
+		return true;
+	}
+	if (in.dy != 0 && n > 0)
+	{
+		gSel = std::clamp(gSel + in.dy, 0, n - 1);
+		playSound(Sound::Move);
+	}
+	if (in.circle)
+	{
+		gOpen = false;
+		playSound(Sound::Back);
+		return false;
+	}
+	if (in.cross && n > 0)
+	{
+		if (gui_ps4_game_running())
+		{
+			say(T("Close the game to change memory cards"), true);
+			return true;
+		}
+		gActions.clear();
+		for (int i = 0; i < (int)gOthers.size(); i++)
+			gActions.push_back({ std::string(T("Copy to")) + "  " + vmuLabel(gOthers[i]), i });
+		gActions.push_back({ T("Delete"), -1 });
+		gMenu = true;
+		gMenuSel = 0;
+		gConfirmDelete = false;
+		playSound(Sound::Confirm);
+	}
+	return true;
+}
+
+void vmuViewerDraw(Frame& f, float alpha)
+{
+	if (!gOpen)
+		return;
+	ImDrawList *dl = f.dl;
+	const float in = easeOut((f.t - gOpenedAt) / .25f) * alpha;
+	const Color tone = xmbTone();
+
+	// the card: its name and how full it is
+	const float x0 = f.w * .07f, x1 = f.w * .93f;
+	xmbText(dl, bodyFont(), f.h * .04f, ImVec2(x0, f.h * .08f), in, ICON_FA_SD_CARD);
+	xmbText(dl, bodyFont(), f.h * .034f, ImVec2(x0 + f.h * .06f, f.h * .085f), in, vmuLabel(gCard.path));
+	char buf[160];
+	snprintf(buf, sizeof(buf), T("%d of %d blocks free"), gCard.freeBlocks, gCard.totalBlocks);
+	xmbText(dl, bodyFont(), f.h * .024f, ImVec2(x1, f.h * .09f), in, buf, 1.f);
+	const float barY = f.h * .14f, used = 1.f - (float)gCard.freeBlocks / std::max(1, gCard.totalBlocks);
+	dl->AddRectFilled(ImVec2(x0, barY), ImVec2(x1, barY + 6), IM_COL32(255, 255, 255, (int)(40 * in)), 3.f);
+	dl->AddRectFilled(ImVec2(x0, barY), ImVec2(x0 + (x1 - x0) * used, barY + 6), tone.u32(.9f * in), 3.f);
+
+	// the saves
+	const int n = (int)gCard.saves.size();
+	if (n == 0)
+		xmbText(dl, bodyFont(), f.h * .03f, ImVec2(f.w * .5f, f.h * .45f), in * .8f, T("This memory card is empty"), .5f);
+	spring(gPos, gVel, (float)gSel, 170.f, 26.f, f.dt);
+	const float top = f.h * .19f, rowH = f.h * .1f;
+	const int visible = (int)((f.h * .66f) / rowH);
+	const float scroll = std::clamp(gPos - visible * .4f, 0.f, std::max(0.f, (float)n - visible));
+	dl->PushClipRect(ImVec2(0, top), ImVec2(f.w, top + visible * rowH), true);
+	const float hy = top + (gPos - scroll) * rowH;
+	if (n > 0)
+		dl->AddRectFilledMultiColor(ImVec2(x0 - 10, hy), ImVec2(x1 + 10, hy + rowH), tone.u32(.45f * in), tone.u32(.1f * in),
+				tone.u32(.1f * in), tone.u32(.45f * in));
+	for (int i = 0; i < n; i++)
+	{
+		const float y = top + (i - scroll) * rowH;
+		if (y < top - rowH || y > top + visible * rowH)
+			continue;
+		const VmuSave& s = gCard.saves[i];
+		const float a = in * (i == gSel ? 1.f : .8f);
+		const float icon = rowH * .78f;
+		const ImVec2 ip(x0, y + (rowH - icon) / 2);
+		dl->AddRectFilled(ip, ImVec2(ip.x + icon, ip.y + icon), IM_COL32(20, 24, 34, (int)(200 * a)), 6.f);
+		const ImTextureID tex = iconTexture(s, i);
+		if (tex != ImTextureID())
+		{
+			// the icon's animation: speed in 1/30 s per frame
+			const int frames = (int)s.icons.size();
+			const float period = std::max(1, s.speed) / 30.f;
+			const int fr = frames > 1 ? (int)(f.t / period) % frames : 0;
+			dl->AddImage(tex, ip, ImVec2(ip.x + icon, ip.y + icon), ImVec2((float)fr / frames, 0), ImVec2((float)(fr + 1) / frames, 1),
+					IM_COL32(255, 255, 255, (int)(255 * a)));
+		}
+		else
+			xmbText(dl, bodyFont(), icon * .5f, ImVec2(ip.x + icon / 2, ip.y + icon * .2f), a, s.game ? ICON_FA_GAMEPAD : ICON_FA_FLOPPY_DISK, .5f);
+		const float tx = ip.x + icon + f.w * .015f;
+		xmbText(dl, bodyFont(), f.h * .029f, ImVec2(tx, y + rowH * .14f), a, s.title, 0, x1 - tx - f.w * .12f);
+		std::string line = s.description.empty() ? s.fileName : s.description;
+		xmbText(dl, bodyFont(), f.h * .021f, ImVec2(tx, y + rowH * .55f), a * .85f, line, 0, x1 - tx - f.w * .12f, IM_COL32(210, 220, 235, 255));
+		snprintf(buf, sizeof(buf), T("%d blocks"), s.blocks);
+		xmbText(dl, bodyFont(), f.h * .024f, ImVec2(x1, y + rowH * .14f), a, buf, 1.f);
+		if (s.year > 0)
+		{
+			snprintf(buf, sizeof(buf), "%02d/%02d/%04d  %02d:%02d", s.day, s.month, s.year, s.hour, s.minute);
+			xmbText(dl, bodyFont(), f.h * .021f, ImVec2(x1, y + rowH * .55f), a * .8f, buf, 1.f, 0, IM_COL32(210, 220, 235, 255));
+		}
+	}
+	dl->PopClipRect();
+
+	// the actions beside the save
+	if (gMenu)
+	{
+		const float ch = f.h * .052f, cs = f.h * .026f;
+		float w = f.w * .22f;
+		for (const auto& a : gActions)
+			w = std::max(w, textWidth(bodyFont(), cs, a.first) + cs * 2.5f);
+		const float panelH = gActions.size() * ch + ch * .4f;
+		float py = std::clamp(hy + rowH / 2 - panelH / 2, f.h * .1f, f.h * .86f - panelH);
+		const float px = x1 - w;
+		dl->AddRectFilled(ImVec2(px, py), ImVec2(px + w, py + panelH), IM_COL32(12, 16, 26, (int)(230 * in)), ch * .2f);
+		dl->AddRect(ImVec2(px, py), ImVec2(px + w, py + panelH), IM_COL32(255, 255, 255, (int)(70 * in)), ch * .2f, 0, 1.5f);
+		for (int i = 0; i < (int)gActions.size(); i++)
+		{
+			const float y = py + ch * .2f + i * ch;
+			if (i == gMenuSel)
+				dl->AddRectFilled(ImVec2(px + 4, y), ImVec2(px + w - 4, y + ch), (gActions[i].second < 0 && gConfirmDelete
+						? Color { .8f, .2f, .2f } : tone).u32(.6f * in), ch * .15f);
+			xmbText(dl, bodyFont(), cs, ImVec2(px + cs, y + (ch - cs) / 2), in, gActions[i].first, 0, w - cs * 1.5f);
+		}
+	}
+	if (!gStatus.empty() && f.t - gStatusAt < 6.f)
+		xmbText(dl, bodyFont(), f.h * .024f, ImVec2(x0, f.h * .875f), in, gStatus, 0, x1 - x0,
+				gStatusBad ? IM_COL32(255, 150, 140, 255) : IM_COL32(170, 240, 190, 255));
+	xmbHints(f, { { 'x', T("Select") }, { 'o', T("Back") } }, in);
+}
+
+} // namespace launcher
diff --git a/shell/ps4/launcher/xmb_style.cpp b/shell/ps4/launcher/xmb_style.cpp
