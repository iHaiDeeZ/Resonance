+namespace
+{
+std::vector<u8> gLogoPixels;
+int gLogoW, gLogoH;
+bool gLogoRead;
+LogoInfo gLogoInfo;
+
+void readLogo()
+{
+	if (gLogoRead)
+		return;
+	gLogoRead = true;
+	const std::string dir = std::string(ps4_app_dir()) + "/launcher/";
+	int n;
+	if (u8 *data = stbi_load((dir + "logo.png").c_str(), &gLogoW, &gLogoH, &n, 4))
+	{
+		gLogoPixels.assign(data, data + (size_t)gLogoW * gLogoH * 4);
+		stbi_image_free(data);
+	}
+	if (FILE *f = fopen((dir + "logo.txt").c_str(), "r"))
+	{
+		LogoInfo li;
+		if (fscanf(f, "%f %f %f %f", &li.pad, &li.swirlX, &li.swirlY, &li.swirlR) == 4)
+			gLogoInfo = li;
+		fclose(f);
+	}
+}
+} // namespace
+
+ImTextureID launcher::logoTexture(float& aspect)
+{
+	readLogo();
+	if (gLogoPixels.empty() || imguiDriver == nullptr)
+		return {};
+	aspect = (float)gLogoW / gLogoH;
+	// kept in memory: the swap chain rebuild at a game's start and end drops the UI's textures
+	ImTextureID id = imguiDriver->getTexture("resonance.logo");
+	if (id == ImTextureID())
+	{
+		try {
+			id = imguiDriver->updateTexture("resonance.logo", gLogoPixels.data(), gLogoW, gLogoH, false);
+		} catch (...) {
+		}
+	}
+	return id;
+}
+
+const LogoInfo& launcher::logoInfo()
+{
+	readLogo();
+	return gLogoInfo;
+}
+
+void launcher::drawCornerLogo(Frame& f, float alpha, float left)
+{
+	float aspect;
+	const ImTextureID tex = logoTexture(aspect);
+	if (tex == ImTextureID() || alpha <= .01f)
+		return;
+	// the letters' top at 3.8% of the height, their left edge at 3.5% of the width
+	// the letters and subtitle 5.6% of the height; the picture is larger by its glow margin
+	const float h = f.h * .056f / (1.f - 2.f * gLogoInfo.pad), pad = gLogoInfo.pad * h;
+	const ImVec2 p0((left < 0 ? f.w * .035f : left) - pad, f.h * .038f - pad);
+	f.dl->AddImage(tex, p0, ImVec2(p0.x + h * aspect, p0.y + h), ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * clamp01(alpha))));
+}
+
+void launcher::drawLaunchCard(Frame& f, const Game& g, float alpha, float progress, const std::string& label)
+{
+	alpha = clamp01(alpha);
+	if (alpha <= 0.f)
+		return;
+	ImDrawList *dl = f.dl;
+	const Color black;
+	const Color top = mix(g.c2, black, .45f), bottom = mix(g.c2, black, .9f);
+	dl->AddRectFilledMultiColor(ImVec2(0, 0), ImVec2(f.w, f.h), top.u32(alpha), top.u32(alpha), bottom.u32(alpha), bottom.u32(alpha));
+	const float s = f.h * .5f;
+	const ImVec2 c(f.w * .5f, f.h * .43f);
+	drawBlob(dl, c, s * 1.05f, g.c1.u32(.28f * alpha));
+	const ImVec2 p0(c.x - s / 2, c.y - s / 2), p1(c.x + s / 2, c.y + s / 2);
+	// shadow, then the cover (or a plain case in the game's colours)
+	dl->AddRectFilled(ImVec2(p0.x + s * .025f, p0.y + s * .035f), ImVec2(p1.x + s * .025f, p1.y + s * .035f),
+			IM_COL32(0, 0, 0, (int)(110 * alpha)), s * .02f);
+	ImTextureID tex = imguiDriver != nullptr && !g.cover.empty() ? imguiDriver->getTexture(g.cover) : ImTextureID();
+	const bool kept = g.cover == gLaunched.cover && !gLaunchedPixels.empty();
+	if (tex == ImTextureID() && kept)
+	{
+		try {
+			tex = imguiDriver->updateTexture(g.cover, gLaunchedPixels.data(), gLaunchedW, gLaunchedH, false);
+		} catch (...) {
+		}
+	}
+	else if (tex == ImTextureID())
+		tex = coverTexture(g);
+	if (tex != ImTextureID())
+		dl->AddImageRounded(tex, p0, p1, ImVec2(0, 0), ImVec2(1, 1), IM_COL32(255, 255, 255, (int)(255 * alpha)), s * .015f);
+	else if (!kept)
+	{
+		dl->AddRectFilledMultiColor(p0, p1, g.c1.u32(alpha), g.c1.u32(alpha), g.c2.u32(alpha), g.c2.u32(alpha));
+		drawText(dl, fontFor(displayFont(), g.e.title), s * .07f, ImVec2(c.x, c.y - s * .04f), IM_COL32(255, 255, 255, (int)(230 * alpha)),
+				g.e.title, .5f, s * .9f);
+	}
+	dl->AddRect(p0, p1, IM_COL32(255, 255, 255, (int)(40 * alpha)), s * .015f, 0, 1.5f);
+	drawText(dl, fontFor(displayFont(), g.e.title), f.h * .034f, ImVec2(c.x, p1.y + f.h * .045f), IM_COL32(255, 255, 255, (int)(240 * alpha)),
+			g.e.title, .5f, f.w * .8f);
+	if (progress < 0.f && label.empty())
+		return;
+	const float bw = f.w * .26f, by = f.h * .87f;
+	if (!label.empty())
+		drawText(dl, bodyFont(), f.h * .024f, ImVec2(c.x, by - f.h * .042f), IM_COL32(220, 225, 235, (int)(220 * alpha)), label, .5f, f.w * .6f);
+	dl->AddRectFilled(ImVec2(c.x - bw / 2, by), ImVec2(c.x + bw / 2, by + 4), IM_COL32(255, 255, 255, (int)(45 * alpha)), 2.f);
+	if (progress >= 0.f)
+		dl->AddRectFilled(ImVec2(c.x - bw / 2, by), ImVec2(c.x - bw / 2 + bw * clamp01(progress), by + 4),
+				IM_COL32(255, 255, 255, (int)(230 * alpha)), 2.f);
+	else
+	{
+		// no figure yet: a light running along the bar
+		const float x = c.x - bw / 2 + bw * (std::fmod(f.t * .8f, 1.3f) - .15f);
+		dl->PushClipRect(ImVec2(c.x - bw / 2, by - 2), ImVec2(c.x + bw / 2, by + 6), true);
+		dl->AddRectFilledMultiColor(ImVec2(x - bw * .12f, by), ImVec2(x + bw * .12f, by + 4), IM_COL32(255, 255, 255, 0),
+				IM_COL32(255, 255, 255, (int)(230 * alpha)), IM_COL32(255, 255, 255, (int)(230 * alpha)), IM_COL32(255, 255, 255, 0));
+		dl->PopClipRect();
+	}
+}
+
+void launcher_loading_draw(const char *label, float progress)
+{
+	if (imguiDriver == nullptr)
+		return;
+	const auto now = std::chrono::steady_clock::now();
+	gTime += std::min(.05f, std::chrono::duration<float>(now - gLast).count());
+	gLast = now;
+	Frame f = makeFrame();
+	f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, 255));
+	drawLaunchCard(f, gLaunched, 1.f, progress, label != nullptr ? label : "");
+}
+
+bool launcher_draw()
+{
+	if (imguiDriver == nullptr)
+		return false;
+	const auto now = std::chrono::steady_clock::now();
+	static bool started;
+	if (!started)
+	{
+		started = true;
+		gLast = now;
+		setTheme(config::loadInt("resonance", "LauncherTheme", 0));
+		if (config::loadBool("resonance", "CheckUpdates", true))
+			std::thread([] {
+				ThreadName _("UpdateCheck");
+				const updater::Release r = updater::checkLatest();
+				if (r.ok && updater::compareVersions(r.version, ps4_app_version()) > 0)
+				{
+					std::lock_guard<std::mutex> lock(gUpdateMutex);
+					gUpdateVersion = r.version;
+				}
+			}).detach();
+		if (!gPaletteThread)
+		{
+			gPaletteThread = true;
+			std::thread(paletteWorker).detach();
+		}
+		ps4_boot_trace("launcher: home screen up");
+		// once: widescreen by the games' own patches (the extra width drawn for every game made
+		// things pop in and out at the sides); All games stays in Settings > Video
+		if (!config::loadBool("resonance", "WidescreenChoice", false))
+		{
+			config::saveBool("resonance", "WidescreenChoice", true);
+			config::Widescreen.set(false);
+			config::SuperWidescreen.set(false);
+			config::WidescreenGameHacks.set(true);
+			SaveSettings();
+			ps4_boot_trace("launcher: widescreen set to the supported games' patches");
+		}
+	}
+	gTime += std::min(.05f, std::chrono::duration<float>(now - gLast).count());
+	gLast = now;
+	soundStart();
+
+	watchLibrary();
+	if (gTime >= gNextRefresh)
+	{
+		refreshLibrary();
+		gNextRefresh = gTime + .5f;
+	}
+
+	Frame f = makeFrame();
+	// the opening (intro.cpp) first, then the home screen fades in
+	static bool introOver;
+	if (!introOver)
+	{
+		if (introDraw(f))
+			return true;
+		introOver = true;
+		gFadeAt = gTime;
+	}
+	handleInput(f);
+	f = makeFrame();
+
+	// theme switch: 0.22 s fade out, swap, 0.22 s fade in
+	float fade = 0.f;
+	if (gPendingTheme >= 0)
+	{
+		const float p = (gTime - gFadeAt) / .22f;
+		if (p >= 1.f)
+		{
+			setTheme(gPendingTheme);
+			gPendingTheme = -1;
+			gFadeAt = gTime;
+			gToast = themeLabel(gThemeIndex);
+			gToastAt = gTime;
+			gToastFor = 1.6f;
+			f = makeFrame();
+		}
+		else
+			fade = p;
+	}
+	else if (gTime - gFadeAt < .22f)
+		fade = 1.f - (gTime - gFadeAt) / .22f;
+
+	gTheme->draw(f);
+	drawCornerLogo(f, gLaunchAt >= 0 ? 1.f - clamp01((gTime - gLaunchAt) / .35f) : 1.f);
+
+	if (fade > 0.f)
+		f.dl->AddRectFilled(ImVec2(0, 0), ImVec2(f.w, f.h), IM_COL32(0, 0, 0, (int)(255 * clamp01(fade))));
+	if (!gUpdateShown && gLaunchAt < 0)
+	{
+		std::lock_guard<std::mutex> lock(gUpdateMutex);
+		if (!gUpdateVersion.empty())
+		{
+			gUpdateShown = true;
+			char text[160];
+			snprintf(text, sizeof(text), i18n::T("Update v%s available: Settings > About"), gUpdateVersion.c_str());
+			gToast = text;
+			gToastAt = gTime;
+			gToastFor = 6.f;
+			playSound(Sound::Category);
+		}
+	}
+	const float toastAge = gTime - gToastAt;
+	if (toastAge < gToastFor)
+	{
+		const float a = clamp01(std::fmin(toastAge / .15f, (gToastFor - toastAge) / .3f));
+		const float fs = f.h * .03f, tw = textWidth(bodyFont(), fs, gToast);
+		const ImVec2 c(f.w / 2, f.h * .06f);
+		f.dl->AddRectFilled(ImVec2(c.x - tw / 2 - fs, c.y - fs * .2f), ImVec2(c.x + tw / 2 + fs, c.y + fs * 1.5f),
+				IM_COL32(10, 12, 18, (int)(200 * a)), fs * .4f);
+		drawText(f.dl, bodyFont(), fs, ImVec2(c.x, c.y + fs * .08f), IM_COL32(255, 255, 255, (int)(255 * a)), gToast, .5f);
+	}
+
+	// the start animation is over: boot the game (Flycast shows its loading screen)
+	if (gLaunchAt >= 0 && gTime - gLaunchAt >= gTheme->launchSeconds())
+	{
+		gLaunchAt = -1;
+		if (!gGames.empty())
+		{
+			const Game& g = gGames[gSel];
+			char line[600];
+			snprintf(line, sizeof(line), "launcher: starting %s", g.e.path.c_str());
+			ps4_boot_trace(line);
+			soundStop();
+			currentGameCover = g.cover;
+			currentGameDiscs = g.e.discs;
+			gLaunched = g;
+			gLaunchedPixels.clear();
+			if (FILE *cf = g.cover.empty() ? nullptr : nowide::fopen(g.cover.c_str(), "rb"))
+			{
+				int n;
+				if (u8 *data = stbi_load_from_file(cf, &gLaunchedW, &gLaunchedH, &n, 4))
+				{
+					gLaunchedPixels.assign(data, data + (size_t)gLaunchedW * gLaunchedH * 4);
+					stbi_image_free(data);
+				}
+				fclose(cf);
+			}
+			gui_ps4_start_game(g.e.path, g.e.title);
+		}
+	}
+	return true;
+}
