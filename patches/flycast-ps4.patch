+
+bool keyboardOpen() {
+	return gOpen;
+}
+
+void openKeyboard(const std::string& title, const std::string& text, bool secret,
+		std::function<void(bool ok, const std::string& text)> done)
+{
+	if (gOpen)
+		return;
+	static bool loaded;
+	if (!loaded)
+	{
+		sceSysmoduleLoadModule(ORBIS_SYSMODULE_IME_DIALOG);
+		sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_COMMON_DIALOG);
+		sceCommonDialogInitialize();
+		loaded = true;
+	}
+	toUtf16(text, gText, std::size(gText));
+	toUtf16(title, gTitle, std::size(gTitle));
+	int32_t user = -1;
+	sceUserServiceGetInitialUser(&user);
+	OrbisImeDialogSetting setting {};
+	setting.userId = (uint32_t)user;
+	setting.type = ORBIS_TYPE_TYPE_URL;
+	setting.enterLabel = ORBIS_BUTTON_LABEL_DEFAULT;
+	setting.option = OPTION_NO_AUTO_CAPITALIZATION | (secret ? OPTION_PASSWORD : 0);
+	setting.maxTextLength = (u32)std::size(gText) - 2;
+	setting.inputTextBuffer = reinterpret_cast<wchar_t *>(gText);
+	setting.posx = 1920.f / 2;
+	setting.posy = 1080.f / 2;
+	setting.horizontalAlignment = ORBIS_H_CENTER;
+	setting.verticalAlignment = ORBIS_V_CENTER;
+	setting.title = reinterpret_cast<const wchar_t *>(gTitle);
+	const int r = sceImeDialogInit(&setting, nullptr);
+	char line[96];
+	snprintf(line, sizeof(line), "keyboard: open %x", (unsigned)r);
+	ps4_boot_trace(line);
+	gOpen = r >= 0;
+	gDone = gOpen ? std::move(done) : nullptr;
+	if (!gOpen)
+		playSound(Sound::Error);
+}
+
+void keyboardUpdate()
+{
+	if (!gOpen)
+		return;
+	const OrbisDialogStatus status = sceImeDialogGetStatus();
+	if (status == ORBIS_DIALOG_STATUS_RUNNING)
+		return;
+	OrbisDialogResult result {};
+	if (status == ORBIS_DIALOG_STATUS_STOPPED)
+		sceImeDialogGetResult(&result);
+	sceImeDialogTerm();
+	gOpen = false;
+	const bool ok = status == ORBIS_DIALOG_STATUS_STOPPED && result.endstatus == ORBIS_DIALOG_OK;
+	auto done = std::move(gDone);
+	gDone = nullptr;
+	if (done)
+		done(ok, ok ? toUtf8(gText) : std::string());
+}
