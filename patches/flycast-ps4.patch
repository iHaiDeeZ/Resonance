new file mode 100644
index 000000000..6110bc868
--- /dev/null
+++ b/shell/ps4/CMakeLists.txt
@@ -0,0 +1,54 @@
+# Resonance: Flycast on PS4 homebrew. Built with the Resonance toolchain (toolchain/ps4-decast.cmake,
+# ps4-love-style.cmake: PS4_RUNTIME_SOURCES, ps4_link_mesa, ps4_add_eboot).
+target_sources(${PROJECT_NAME} PRIVATE
+	ps4_main.cpp
+	ps4_stubs.c
+	ps4_gamepad.cpp
+	ps4_gamepad.h
+	ps4_vmem.cpp
+	ps4_wsi.cpp
