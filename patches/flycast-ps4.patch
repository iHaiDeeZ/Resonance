+	// ---- updates ----
+	std::future<updater::Release> checking;
+	updater::Release latest;
+	bool haveLatest = false;
+	std::future<std::string> installing;
+	std::atomic<int> percent { 0 };
+	bool viaInstaller = false, updateReady = false;
+
+	bool newer() const {
+		return haveLatest && latest.ok && updater::compareVersions(latest.version, ps4_app_version()) > 0;
+	}
+
+	std::string updateState() const
+	{
+		char buf[96];
+		if (installing.valid())
+		{
+			snprintf(buf, sizeof(buf), T("Downloading %d%%"), percent.load());
+			return buf;
+		}
+		if (updateReady)
+			return T("Restart to finish");
+		if (checking.valid())
+			return T("Checking...");
+		if (newer())
+			return "v" + latest.version;
+		return "";
+	}
+
+	void updateAction()
+	{
+		if (installing.valid() || checking.valid() || updateReady)
+			return;
+		if (newer())
+		{
+			percent = 0;
+			const updater::Release release = latest;
+			installing = std::async(std::launch::async, [this, release] {
+				bool installer = false;
+				const std::string error = updater::install(release, [this](uint64_t done, uint64_t total) {
+					percent = total ? (int)(done * 100 / total) : 0;
+					return true;
+				}, &installer);
+				viaInstaller = installer;
+				return error;
+			});
+			return;
+		}
+		checking = std::async(std::launch::async, [] { return updater::checkLatest(); });
+	}
+
+	void pollUpdate()
+	{
+		char buf[512];
+		if (checking.valid() && checking.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+		{
+			latest = checking.get();
+			haveLatest = true;
+			if (!latest.ok)
+			{
+				if (latest.error == "no releases yet")
+					say(T("No releases yet"), false);
+				else
+				{
+					snprintf(buf, sizeof(buf), T("Couldn't check for updates: %s"), latest.error.c_str());
+					say(buf, true);
+				}
+			}
+			else if (newer())
+			{
+				snprintf(buf, sizeof(buf), T("Update v%s available: press X to install it"), latest.version.c_str());
+				say(buf, false);
+			}
+			else
+				say(T("Resonance is up to date"), false);
+		}
+		if (installing.valid() && installing.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+		{
+			const std::string error = installing.get();
+			if (!error.empty())
+			{
+				snprintf(buf, sizeof(buf), T("Update failed: %s"), error.c_str());
+				say(buf, true);
+			}
+			else if (viaInstaller)
+				say(T("Saved in /data/pkg: install it with the Package Installer"), false);
+			else
+			{
+				updateReady = true;
+				say(T("Update ready: restart Resonance to use it"), false);
+			}
+		}
+	}
+	bool rebuildPending = false;
+
+	// ---- network shares ----
+	std::string status;
+	float statusAt = -10;
+	bool statusBad = false;
+	std::future<std::string> testing;
+	netfs::Share testingShare;
+	int testingEntries = 0;
+	bool testingAdds = false;
+	float now = 0;
+
+	void say(const std::string& text, bool bad)
+	{
+		status = text;
+		statusAt = now;
+		statusBad = bad;
+		playSound(bad ? Sound::Error : Sound::Confirm);
+	}
+
+	void startTest(const netfs::Share& share, bool addIfOk)
+	{
+		if (testing.valid())
+			return;
+		testingShare = share;
+		testingAdds = addIfOk;
+		testingEntries = 0;
+		status = T("Connecting...");
+		statusAt = now;
+		statusBad = false;
+		testing = std::async(std::launch::async, [this, share] { return netfs::test(share, testingEntries); });
+	}
+
+	// the test running in the background, when it is over
+	void pollTest()
+	{
+		if (!testing.valid() || testing.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+			return;
+		const std::string error = testing.get();
+		char buf[512];
+		if (!error.empty())
+		{
+			snprintf(buf, sizeof(buf), T("Couldn't connect: %s"), error.c_str());
+			say(buf, true);
+			return;
+		}
+		if (testingAdds)
+		{
+			netfs::addShare(testingShare);
+			gui_ps4_rescan_games();
+			const int g = group, s = sel;
+			build();
+			group = g;
+			sel = s;
+		}
+		snprintf(buf, sizeof(buf), T("Connected: %d items in the top folder"), testingEntries);
+		say(buf, false);
+	}
+
+	void addShare(bool smb)
+	{
+		const std::string type = smb ? "smb" : "nfs";
+		openKeyboard(T("Server address (e.g. 192.168.0.10)"), "", false, [this, type, smb](bool ok, const std::string& host) {
+			if (!ok || host.empty())
+				return;
+			openKeyboard(smb ? T("Share name and folder (e.g. Games/Dreamcast)") : T("Exported folder (e.g. /d/games)"),
+					smb ? "" : "/", false, [this, type, smb, host](bool ok, const std::string& path) {
+				if (!ok || path.empty())
+					return;
+				netfs::Share share;
+				share.type = type;
+				share.host = host;
+				share.path = path;
+				share.label = netfs::makeLabel(host, path);
+				if (!smb)
+				{
+					startTest(share, true);
+					return;
+				}
+				openKeyboard(T("Username"), "", false, [this, share](bool ok, const std::string& user) {
+					if (!ok)
+						return;
+					netfs::Share withUser = share;
+					withUser.user = user;
+					if (user.empty())
+					{
+						startTest(withUser, true);	// a guest share
+						return;
+					}
+					openKeyboard(T("Password"), "", true, [this, withUser](bool ok, const std::string& password) {
+						if (!ok)
+							return;
+						netfs::Share full = withUser;
+						full.password = password;
+						startTest(full, true);
+					});
+				});
+			});
+		});
+	}
